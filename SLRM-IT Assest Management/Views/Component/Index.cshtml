    <script>
        // ✅ COLUMN FILTERING SYSTEM (Same as Assets page)
        document.addEventListener('DOMContentLoaded', function() {
            let filters = {};
            let columnCount = document.querySelectorAll('#components-table thead th.filter-header').length;

            // Create filter dropdowns
            document.querySelectorAll('.filter-header').forEach((header, index) => {
                if (index >= columnCount) return;

                const dropdown = document.createElement('div');
                dropdown.className = 'filter-dropdown';
                dropdown.dataset.columnIndex = index;

                const searchInput = document.createElement('input');
                searchInput.type = 'text';
                searchInput.className = 'filter-search';
                searchInput.placeholder = 'Search...';
                dropdown.appendChild(searchInput);

                const optionsContainer = document.createElement('div');
                optionsContainer.className = 'filter-options';
                dropdown.appendChild(optionsContainer);

                const actionsDiv = document.createElement('div');
                actionsDiv.className = 'filter-actions';

                const applyBtn = document.createElement('button');
                applyBtn.className = 'btn-apply';
                applyBtn.textContent = 'Apply';
                applyBtn.onclick = () => applyFilter(index);
                actionsDiv.appendChild(applyBtn);

                const clearBtn = document.createElement('button');
                clearBtn.className = 'btn-clear';
                clearBtn.textContent = 'Clear';
                clearBtn.onclick = () => clearFilter(index);
                actionsDiv.appendChild(clearBtn);

                dropdown.appendChild(actionsDiv);
                header.appendChild(dropdown);

                populateFilterOptions(index);

                header.addEventListener('click', (e) => {
                    e.stopPropagation();
                    document.querySelectorAll('.filter-dropdown.active').forEach(d => {
                        if (d !== dropdown) d.classList.remove('active');
                    });
                    dropdown.classList.toggle('active');
                    if (dropdown.classList.contains('active')) {
                        setTimeout(() => searchInput.focus(), 100);
                    }
                });
            });

            document.addEventListener('click', () => {
                document.querySelectorAll('.filter-dropdown.active').forEach(d => d.classList.remove('active'));
            });

            function populateFilterOptions(columnIndex) {
                const dropdown = document.querySelector(`.filter-dropdown[data-column-index="${columnIndex}"]`);
                const optionsContainer = dropdown.querySelector('.filter-options');
                const searchInput = dropdown.querySelector('.filter-search');

                optionsContainer.innerHTML = '';
                const table = document.getElementById('components-table');
                const rows = table.querySelectorAll('tbody tr');
                const valueCount = {};

                rows.forEach(row => {
                    const cell = row.cells[columnIndex];
                    if (!cell) return;
                    let value = cell.textContent.trim();

                    if (value && value !== 'NA') {
                        valueCount[value] = (valueCount[value] || 0) + 1;
                    }
                });

                const sortedValues = Object.keys(valueCount).sort();
                sortedValues.forEach(value => {
                    const optionDiv = document.createElement('div');
                    optionDiv.className = 'filter-option';

                    const checkbox = document.createElement('input');
                    checkbox.type = 'checkbox';
                    checkbox.value = value;
                    checkbox.className = 'filter-checkbox';

                    const label = document.createElement('label');
                    label.textContent = `${value} (${valueCount[value]})`;

                    optionDiv.appendChild(checkbox);
                    optionDiv.appendChild(label);
                    optionsContainer.appendChild(optionDiv);
                });

                searchInput.addEventListener('input', function() {
                    const searchTerm = this.value.toLowerCase();
                    optionsContainer.querySelectorAll('.filter-option').forEach(option => {
                        const text = option.textContent.toLowerCase();
                        option.style.display = text.includes(searchTerm) ? 'flex' : 'none';
                    });
                });
            }

            function applyFilter(columnIndex) {
                const dropdown = document.querySelector(`.filter-dropdown[data-column-index="${columnIndex}"]`);
                const checkedOptions = dropdown.querySelectorAll('.filter-checkbox:checked');
                const selectedValues = Array.from(checkedOptions).map(cb => cb.value);

                filters[columnIndex] = selectedValues;
                filterTable();
                dropdown.classList.remove('active');
            }

            function clearFilter(columnIndex) {
                const dropdown = document.querySelector(`.filter-dropdown[data-column-index="${columnIndex}"]`);
                dropdown.querySelectorAll('.filter-checkbox').forEach(cb => cb.checked = false);
                delete filters[columnIndex];
                filterTable();
                dropdown.classList.remove('active');
            }

            function filterTable() {
                const table = document.getElementById('components-table');
                const rows = table.querySelectorAll('tbody tr');
                let visibleCount = 0;

                rows.forEach(row => {
                    let showRow = true;

                    Object.keys(filters).forEach(colIndex => {
                        const cell = row.cells[colIndex];
                        if (!cell) return;
                        let cellValue = cell.textContent.trim();

                        if (!filters[colIndex].includes(cellValue)) {
                            showRow = false;
                        }
                    });

                    row.style.display = showRow ? '' : 'none';
                    if (showRow) visibleCount++;
                });

                document.getElementById('total-count').textContent = visibleCount;
                document.querySelectorAll('.filter-header').forEach((header, idx) => {
                    header.classList.toggle('filtered-column', filters[idx] && filters[idx].length > 0);
                });
            }
        });

        // DataTables
        $(document).ready(function () {
            $('#components-table').DataTable({
                scrollX: true,
                autoWidth: false,
                pageLength: 10,
                searching: true,
                columnDefs: [
