@model IEnumerable<SLRM_IT_Assest_Management.Models.Component>

@{
    ViewData["Title"] = "Component";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Component - SLRM IT-ASSET MANAGEMENT</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <!-- DataTables -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.bootstrap5.min.css">

    <style>
        body {
            background-color: #f4f6f9;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding: 20px;
        }

        .page-title {
            font-size: 24px;
            font-weight: 600;
            margin-bottom: 20px;
            color: #1f3c88;
            padding-bottom: 10px;
            border-bottom: 2px solid #e3e6ef;
        }

        .table-container {
            background: #ffffff;
            padding: 20px;
            border-radius: 12px;
            border: 1px solid #e0e4eb;
            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.06);
        }

        .table th, .table td {
            border: 0.5px solid #dee2e6 !important;
            padding: 8px 12px;
            text-align: center;
            vertical-align: middle;
            white-space: nowrap;
        }

        th {
            background-color: #2a4d8c;
            color: #ffffff;
            text-transform: uppercase;
        }
    </style>
</head>

<body>
    <div class="container-fluid">

        <h1 class="page-title">SLRM IT-ASSET MANAGEMENT > COMPONENT</h1>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus"></i> Add New Component
            </a>
            <span class="text-muted small">
                Total: <span id="total-count">@Model.Count()</span> items
            </span>
        </div>

        <div class="table-container">
            <div class="table-responsive">
                <table class="table table-hover" id="component-table">
                    <thead>
                        <tr>
                            <th>Sl No</th>
                            <th>Name</th>
                            <th>Serial No</th>
                            <th>Category</th>
                            <th>Model No</th>
                            <th>Location</th>
                            <th>Order No</th>
                            <th>Purchase Date</th>
                            <th>Total</th>
                            <th>Remaining</th>
                            <th>Total Cost</th>
                            <th>Check In/Out</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int slNo = 1;
                        }
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@slNo</td>
                                <td>@item.Name</td>
                                <td>@(string.IsNullOrEmpty(item.SerialNo) ? "NA" : item.SerialNo)</td>
                                <td>@item.Category?.CategoryName</td>
                                <td>@item.ModelNo</td>
                                <td>@item.AssetLocation?.Name</td>
                                <td>@item.OrderNo</td>
                                <td>@(item.PurchaseDate == default(DateOnly) ? "NA" : item.PurchaseDate.ToString("dd/MM/yyyy"))</td>
                                <td>@item.Total</td>
                                <td>
                                    @{
                                        int remainingValue = 0;
                                        bool isNumber = int.TryParse(item.Remaining, out remainingValue);

                                        string badgeClass = !isNumber ? "bg-secondary"
                                        : remainingValue == 0 ? "bg-danger"
                                        : remainingValue <= 5 ? "bg-warning"
                                        : "bg-success";
                                    }

                                    <span class="badge @badgeClass">
                                        @(string.IsNullOrEmpty(item.Remaining) ? "NA" : item.Remaining)
                                    </span>
                                </td>
                                <td>@item.TotalCost</td>
                                <td>@item.CheckInCheckOut</td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Edit" asp-route-id="@item.ComponentId" class="btn btn-warning">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.ComponentId" class="btn btn-info">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.ComponentId" class="btn btn-danger">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            slNo++;
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>

    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.print.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#component-table').DataTable({
                scrollX: true,
                pageLength: 25,
                dom: 'Bfrtip',
                buttons: [
                    { extend: 'excel', className: 'btn btn-success btn-sm' },
                    { extend: 'print', className: 'btn btn-outline-secondary btn-sm' }
                ],
                columnDefs: [
                    { orderable: false, targets: -1 }
                ]
            });
        });
    </script>

</body>
</html>