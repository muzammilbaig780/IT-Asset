@model IEnumerable<SLRM_IT_Assest_Management.Models.Component>

@{
    ViewData["Title"] = "Component";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Component - SLRM IT-ASSET MANAGEMENT</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <!-- DataTables -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.bootstrap5.min.css">

    <style>
        body {
            background-color: #f4f6f9;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding: 20px;
        }

        .page-title {
            font-size: 24px;
            font-weight: 600;
            margin-bottom: 20px;
            color: #1f3c88;
            padding-bottom: 10px;
            border-bottom: 2px solid #e3e6ef;
        }

        .table-container {
            background: #ffffff;
            padding: 20px;
            border-radius: 12px;
            border: 1px solid #e0e4eb;
            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.06);
        }

        .table th, .table td {
            border: 0.5px solid #dee2e6 !important;
            padding: 8px 12px;
            text-align: center;
            vertical-align: middle;
            white-space: nowrap;
        }

        th {
            background-color: #2a4d8c;
            color: #ffffff;
            text-transform: uppercase;
        }

        .table th, .table td {
            border: 0.5px solid #dee2e6 !important;
            padding: 8px 8px;
            text-align: center;
            vertical-align: middle;
            white-space: nowrap;
        }

            /* Ensure consistent column widths */
            .table th:nth-child(1) {
                min-width: 60px;
            }
            /* SL NO */
            .table th:nth-child(2) {
                min-width: 120px;
            }
            /* NAME */
            .table th:nth-child(3) {
                min-width: 130px;
            }
            /* SERIAL NO */
            .table th:nth-child(4) {
                min-width: 100px;
            }
            /* CATEGORY */
            .table th:nth-child(5) {
                min-width: 100px;
            }
            /* MODEL NO */
            .table th:nth-child(6) {
                min-width: 200px;
            }
            /* LOCATION */
            .table th:nth-child(7) {
                min-width: 100px;
            }
            /* ORDER NO */
            .table th:nth-child(8) {
                min-width: 120px;
            }
            /* PURCHASE DATE */
            .table th:nth-child(9) {
                min-width: 70px;
            }
            /* TOTAL */
            .table th:nth-child(10) {
                min-width: 100px;
            }
            /* REMAINING */
            .table th:nth-child(11) {
                min-width: 100px;
            }
            /* TOTAL COST */
            .table th:nth-child(12) {
                min-width: 120px;
            }
            /* CHECK IN/OUT */
            .table th:nth-child(13) {
                min-width: 120px;
            }
        /* ACTIONS */

        /* Style for action buttons */
        .btn-group-sm {
            display: flex;
            justify-content: center;
            gap: 3px;
        }

            .btn-group-sm .btn {
                padding: 4px 8px;
                border-radius: 4px;
            }

        /* Check In/Out Column Styling */
        .checkinout-column {
            min-width: 200px;
            padding: 8px !important;
        }

            .checkinout-column .timestamp {
                font-size: 12px;
                color: #666;
                margin-bottom: 6px;
                white-space: nowrap;
            }

            .checkinout-column .action-buttons {
                display: flex;
                gap: 6px;
                justify-content: center;
                align-items: center;
                flex-wrap: wrap;
            }

            .checkinout-column .btn-checkout {
                background-color: #ffc107;
                color: #000;
                border: 1px solid #e0a800;
                padding: 4px 12px;
                border-radius: 4px;
                font-size: 13px;
                font-weight: 500;
                cursor: pointer;
                transition: all 0.2s;
            }

                .checkinout-column .btn-checkout:hover {
                    background-color: #e0a800;
                }

            .checkinout-column .btn-icon {
                background-color: #f8f9fa;
                border: 1px solid #ced4da;
                padding: 4px 8px;
                border-radius: 4px;
                font-size: 16px;
                cursor: pointer;
                transition: all 0.2s;
                min-width: 32px;
            }

                .checkinout-column .btn-icon:hover {
                    background-color: #e9ecef;
                    border-color: #adb5bd;
                }

        /* Style for when there are multiple rows */
        .table tbody tr:hover .checkinout-column {
            background-color: #f8f9ff;
        }

        /* Link styling for the icons (if you need them as links) */
        .checkinout-column a {
            text-decoration: none;
            color: inherit;
        }

            .checkinout-column a:hover {
                opacity: 0.8;
            }
    </style>
</head>

<body>
    <div class="container-fluid">

        <h1 class="page-title">SLRM IT-ASSET MANAGEMENT > COMPONENT</h1>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus"></i> Add New Component
            </a>
            <span class="text-muted small">
                Total: <span id="total-count">@Model.Count()</span> items
            </span>
        </div>

        <div class="table-container">
            <div class="table-responsive">
                <table class="table table-hover" id="component-table">
                    <thead>
                        <tr>
                            <th>SL NO ▲</th>
                            <th>NAME</th>
                            <th>SERIAL NO</th>
                            <th>CATEGORY</th>
                            <th>MODEL NO</th>
                            <th>LOCATION</th>
                            <th>ORDER NO</th>
                            <th>PURCHASE DATE</th>
                            <th>TOTAL</th>
                            <th>REMAINING</th>
                            <th>TOTAL COST</th>
                            <th>CHECK IN/OUT</th>
                            <th>ACTIONS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int slNo = 1;
                            var currentDate = DateTime.Now.ToString("ddd MMM dd, yyyy h:mmtt");
                        }
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@slNo</td>
                                <td>@item.Name</td>
                                <td>@(string.IsNullOrEmpty(item.SerialNo) ? "NA" : item.SerialNo)</td>
                                <td>@item.Category?.CategoryName</td>
                                <td>@item.ModelNo</td>
                                <td>@item.AssetLocation?.Name</td>
                                <td>@item.OrderNo</td>
                                <td>@(item.PurchaseDate == default(DateOnly) ? "NA" : item.PurchaseDate.ToString("dd/MM/yyyy"))</td>
                                <td>@item.Total</td>
                                <td>
                                    @{
                                        int remainingValue = 0;
                                        bool isNumber = int.TryParse(item.Remaining, out remainingValue);

                                        string badgeClass = !isNumber ? "bg-secondary"
                                        : remainingValue == 0 ? "bg-danger"
                                        : remainingValue <= 5 ? "bg-warning"
                                        : "bg-success";
                                    }

                                    <span class="badge @badgeClass">
                                        @(string.IsNullOrEmpty(item.Remaining) ? "NA" : item.Remaining)
                                    </span>
                                </td>
                                <td>@item.TotalCost</td>

                                <!-- Check In/Out Column with Timestamp and Buttons -->
                                <td class="checkinout-column">
                                    <div class="timestamp">@currentDate</div>
                                    <div class="action-buttons">
                                        <button class="btn-checkout" title="Checkout">
                                            Checkout
                                        </button>
                                        <button class="btn-icon" title="Computer">
                                            🖥️
                                        </button>
                                        <button class="btn-icon" title="Document">
                                            📄
                                        </button>
                                    </div>
                                </td>

                                <td>
                                    <div class="btn-group btn-group-sm" style="gap: 2px;">
                                        <a asp-action="Edit" asp-route-id="@item.ComponentId" class="btn btn-warning btn-sm" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.ComponentId" class="btn btn-info btn-sm" title="Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.ComponentId" class="btn btn-danger btn-sm" title="Delete">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            slNo++;
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>

    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.print.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#component-table').DataTable({
                scrollX: true,
                pageLength: 25,
                dom: 'Bfrtip',
                buttons: [
                    { extend: 'excel', className: 'btn btn-success btn-sm' },
                    { extend: 'print', className: 'btn btn-outline-secondary btn-sm' }
                ],
                columnDefs: [
                    { orderable: false, targets: -1 }
                ]
            });
        });
    </script>

</body>
</html>