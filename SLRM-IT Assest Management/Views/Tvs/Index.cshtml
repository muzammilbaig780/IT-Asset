@model IEnumerable<SLRM_IT_Assest_Management.Models.Tv>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>TV - SLRM IT-ASSET MANAGEMENT</title>
    <!-- Back Button -->
    @{
        await Html.RenderPartialAsync("_BackButton");
    }

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <!-- DataTables -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.bootstrap5.min.css">

    <style>
        body {
            background-color: #f4f6f9;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding: 20px;
        }

        .page-title {
            font-size: 24px;
            font-weight: 600;
            margin-bottom: 20px;
            color: #1f3c88;
            padding-bottom: 10px;
            border-bottom: 2px solid #e3e6ef;
        }

        .action-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            background: #ffffff;
            padding: 15px 20px;
            border-radius: 10px;
            border: 1px solid #e0e4eb;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
            gap: 15px;
        }

        .table-container {
            overflow-x: auto;
            margin-top: 20px;
            background: #ffffff;
            padding: 20px;
            border-radius: 12px;
            border: 1px solid #e0e4eb;
            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.06);
        }

        .table {
            width: 100%;
            font-size: 13px;
            background-color: #fbfcfd;
        }

            .table th, .table td {
                border: 0.5px solid #dee2e6 !important;
                padding: 8px 12px;
                text-align: center;
                vertical-align: middle;
                white-space: nowrap;
            }

        th {
            background-color: #2a4d8c;
            color: #ffffff;
            font-weight: 600;
            text-transform: uppercase;
        }

        .table tr:nth-child(even) td {
            background-color: #f8faff;
        }

        .table tr:hover td {
            background-color: #eaf1fb;
        }

        .action-buttons .btn {
            margin: 0 2px;
        }
    </style>
</head>

<body>
    <div class="container-fluid">

        <h1 class="page-title">SLRM IT-ASSET MANAGEMENT &gt; TV</h1>

        <!-- Toolbar -->
        <div class="action-bar">
            <div>
                <input type="text" id="tableSearch" class="form-control form-control-sm me-2"
                       placeholder="🔍 Search TV assets..." style="width: 300px;">
                <select id="rowsPerPage" class="form-select form-select-sm" style="width: 140px;">
                    <option value="10">10 per page</option>
                    <option value="25" selected>25 per page</option>
                    <option value="50">50 per page</option>
                    <option value="100">100 per page</option>
                    <option value="-1">Show All</option>
                </select>
            </div>

            <div>
                <button class="btn btn-outline-primary btn-sm btn-refresh me-2">
                    <i class="fas fa-sync-alt"></i> Refresh
                </button>
                <button class="btn btn-success btn-sm btn-download me-2">
                    <i class="fas fa-file-excel"></i> Export Excel
                </button>
                <button class="btn btn-outline-secondary btn-sm btn-print">
                    <i class="fas fa-print"></i> Print
                </button>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus"></i> Add New TV
            </a>
            <span class="text-muted small">
                Total: <span id="total-count">@Model.Count()</span> assets
            </span>
        </div>

        <!-- Table -->
        <div class="table-container">
            <div class="table-responsive">
                <table class="table table-hover" id="tv-table">
                    <thead>
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.AssetLocation)</th>
                            <th>@Html.DisplayNameFor(model => model.TvSerialNo)</th>
                            <th>@Html.DisplayNameFor(model => model.Model)</th>
                            <th>@Html.DisplayNameFor(model => model.ScrrenSize)</th>
                            <th>@Html.DisplayNameFor(model => model.Department)</th>
                            <th>@Html.DisplayNameFor(model => model.UserName)</th>
                            <th>@Html.DisplayNameFor(model => model.Qty)</th>
                            <th>@Html.DisplayNameFor(model => model.Status)</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@Html.DisplayFor(modelItem => item.AssetLocation.Name)</td>
                                <td>@Html.DisplayFor(modelItem => item.TvSerialNo)</td>
                                <td>@Html.DisplayFor(modelItem => item.Model)</td>
                                <td>@Html.DisplayFor(modelItem => item.ScrrenSize)</td>
                                <td>@Html.DisplayFor(modelItem => item.Department.DepartmentId)</td>
                                <td>@Html.DisplayFor(modelItem => item.UserName)</td>
                                <td>@Html.DisplayFor(modelItem => item.Qty)</td>
                                <td>
                                    <span class="badge bg-secondary">
                                        @Html.DisplayFor(modelItem => item.Status)
                                    </span>
                                </td>
                                <td>
                                    <div class="action-buttons btn-group btn-group-sm">
                                        <a asp-action="Edit" asp-route-id="@item.TvId" class="btn btn-warning">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.TvId" class="btn btn-info">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.TvId" class="btn btn-danger">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(document).ready(function () {

            let table = $('#tv-table').DataTable({
                scrollX: true,
                pageLength: 25,
                order: [],
                columnDefs: [{ orderable: false, targets: -1 }]
            });

            $('#tableSearch').on('keyup', function () {
                table.search(this.value).draw();
            });

            $('#rowsPerPage').on('change', function () {
                let val = $(this).val();
                table.page.len(val === '-1' ? -1 : parseInt(val)).draw();
            });

            $('.btn-refresh').on('click', function () {
                table.search('').columns().search('').draw();
                $('#tableSearch').val('');
                $('#rowsPerPage').val('25');
            });

        });
    </script>

</body>
</html>