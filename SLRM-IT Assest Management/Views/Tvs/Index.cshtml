@model IEnumerable<SLRM_IT_Assest_Management.Models.Tv>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>TV - SLRM IT-ASSET MANAGEMENT</title>
    <!-- Back Button -->
    @{
        await Html.RenderPartialAsync("_BackButton");
    }

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <!-- DataTables -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.bootstrap5.min.css">

    <style>
        body {
            background-color: #f4f6f9;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding: 20px;
        }

        .page-title {
            font-size: 24px;
            font-weight: 600;
            margin-bottom: 20px;
            color: #1f3c88;
            padding-bottom: 10px;
            border-bottom: 2px solid #e3e6ef;
        }

        .action-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            background: #ffffff;
            padding: 15px 20px;
            border-radius: 10px;
            border: 1px solid #e0e4eb;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
            gap: 15px;
        }

        .table-container {
            overflow-x: auto;
            margin-top: 20px;
            background: #ffffff;
            padding: 20px;
            border-radius: 12px;
            border: 1px solid #e0e4eb;
            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.06);
        }

        .table {
            width: 100%;
            font-size: 13px;
            background-color: #fbfcfd;
        }

            .table th, .table td {
                border: 0.5px solid #dee2e6 !important;
                padding: 8px 12px;
                text-align: center;
                vertical-align: middle;
                white-space: nowrap;
            }

        th {
            background-color: #2a4d8c;
            color: #ffffff;
            font-weight: 600;
            text-transform: uppercase;
        }

        .table tr:nth-child(even) td {
            background-color: #f8faff;
        }

        .table tr:hover td {
            background-color: #eaf1fb;
        }

        .action-buttons .btn {
            margin: 0 2px;
        }
    </style>
</head>

<body>
    <div class="container-fluid">

        <h1 class="page-title">SLRM IT-ASSET MANAGEMENT &gt; TV</h1>



        <div class="d-flex justify-content-between align-items-center mb-3">
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus"></i> Add New TV
            </a>
            <span class="text-muted small">
                Total: <span id="total-count">@Model.Count()</span> assets
            </span>
        </div>

        <!-- Table -->
        <div class="table-container">
            <div class="d-flex justify-content-end mb-3">
                <div style="width:300px;">
                    <input type="text"
                           id="searchInput"
                           class="form-control"
                           placeholder="🔍 Search printers..."
                           onkeyup="searchTable()">
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover" id="tv-table">
                    <thead>
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.AssetLocation)</th>
                            <th>@Html.DisplayNameFor(model => model.TvSerialNo)</th>
                            <th>@Html.DisplayNameFor(model => model.Model)</th>
                            <th>@Html.DisplayNameFor(model => model.ScreenSize)</th>
                            <th>@Html.DisplayNameFor(model => model.Department)</th>
                            <th>@Html.DisplayNameFor(model => model.UserName)</th>
                            <th>@Html.DisplayNameFor(model => model.Qty)</th>
                            <th>@Html.DisplayNameFor(model => model.Status)</th>
                            <th>@Html.DisplayNameFor(model => model.VendorName)</th>
                            <th>@Html.DisplayNameFor(model => model.Cost)</th>
                            <th>@Html.DisplayNameFor(model => model.PurchaseDate)</th>
                            <th>@Html.DisplayNameFor(model => model.ExpiryDate)</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@Html.DisplayFor(modelItem => item.AssetLocation.Name)</td>
                                <td>@Html.DisplayFor(modelItem => item.TvSerialNo)</td>
                                <td>@Html.DisplayFor(modelItem => item.Model)</td>
                                <td>@Html.DisplayFor(modelItem => item.ScreenSize)</td>
                                <td>@Html.DisplayFor(modelItem => item.Department.DepartmentName)</td>
                                <td>@Html.DisplayFor(modelItem => item.UserName)</td>
                                <td>@Html.DisplayFor(modelItem => item.Qty)</td>
                                <td>@Html.DisplayFor(modelItem => item.Status)</td>
                                <td>@Html.DisplayFor(modelItem => item.VendorName)</td>
                                <td>@Html.DisplayFor(modelItem => item.Cost)</td>
                                <td>@Html.DisplayFor(modelItem => item.PurchaseDate)</td>
                                <td>@Html.DisplayFor(modelItem => item.ExpiryDate)</td>
                                <td>
                                    <span class="badge bg-secondary">
                                        @Html.DisplayFor(modelItem => item.Status)
                                    </span>
                                </td>
                                <td>
                                    <div class="action-buttons btn-group btn-group-sm">
                                        <a asp-action="Edit" asp-route-id="@item.TvId" class="btn btn-warning">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.TvId" class="btn btn-info">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.TvId" class="btn btn-danger">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    

    <script>
        function searchTable() {
            let input = document.getElementById("searchInput");
            let filter = input.value.toUpperCase();

            let table = document.getElementById("printers-table");
            let tr = table.getElementsByTagName("tr");

            for (let i = 1; i < tr.length; i++) {
                let rowVisible = false;

                let td = tr[i].getElementsByTagName("td");

                for (let j = 0; j < td.length; j++) {
                    if (td[j]) {
                        let txtValue = td[j].textContent || td[j].innerText;

                        if (txtValue.toUpperCase().indexOf(filter) > -1) {
                            rowVisible = true;
                            break;
                        }
                    }
                }

                tr[i].style.display = rowVisible ? "" : "none";
            }
        }
    </script>

</body>
</html>