@model IEnumerable<SLRM_IT_Assest_Management.Models.StockIssue>

@{
    ViewData["Title"] = "Level 1 Approval";

    int sl = 1;

    var totalRequests = Model.Count();
    var totalQty = Model.Sum(x => x.IssueQty);
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

<style>

    body {
        background: #f4f6f9;
    }

    .page-title {
        font-size: 28px;
        font-weight: 700;
        color: #2c3e50;
    }

    .card-summary {
        border: none;
        border-radius: 12px;
        box-shadow: 0 3px 10px rgba(0,0,0,.08);
    }

    .table-card {
        border: none;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 3px 10px rgba(0,0,0,.08);
    }

    .table thead {
        background: #0d6efd;
        color: #fff;
    }

    .table tbody tr:hover {
        background: #eef5ff;
    }

    .search-box {
        width: 300px;
    }

    .badge {
        padding: 8px 12px;
    }

</style>

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <div class="page-title">
                Level 1 Approval
            </div>

            <small class="text-muted">
                Department Head Approval
            </small>

        </div>

        <div>

            <a href="javascript:history.back()" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i>
                Back
            </a>

        </div>

    </div>

    <div class="row mb-4">

        <div class="col-md-3">

            <div class="card card-summary">

                <div class="card-body d-flex justify-content-between">

                    <div>

                        <h6>Pending Requests</h6>

                        <h2>@totalRequests</h2>

                    </div>

                    <i class="bi bi-hourglass-split text-warning fs-1"></i>

                </div>

            </div>

        </div>

        <div class="col-md-3">

            <div class="card card-summary">

                <div class="card-body d-flex justify-content-between">

                    <div>

                        <h6>Total Quantity</h6>

                        <h2>@totalQty</h2>

                    </div>

                    <i class="bi bi-box-seam text-primary fs-1"></i>

                </div>

            </div>

        </div>

    </div>

    <div class="card table-card">

        <div class="card-header bg-white">

            <div class="d-flex justify-content-between">

                <input type="text"
                       id="searchInput"
                       class="form-control search-box"
                       placeholder="Search Employee / Item..." />

                <span class="fw-bold">

                    Total Records :
                    @totalRequests

                </span>

            </div>

        </div>

        <div class="table-responsive">

            <table class="table table-bordered table-hover mb-0" id="approvalTable">

                <thead>

                    <tr>

                        <th>Sl</th>
                        <th>Item</th>
                        <th>Department</th>
                        <th>Employee</th>
                        <th>Emp Code</th>
                        <th>Qty</th>
                        <th>Request Date</th>
                        <th width="220">Action</th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {

                            <tr>

                                <td>@sl</td>

                                <td>
                                    @item.StockInventory?.ItemNameMaster?.ItemName
                                    <br />
                                    <small class="text-muted">
                                        @item.StockInventory?.ItemCodeMaster?.ItemCode
                                    </small>
                                </td>

                                <td>
                                    @item.Department?.DepartmentName
                                </td>

                                <td>
                                    @item.EmployeeName
                                </td>

                                <td>
                                    @item.EmployeeCode
                                </td>

                                <td>
                                    <span class="badge bg-primary">
                                        @item.IssueQty
                                    </span>
                                </td>

                                <td>
                                    @item.RequestDate.ToString("dd-MM-yyyy")
                                </td>

                                <td>

                                    <a asp-action="ApproveLevel1"
                                       asp-route-id="@item.IssueId"
                                       class="btn btn-success btn-sm">

                                        <i class="bi bi-check-circle-fill"></i>

                                        Approve

                                    </a>

                                    <button class="btn btn-danger btn-sm"
                                            data-bs-toggle="modal"
                                            data-bs-target="#rejectModal@(item.IssueId)">

                                        <i class="bi bi-x-circle-fill"></i>

                                        Reject

                                    </button>

                                </td>

                            </tr>

                            <div class="modal fade"
                                 id="rejectModal@(item.IssueId)"
                                 tabindex="-1">

                                <div class="modal-dialog">

                                    <div class="modal-content">

                                        <form asp-action="RejectLevel1" method="post">

                                            <div class="modal-header bg-danger text-white">

                                                <h5 class="modal-title">

                                                    Reject Request

                                                </h5>

                                                <button class="btn-close btn-close-white"
                                                        data-bs-dismiss="modal">
                                                </button>

                                            </div>

                                            <div class="modal-body">

                                                <input type="hidden"
                                                       name="id"
                                                       value="@item.IssueId" />

                                                <label class="form-label">

                                                    Remarks

                                                </label>

        <textarea class="form-control"
          rows="4"
          name="remarks"
          required></textarea>

                                            </div>

                                            <div class="modal-footer">

                                                <button class="btn btn-secondary"
                                                        data-bs-dismiss="modal">

                                                    Cancel

                                                </button>

                                                <button type="submit"
                                                        class="btn btn-danger">

                                                    Reject

                                                </button>

                                            </div>

                                        </form>

                                    </div>

                                </div>

                            </div>

                            sl++;

                        }
                    }
                    else
                    {

                        <tr>

                            <td colspan="8" class="text-center p-5">

                                <i class="bi bi-check-circle fs-1 text-success"></i>

                                <h5 class="mt-3">

                                    No Pending Requests

                                </h5>

                                <p class="text-muted">

                                    There are no requests waiting for Level 1 Approval.

                                </p>

                            </td>

                        </tr>

                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        document.getElementById("searchInput").addEventListener("keyup",function(){

        var value=this.value.toLowerCase();

        document.querySelectorAll("#approvalTable tbody tr").forEach(function(row){

        row.style.display=row.innerText.toLowerCase().indexOf(value)>-1?"":"none";

        });

        });

    </script>

}