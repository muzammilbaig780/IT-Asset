@model IEnumerable<SLRM_IT_Assest_Management.Models.StockIssue>

@{
    ViewData["Title"] = "Stock Issue";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

<style>
    body {
        background: #f4f7fb;
    }

    .dashboard-card {
        border: none;
        border-radius: 15px;
        box-shadow: 0 3px 12px rgba(0,0,0,.08);
        transition: .3s;
    }

        .dashboard-card:hover {
            transform: translateY(-4px);
        }

    .icon-box {
        width: 55px;
        height: 55px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        color: white;
    }

    .table-card {
        border: none;
        border-radius: 15px;
        box-shadow: 0 2px 10px rgba(0,0,0,.08);
    }

    .table thead {
        background: #0d6efd;
        color: white;
    }

    .table td {
        vertical-align: middle;
    }

    .badge {
        font-size: 13px;
        padding: 8px 12px;
    }

    .search-box {
        width: 300px;
    }

    .btn-action {
        width: 35px;
        height: 35px;
        border-radius: 8px;
    }

</style>

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold">Stock Issue Requests</h2>
            <small class="text-muted">Manage Inventory Issue Requests</small>
        </div>

        <div class="d-flex gap-2">

            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> New Request
            </a>

            <a asp-action="Level1Approval" class="btn btn-warning">
                <i class="bi bi-person-check"></i> Level 1 Approval
            </a>

            <a asp-action="Level2Approval" class="btn btn-info text-white">
                <i class="bi bi-person-check-fill"></i> Level 2 Approval
            </a>

            <a asp-action="IssueStock" class="btn btn-success">
                <i class="bi bi-box-arrow-right"></i> Issue Stock
            </a>
            <a href="javascript:history.back();" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i>
                Back
            </a>
        </div>

    </div>

    <!-- Dashboard -->

    <div class="row mb-4">

        <div class="col-md-3">

            <div class="card dashboard-card">

                <div class="card-body d-flex justify-content-between">

                    <div>
                        <h6>Total Requests</h6>
                        <h2>@Model.Count()</h2>
                    </div>

                    <div class="icon-box bg-primary">
                        <i class="bi bi-box-seam"></i>
                    </div>

                </div>

            </div>

        </div>

        <div class="col-md-3">

            <div class="card dashboard-card">

                <div class="card-body d-flex justify-content-between">

                    <div>
                        <h6>Pending</h6>
                        <h2>@Model.Count(x => x.Status == "Pending")</h2>
                    </div>

                    <div class="icon-box bg-warning">
                        <i class="bi bi-hourglass-split"></i>
                    </div>

                </div>

            </div>

        </div>

        <div class="col-md-3">

            <div class="card dashboard-card">

                <div class="card-body d-flex justify-content-between">

                    <div>
                        <h6>Approved</h6>
                        <h2>@Model.Count(x => x.Status == "Approved")</h2>
                    </div>

                    <div class="icon-box bg-success">
                        <i class="bi bi-check-circle"></i>
                    </div>

                </div>

            </div>

        </div>

        <div class="col-md-3">

            <div class="card dashboard-card">

                <div class="card-body d-flex justify-content-between">

                    <div>
                        <h6>Issued</h6>
                        <h2>@Model.Count(x => x.Status == "Issued")</h2>
                    </div>

                    <div class="icon-box bg-danger">
                        <i class="bi bi-arrow-up-circle"></i>
                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- Table -->

    <div class="card table-card">

        <div class="card-header bg-white">

            <div class="d-flex justify-content-between">

                <input class="form-control search-box"
                       id="search"
                       placeholder="Search Employee / Item..." />

                <span class="fw-bold">
                    Total Records : @Model.Count()
                </span>

            </div>

        </div>

        <div class="card-body p-0">

            <table class="table table-hover table-bordered mb-0" id="issueTable">

                <thead>

                    <tr>

                        <th>Sl</th>
                        <th>Item</th>
                        <th>Department</th>
                        <th>Employee</th>
                        <th>Emp Code</th>
                        <th>Qty</th>
                        <th>Request Date</th>
                        <th>Level 1</th>
                        <th>Level 2</th>
                        <th>Status</th>
                        <th width="160">Action</th>

                    </tr>

                </thead>

                <tbody>

                    @{
                        int i = 1;
                    }

                    @foreach (var item in Model)
                    {

                        <tr>

                            <td>@i</td>

                            <td>
                                @item.StockInventory?.ItemDisplay
                            </td>

                            <td>@item.Department?.DepartmentName</td>

                            <td>@item.EmployeeName</td>

                            <td>@item.EmployeeCode</td>

                            <td>

                                <span class="badge bg-primary">

                                    @item.IssueQty

                                </span>

                            </td>

                            <td>@item.RequestDate.ToString("dd-MM-yyyy")</td>

                            <td>

                                @if (item.Level1Status == "Approved")
                                {
                                    <span class="badge bg-success">Approved</span>
                                }
                                else if (item.Level1Status == "Rejected")
                                {
                                    <span class="badge bg-danger">Rejected</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }

                            </td>

                            <td>

                                @if (item.Level2Status == "Approved")
                                {
                                    <span class="badge bg-success">Approved</span>
                                }
                                else if (item.Level2Status == "Rejected")
                                {
                                    <span class="badge bg-danger">Rejected</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }

                            </td>

                            <td>

                                @if (item.Status == "Issued")
                                {
                                    <span class="badge bg-success">Issued</span>
                                }
                                else if (item.Status == "Rejected")
                                {
                                    <span class="badge bg-danger">Rejected</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@item.Status</span>
                                }

                            </td>

                            <td>

                                <a asp-action="Details"
                                   asp-route-id="@item.IssueId"
                                   class="btn btn-info btn-sm btn-action">

                                    <i class="bi bi-eye"></i>

                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@item.IssueId"
                                   class="btn btn-warning btn-sm btn-action">

                                    <i class="bi bi-pencil-square"></i>

                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.IssueId"
                                   class="btn btn-danger btn-sm btn-action">

                                    <i class="bi bi-trash"></i>

                                </a>

                            </td>

                        </tr>

                        i++;

                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        $("#search").keyup(function(){

        var value=$(this).val().toLowerCase();

        $("#issueTable tbody tr").filter(function(){

        $(this).toggle($(this).text().toLowerCase().indexOf(value)>-1)

        });

        });

    </script>

}
