@model IEnumerable<SLRM_IT_Assest_Management.Models.StockIssue>

@{
    ViewData["Title"] = "Issue Stock";

    int sl = 1;

    var totalRequests = Model.Count();
    var totalQty = Model.Sum(x => x.IssueQty);
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

<style>

    body {
        background: #f4f6f9;
    }

    .page-title {
        font-size: 28px;
        font-weight: 700;
        color: #2c3e50;
    }

    .card-summary {
        border: none;
        border-radius: 12px;
        box-shadow: 0 3px 10px rgba(0,0,0,.08);
    }

    .table-card {
        border: none;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 3px 10px rgba(0,0,0,.08);
    }

    .table thead {
        background: #0d6efd;
        color: #fff;
    }

    .table td {
        vertical-align: middle;
    }

    .table tbody tr:hover {
        background: #eef5ff;
    }

    .search-box {
        width: 300px;
    }

    .btn-action {
        border-radius: 8px;
    }

</style>

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <div class="page-title">
                Issue Stock
            </div>

            <small class="text-muted">
                Final Stock Issue after Level 1 & Level 2 Approval
            </small>

        </div>

        <div class="d-flex gap-2">

            <a href="javascript:history.back()" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back
            </a>

        </div>

    </div>

    <!-- Summary -->

    <div class="row mb-4">

        <div class="col-md-3">

            <div class="card card-summary">

                <div class="card-body d-flex justify-content-between">

                    <div>

                        <h6>Total Approved Requests</h6>

                        <h2>@totalRequests</h2>

                    </div>

                    <i class="bi bi-check-circle-fill text-success fs-1"></i>

                </div>

            </div>

        </div>

        <div class="col-md-3">

            <div class="card card-summary">

                <div class="card-body d-flex justify-content-between">

                    <div>

                        <h6>Total Quantity</h6>

                        <h2>@totalQty</h2>

                    </div>

                    <i class="bi bi-box-seam text-primary fs-1"></i>

                </div>

            </div>

        </div>

    </div>

    <!-- Table -->

    <div class="card table-card">

        <div class="card-header bg-white">

            <div class="d-flex justify-content-between">

                <input type="text"
                       id="searchInput"
                       class="form-control search-box"
                       placeholder="Search Employee / Item..." />

                <span class="fw-bold">
                    Total Records : @totalRequests
                </span>

            </div>

        </div>

        <div class="table-responsive">

            <table class="table table-hover table-bordered mb-0" id="issueTable">

                <thead>

                    <tr>

                        <th>Sl</th>
                        <th>Item Name</th>
                        <th>Employee</th>
                        <th>Quantity</th>
                        <th>Status</th>
                        <th width="180">Action</th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>@sl</td>

                                <td>
                                    @item.StockInventory?.ItemNameMaster?.ItemName
                                    <br />
                                    <small class="text-muted">
                                        @item.StockInventory?.ItemCodeMaster?.ItemCode
                                    </small>
                                </td>

                                <td>
                                    @item.EmployeeName
                                </td>

                                <td>
                                    <span class="badge bg-primary">
                                        @item.IssueQty
                                    </span>
                                </td>

                                <td>
                                    <span class="badge bg-success">
                                        Approved
                                    </span>
                                </td>

                                <td>

                                    <a asp-action="Issue"
                                       asp-route-id="@item.IssueId"
                                       class="btn btn-success btn-sm btn-action"
                                       onclick="return confirm('Issue this stock?');">

                                        <i class="bi bi-box-arrow-up-right"></i>
                                        Issue Stock

                                    </a>

                                </td>

                            </tr>

                            sl++;
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="6" class="text-center p-5">

                                <i class="bi bi-inbox fs-1 text-secondary"></i>

                                <h5 class="mt-3">
                                    No Approved Requests Available
                                </h5>

                                <p class="text-muted">
                                    Level 1 and Level 2 approvals are required before issuing stock.
                                </p>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        document.getElementById("searchInput").addEventListener("keyup",function(){

            var value=this.value.toLowerCase();

            document.querySelectorAll("#issueTable tbody tr").forEach(function(row){

                row.style.display=row.innerText.toLowerCase().indexOf(value)>-1?"":"none";

            });

        });

    </script>

}