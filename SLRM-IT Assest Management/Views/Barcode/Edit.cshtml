@model SLRM_IT_Assest_Management.Models.Barcode

@{
    ViewData["Title"] = "Edit Barcode";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Edit Barcode - SLRM IT-ASSET MANAGEMENT</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        body {
            background-color: #f4f6f9;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding: 20px 0;
        }

        .page-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 2rem 0;
            margin-bottom: 2rem;
            border-radius: 0 0 20px 20px;
            position: relative;
            overflow: hidden;
        }

            .page-header::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.1'%3E%3Ccircle cx='30' cy='30' r='2'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
            }

        .page-title {
            font-size: 28px;
            font-weight: 700;
            margin: 0;
            position: relative;
            z-index: 2;
        }

        .page-subtitle {
            opacity: 0.9;
            margin: 0;
            position: relative;
            z-index: 2;
        }

        .form-container {
            background: #ffffff;
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.1);
            border: 1px solid #e9ecef;
            overflow: hidden;
            margin-bottom: 2rem;
        }

        .form-header {
            background: linear-gradient(135deg, #2a4d8c 0%, #1f3c88 100%);
            color: white;
            padding: 1.5rem 2rem;
            margin-bottom: 0;
        }

        .form-title {
            font-size: 20px;
            font-weight: 600;
            margin: 0;
            display: flex;
            align-items: center;
        }

        .form-body {
            padding: 2.5rem;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-label {
            font-weight: 600;
            color: #2a4d8c;
            margin-bottom: 0.5rem;
            font-size: 14px;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .form-control, .form-select {
            border: 2px solid #e9ecef;
            border-radius: 12px;
            padding: 12px 16px;
            font-size: 14px;
            transition: all 0.3s ease;
            background: #fbfcfd;
        }

            .form-control:focus, .form-select:focus {
                border-color: #667eea;
                box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
                background: white;
            }

        .barcode-preview {
            background: #f8f9fa;
            border: 2px dashed #dee2e6;
            border-radius: 12px;
            padding: 2rem;
            text-align: center;
            margin-bottom: 1.5rem;
            min-height: 120px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

            .barcode-preview.active {
                border-color: #28a745;
                background: linear-gradient(135deg, #d4edda 0%, #c3e6cb 100%);
            }

        .status-badge {
            padding: 6px 16px;
            border-radius: 25px;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
        }

        .status-active {
            background: #d4edda;
            color: #155724;
        }

        .status-inactive {
            background: #f8d7da;
            color: #721c24;
        }

        .status-pending {
            background: #fff3cd;
            color: #856404;
        }

        .btn-group-action {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .btn-primary-gradient {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            padding: 14px 32px;
            font-weight: 600;
            border-radius: 12px;
            box-shadow: 0 6px 20px rgba(102, 126, 234, 0.4);
            transition: all 0.3s ease;
        }

            .btn-primary-gradient:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 25px rgba(102, 126, 234, 0.5);
            }

        .btn-secondary-gradient {
            background: linear-gradient(135deg, #6c757d 0%, #495057 100%);
            border: none;
            padding: 14px 32px;
            font-weight: 600;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(108, 117, 125, 0.4);
        }

        media (max-width: 768px) {
            .form-grid

        {
            grid-template-columns: 1fr;
        }

        .form-body {
            padding: 1.5rem;
        }

        }
    </style>
</head>

<body>
    <div class="container-fluid">
        <!-- Page Header -->
        <div class="page-header">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <h1 class="page-title">
                            <i class="fas fa-edit me-3"></i>
                            Edit Barcode
                        </h1>
                        <p class="page-subtitle mb-0">
                            Update barcode information for <strong>@Model.ITAssetTag</strong>
                        </p>
                    </div>
                    <div class="col-md-4 text-md-end mt-3 mt-md-0">
                        <span class="status-badge @($"status-{Model.Status?.ToLower() ?? "pending"}")">
                            <i class="fas fa-circle me-1"></i>
                            @Model.Status
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <div class="container">
            <div class="row justify-content-center">
                <div class="col-xl-10 col-lg-12">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            Please correct the errors below before saving.
                        </div>
                    }

                    <form asp-action="Edit" method="post">
                        <input asp-for="BarcodeId" type="hidden" />

                        <div class="form-container">
                            <!-- Form Header -->
                            <div class="form-header">
                                <h2 class="form-title">
                                    <i class="fas fa-barcode me-2"></i>
                                    Barcode Details
                                </h2>
                            </div>

                            <!-- Form Body -->
                            <div class="form-body">
                                <!-- Barcode Preview -->
                                <div class="barcode-preview @(string.IsNullOrEmpty(Model.ITAssetTag) ? "" : "active")">
                                    <i class="fas fa-barcode fa-4x text-muted mb-3"></i>
                                    <h5 class="text-muted mb-1">Barcode Preview</h5>
                                    <p class="small text-muted mb-0">
                                        Asset Tag: <strong>@Model.ITAssetTag</strong>
                                    </p>
                                </div>

                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="form-grid">
                                            <div class="form-group">
                                                <label asp-for="ITAssetTag" class="form-label">
                                                    <i class="fas fa-tag text-primary"></i> Asset Tag *
                                                </label>
                                                <input asp-for="ITAssetTag" class="form-control" placeholder="Enter asset tag" />
                                                <span asp-validation-for="ITAssetTag" class="text-danger small"></span>
                                            </div>

                                            <div class="form-group">
                                                <label asp-for="Make" class="form-label">
                                                    <i class="fas fa-industry text-primary"></i> Make
                                                </label>
                                                <input asp-for="Make" class="form-control" placeholder="Enter make" />
                                                <span asp-validation-for="Make" class="text-danger small"></span>
                                            </div>

                                            <div class="form-group">
                                                <label asp-for="Model" class="form-label">
                                                    <i class="fas fa-cube text-primary"></i> Model
                                                </label>
                                                <input asp-for="Model" class="form-control" placeholder="Enter model" />
                                                <span asp-validation-for="Model" class="text-danger small"></span>
                                            </div>

                                            <div class="form-group">
                                                <label asp-for="SerialNumber" class="form-label">
                                                    <i class="fas fa-hashtag text-primary"></i> Serial Number
                                                </label>
                                                <input asp-for="SerialNumber" class="form-control" placeholder="Enter serial number" />
                                                <span asp-validation-for="SerialNumber" class="text-danger small"></span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-lg-6">
                                        <div class="form-grid">
                                            <div class="form-group">
                                                <label asp-for="AssetLocationId" class="form-label">
                                                    <i class="fas fa-map-marker-alt text-primary"></i> Location
                                                </label>
                                                <select asp-for="AssetLocationId" class="form-select" asp-items="ViewBag.AssetLocations">
                                                    <option value="">-- Select Location --</option>
                                                </select>
                                                <span asp-validation-for="AssetLocationId" class="text-danger small"></span>
                                            </div>

                                            <div class="form-group">
                                                <label asp-for="DepartmentId" class="form-label">
                                                    <i class="fas fa-building text-primary"></i> Department
                                                </label>
                                                <select asp-for="DepartmentId" class="form-select" asp-items="ViewBag.Departments">
                                                    <option value="">-- Select Department --</option>
                                                </select>
                                                <span asp-validation-for="DepartmentId" class="text-danger small"></span>
                                            </div>

                                            <div class="form-group">
                                                <label asp-for="Status" class="form-label">
                                                    <i class="fas fa-toggle-on text-primary"></i> Status *
                                                </label>
                                                <select asp-for="Status" class="form-select">
                                                    <option value="Active">Active</option>
                                                    <option value="Inactive">Inactive</option>
                                                    <option value="Pending">Pending</option>
                                                    <option value="Disposed">Disposed</option>
                                                </select>
                                                <span asp-validation-for="Status" class="text-danger small"></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Form Footer -->
                            <div class="d-flex justify-content-between align-items-center p-4 border-top bg-light">
                                <a asp-action="Index" class="btn btn-secondary-gradient">
                                    <i class="fas fa-arrow-left me-2"></i>Back to List
                                </a>
                                <div class="btn-group-action">
                                    <button type="submit" class="btn btn-primary-gradient">
                                        <i class="fas fa-save me-2"></i>Update Barcode
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Live barcode preview update
        document.getElementById('ITAssetTag').addEventListener('input', function() {
            const preview = document.querySelector('.barcode-preview');
            const tag = this.value || 'Enter Asset Tag';
            preview.classList.add('active');
            preview.querySelector('strong').textContent = tag;
        });

        // Form validation styling
        document.querySelectorAll('.form-control, .form-select').forEach(input => {
            input.addEventListener('blur', function() {
                if (this.classList.contains('is-invalid')) {
                    this.closest('.form-group').classList.add('has-validation-error');
                }
            });
        });
    </script>
</body>
</html>
