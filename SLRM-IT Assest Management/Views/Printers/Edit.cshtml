@model SLRM_IT_Assest_Management.Models.Printer

@{
    ViewData["Title"] = "Edit Printer";
}

<h2>Edit Printer</h2>

<form asp-action="Edit" method="post">
    <div class="form-group">
        <label asp-for="ITAssetTag" class="control-label">IT Asset Tag</label>
        <input asp-for="ITAssetTag" class="form-control" />
        <span asp-validation-for="ITAssetTag" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Division" class="control-label">Division</label>
        <input asp-for="Division" class="form-control" />
        <span asp-validation-for="Division" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="PrinterMake" class="control-label">Printer Make</label>
        <input asp-for="PrinterMake" class="form-control" />
        <span asp-validation-for="PrinterMake" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="PrinterModel" class="control-label">Printer Model</label>
        <input asp-for="PrinterModel" class="form-control" />
        <span asp-validation-for="PrinterModel" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="SerialNumber" class="control-label">Serial Number</label>
        <input asp-for="SerialNumber" class="form-control" />
        <span asp-validation-for="SerialNumber" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="CartridgeType" class="control-label">Cartridge Type</label>
        <input asp-for="CartridgeType" class="form-control" />
        <span asp-validation-for="CartridgeType" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Status" class="control-label">Status</label>
        <input asp-for="Status" class="form-control" />
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Warranty" class="control-label">Warranty</label>
        <input asp-for="Warranty" class="form-control" />
        <span asp-validation-for="Warranty" class="text-danger"></span>
    </div>

    <!-- Dropdown for Asset Type -->
    @* <div class="form-group">
        <label asp-for="AssetTypeId" class="control-label">Asset Type</label>
        <select asp-for="AssetTypeId" class="form-control">
            <option value="">Select Asset Type</option>
            @foreach (var item in ViewData["AssetTypes"] as List<AssetType>)
            {
                <option value="@item.AssetTypeId" selected="@(item.AssetTypeId == Model.AssetTypeId ? "selected" : "")">@item.Name</option>
            }
        </select>
        <span asp-validation-for="AssetTypeId" class="text-danger"></span>
    </div> *@

    <!-- Dropdown for Asset Location -->
    <div class="form-group">
        <label asp-for="AssetLocationId" class="control-label">Location</label>
        <select asp-for="AssetLocationId" class="form-control">
            <option value="">Select Location</option>
            @foreach (var item in ViewData["Locations"] as List<AssetLocation>)
            {
                <option value="@item.AssetLocationId" selected="@(item.AssetLocationId == Model.AssetLocationId ? "selected" : "")">@item.Name</option>
            }
        </select>
        <span asp-validation-for="AssetLocationId" class="text-danger"></span>
    </div>

    <!-- Dropdown for Department -->
    <div class="form-group">
        <label asp-for="DepartmentId" class="control-label">Department</label>
        <select asp-for="DepartmentId" class="form-control">
            <option value="">Select Department</option>
            @foreach (var item in ViewData["Departments"] as List<Department>)
            {
                <option value="@item.DepartmentId" selected="@(item.DepartmentId == Model.DepartmentId ? "selected" : "")">@item.DepartmentName</option>
            }
        </select>
        <span asp-validation-for="DepartmentId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="GRNDate" class="control-label">GRN Date</label>
        <input asp-for="GRNDate" class="form-control" type="date" />
        <span asp-validation-for="GRNDate" class="text-danger"></span>
    </div>

    @* <div class="form-group">
        <label asp-for="InvoiceNumber" class="control-label">Invoice Number</label>
        <input asp-for="InvoiceNumber" class="form-control" />
        <span asp-validation-for="InvoiceNumber" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="PONumber" class="control-label">PO Number</label>
        <input asp-for="PONumber" class="form-control" />
        <span asp-validation-for="PONumber" class="text-danger"></span>
    </div> *@

    <div class="form-group">
        <label asp-for="EndDate" class="control-label">End Date</label>
        <input asp-for="EndDate" class="form-control" type="date" />
        <span asp-validation-for="EndDate" class="text-danger"></span>
    </div>

    <div class="form-group">
        <button type="submit" class="btn btn-primary">Save Changes</button>
    </div>
</form>

<div>
    <a href="@Url.Action("Index", "Printers")" class="btn btn-secondary">Back to List</a>
</div>
