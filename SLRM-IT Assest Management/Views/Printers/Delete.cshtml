@model SLRM_IT_Assest_Management.Models.Printer

@{
    ViewData["Title"] = "Delete Printer";
}

<h2>Delete Printer</h2>

<h3>Are you sure you want to delete this printer?</h3>

<div>
    <h4>Printer Information</h4>
    <dl class="row">
        <dt class="col-sm-2">IT Asset Tag</dt>
        <dd class="col-sm-10">@Model.ITAssetTag</dd>

        <dt class="col-sm-2">Division</dt>
        <dd class="col-sm-10">@Model.Division</dd>

        <dt class="col-sm-2">Printer Make</dt>
        <dd class="col-sm-10">@Model.PrinterMake</dd>

        <dt class="col-sm-2">Printer Model</dt>
        <dd class="col-sm-10">@Model.PrinterModel</dd>

        <dt class="col-sm-2">Serial Number</dt>
        <dd class="col-sm-10">@Model.SerialNumber</dd>

        <dt class="col-sm-2">Cartridge Type</dt>
        <dd class="col-sm-10">@Model.CartridgeType</dd>

        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">@Model.Status</dd>

        @* <dt class="col-sm-2">Vendor Name</dt>
        <dd class="col-sm-10">@Model.VendorName</dd> *@

        @* <dt class="col-sm-2">Asset Type</dt>
        <dd class="col-sm-10">@Model.AssetType?.Name</dd> *@

        <dt class="col-sm-2">Location</dt>
        <dd class="col-sm-10">@Model.AssetLocation?.Name</dd>

        <dt class="col-sm-2">Department</dt>
        <dd class="col-sm-10">@Model.Department?.DepartmentName</dd>

        <dd class="col-sm-10">
            @(Model.GRNDate?.ToString("yyyy-MM-dd") ?? "-")
        </dd>

        <dd class="col-sm-10">
            @(Model.EndDate?.ToString("yyyy-MM-dd") ?? "-")
        </dd>


        @* <dt class="col-sm-2">Invoice Number</dt>
        <dd class="col-sm-10">@Model.InvoiceNumber</dd>

        <dt class="col-sm-2">PO Number</dt>
        <dd class="col-sm-10">@Model.PONumber</dd> *@

        <dt class="col-sm-2">Warranty</dt>
        <dd class="col-sm-10">@Model.Warranty</dd>

        @* <dt class="col-sm-2">End Date</dt>
        <dd class="col-sm-10">@Model.EndDate.ToString("yyyy-MM-dd")</dd> *@
    </dl>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="PrinterId" />
    <div class="form-group">
        <button type="submit" class="btn btn-danger">Delete</button>
        <a href="@Url.Action("Index", "Printers")" class="btn btn-secondary">Cancel</a>
    </div>
</form>
