@{
    ViewData["Title"] = "Filter Toolbar (Styled)";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
    .toolbar {
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 10px 15px;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
    }

        .toolbar select,
        .toolbar input {
            border-radius: 5px;
        }

        .toolbar .btn {
            border: none;
            border-radius: 6px;
            padding: 6px 9px;
            font-size: 0.85rem;
            transition: all 0.2s ease-in-out;
        }

    /* Icon button colors */
    .btn-view {
        background-color: #0dcaf0;
        color: white;
    }

    .btn-add {
        background-color: #0d6efd;
        color: white;
    }

    .btn-delete {
        background-color: #dc3545;
        color: white;
    }

    .btn-refresh {
        background-color: #6c757d;
        color: white;
    }

    .btn-download {
        background-color: #198754;
        color: white;
    }

    .btn-print {
        background-color: #212529;
        color: white;
    }

    .btn-zoom {
        background-color: #0d6efd;
        color: white;
    }

    .btn-columns {
        background-color: #6c757d;
        color: white;
    }

    /* Hover effects */
    .toolbar .btn:hover {
        filter: brightness(0.9);
        transform: scale(1.05);
    }

    .toolbar .dropdown-menu {
        min-width: 230px;
        max-height: 280px;
        overflow-y: auto;
        border-radius: 8px;
    }

    /* Sticky search bar inside dropdown */
    .dropdown-search {
        position: sticky;
        top: 0;
        background: white;
        padding: 5px 8px;
        border-bottom: 1px solid #ddd;
        z-index: 10;
    }

        .dropdown-search input {
            width: 100%;
            padding: 5px;
            border-radius: 6px;
            border: 1px solid #ccc;
        }

    /* Toggle All section */
    .toggle-all {
        position: sticky;
        top: 45px;
        background: white;
        padding: 5px 8px;
        border-bottom: 1px solid #ddd;
        z-index: 9;
    }

    .dropdown-item {
        padding: 4px 10px;
        font-size: 0.9rem;
    }
</style>

<div class="container-fluid px-4 mt-3">
    <div class="d-flex justify-content-end">
        <div class="toolbar shadow-sm">

            <!-- Filter -->
            <div class="d-flex align-items-center">
                <select id="filterOption" class="form-select form-select-sm me-2" style="width: 150px;">
                    <option value="All" selected="@(ViewBag.Filter == "All")">All</option>
                    <option value="Laptop" selected="@(ViewBag.Filter == "Laptop")">Laptop</option>
                    <option value="Desktop" selected="@(ViewBag.Filter == "Desktop")">Desktop</option>
                </select>
                <button id="applyFilter" class="btn btn-outline-secondary btn-sm">Go</button>
            </div>

            <!-- Rows per page -->
            <div class="d-flex align-items-center">
                <select id="rowsPerPage" class="form-select form-select-sm me-2" style="width: 80px;">
                    <option value="10" selected="@(ViewBag.PageSize == 10)">10</option>
                    <option value="25" selected="@(ViewBag.PageSize == 25)">25</option>
                    <option value="50" selected="@(ViewBag.PageSize == 50)">50</option>
                    <option value="100" selected="@(ViewBag.PageSize == 100)">100</option>
                </select>
                <span class="text-muted small">Rows per page</span>
            </div>

            <!-- Search -->
            <div class="input-group input-group-sm" style="max-width: 220px;">
                <input type="text" id="tableSearch" class="form-control" placeholder="Search">
                <button class="btn btn-outline-secondary" id="clearSearch"><i class="fas fa-times"></i></button>
            </div>

            <!-- Buttons -->
            <div class="btn-group btn-group-sm ms-auto" role="group">
                <button class="btn btn-view" title="View Table"><i class="fas fa-table"></i></button>
                <a asp-controller="Assets" asp-action="Create" class="btn btn-add" title="Add New"><i class="fas fa-plus"></i></a>
                <button class="btn btn-delete" title="Delete"><i class="fas fa-trash"></i></button>
                <button class="btn btn-refresh" title="Refresh"><i class="fas fa-sync"></i></button>
                <button class="btn btn-download" title="Download"><i class="fas fa-download"></i></button>
                <button class="btn btn-print" title="Print"><i class="fas fa-print"></i></button>
                <button class="btn btn-zoom" title="Zoom"><i class="fas fa-search-plus"></i></button>

                <!-- Column Toggle -->
                <div class="dropdown">
                    <button class="btn btn-columns dropdown-toggle" type="button" id="toggleColumnsBtn" data-bs-toggle="dropdown" aria-expanded="false" title="Show/Hide Columns">
                        <i class="fas fa-columns"></i>
                    </button>

                    <ul class="dropdown-menu dropdown-menu-end p-0 shadow-sm" aria-labelledby="toggleColumnsBtn">
                        <li class="p-2">
                            <input type="text" id="columnSearch" class="form-control form-control-sm" placeholder="Search columns...">
                        </li>

                        <li class="p-2 border-top">
                            <label><input type="checkbox" id="toggleAll" class="form-check-input me-2">Toggle all</label>
                        </li>

                        <!-- Column List -->
                        <li class="p-2">
                            <ul class="list-unstyled m-0">
                                <li><label class="dropdown-item"><input type="checkbox" class="form-check-input me-2 column-toggle" data-column="1" checked>Company</label></li>
                                <li><label class="dropdown-item"><input type="checkbox" class="form-check-input me-2 column-toggle" data-column="2" checked>Asset Type</label></li>
                                <li><label class="dropdown-item"><input type="checkbox" class="form-check-input me-2 column-toggle" data-column="3" checked>Department</label></li>
                                <li><label class="dropdown-item"><input type="checkbox" class="form-check-input me-2 column-toggle" data-column="4" checked>UserName</label></li>
                                <li><label class="dropdown-item"><input type="checkbox" class="form-check-input me-2 column-toggle" data-column="5" checked>EmpCode</label></li>
                                <li><label class="dropdown-item"><input type="checkbox" class="form-check-input me-2 column-toggle" data-column="6" checked>Host Name</label></li>
                                <li><label class="dropdown-item"><input type="checkbox" class="form-check-input me-2 column-toggle" data-column="7" checked>Block</label></li>
                                <li><label class="dropdown-item"><input type="checkbox" class="form-check-input me-2 column-toggle" data-column="8" checked>AssetLocation</label></li>
                                <li><label class="dropdown-item"><input type="checkbox" class="form-check-input me-2 column-toggle" data-column="9" checked>AssetTag</label></li>
                                <li><label class="dropdown-item"><input type="checkbox" class="form-check-input me-2 column-toggle" data-column="11" checked>Make</label></li>
                                <li><label class="dropdown-item"><input type="checkbox" class="form-check-input me-2 column-toggle" data-column="12" checked>Model</label></li>
                                <li><label class="dropdown-item"><input type="checkbox" class="form-check-input me-2 column-toggle" data-column="13" checked>Serial No</label></li>
                                <li><label class="dropdown-item"><input type="checkbox" class="form-check-input me-2 column-toggle" data-column="14" checked>Processor</label></li>
                                <li><label class="dropdown-item"><input type="checkbox" class="form-check-input me-2 column-toggle" data-column="15" checked>RAM</label></li>
                                <li><label class="dropdown-item"><input type="checkbox" class="form-check-input me-2 column-toggle" data-column="16" checked>HDD</label></li>
                                <li><label class="dropdown-item"><input type="checkbox" class="form-check-input me-2 column-toggle" data-column="17" checked>Division</label></li>
                                <li><label class="dropdown-item"><input type="checkbox" class="form-check-input me-2 column-toggle" data-column="18" checked>AntiVirus</label></li>
                                <li><label class="dropdown-item"><input type="checkbox" class="form-check-input me-2 column-toggle" data-column="19" checked>Status</label></li>
                                <li><label class="dropdown-item"><input type="checkbox" class="form-check-input me-2 column-toggle" data-column="20" checked>OS Version</label></li>
                                <li><label class="dropdown-item"><input type="checkbox" class="form-check-input me-2 column-toggle" data-column="21" checked>AutoCad</label></li>
                                <li><label class="dropdown-item"><input type="checkbox" class="form-check-input me-2 column-toggle" data-column="22" checked>Office</label></li>
                                <li><label class="dropdown-item"><input type="checkbox" class="form-check-input me-2 column-toggle" data-column="23" checked>WindowsLicenseKey</label></li>
                                <li><label class="dropdown-item"><input type="checkbox" class="form-check-input me-2 column-toggle" data-column="24" checked>Office</label></li>
                                <li><label class="dropdown-item"><input type="checkbox" class="form-check-input me-2 column-toggle" data-column="25" checked>IPAddress</label></li>
                                <li><label class="dropdown-item"><input type="checkbox" class="form-check-input me-2 column-toggle" data-column="26" checked>AuditStatus</label></li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>


<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
    // Filter and rows per page functionality
    $('#applyFilter').on('click', function () {
        const filter = $('#filterOption').val();
        const pageSize = $('#rowsPerPage').val();
        window.location.href = `/Assets/Index?filter=${filter}&page=1&pageSize=${pageSize}`;
    });

    $('#rowsPerPage').on('change', function () {
        const filter = $('#filterOption').val();
        const pageSize = this.value;
        window.location.href = `/Assets/Index?filter=${filter}&page=1&pageSize=${pageSize}`;
    });

    // Clear Search
    $('#clearSearch').on('click', function () {
        $('#tableSearch').val('');
    });

    // Column search inside dropdown
    $('#columnSearch').on('keyup', function () {
        const value = $(this).val().toLowerCase();
        $('#columnList li').filter(function () {
            $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
        });
    });

    // Toggle all checkboxes
    $('#toggleAll').on('change', function () {
        const checked = $(this).is(':checked');
        $('.column-toggle').prop('checked', checked).trigger('change');
    });

    // Toggle columns dynamically
    $('.column-toggle').on('change', function () {
        var columnIndex = $(this).data('column');
        var isVisible = $(this).is(':checked');
        $('table tr').each(function () {
            $(this).find('th, td').eq(columnIndex).toggle(isVisible);
        });
    });

     $(document).ready(function () {
        // Search Functionality
        $("#tableSearch").on("keyup", function () {
            var value = $(this).val().toLowerCase();
            $("table tbody tr").filter(function () {
                $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
            });
        });

        // Clear search and show all rows
        $("#clearSearch").on("click", function () {
            $("#tableSearch").val('');
            $("table tbody tr").show();
        });
    });
</script>
