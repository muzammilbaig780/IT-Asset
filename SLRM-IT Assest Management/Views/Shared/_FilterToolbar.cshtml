@{
    ViewData["Title"] = "Filter Toolbar Only";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
    .card {
        border-radius: 12px;
        margin-right: 20px;
    }

    .card-body {
        padding: 20px 18px;
    }
</style>
<div class="container mt-3">
    <div class="d-flex justify-content-end">
        <div class="card shadow-sm" style="width: fit-content; min-width: 650px; margin-right: 0;">
            <div class="card-body d-flex justify-content-end align-items-center flex-wrap gap-3">

                <!-- Filter dropdown -->
                <div class="d-flex align-items-center mb-2">
                    <label class="me-2">Filter By</label>
                    <select id="filterOption" class="form-select me-2" style="width: 150px;">
                        <option value="All" selected="@(ViewBag.Filter == "All")">All</option>
                        <option value="Laptop" selected="@(ViewBag.Filter == "Laptop")">Laptop</option>
                        <option value="Desktop" selected="@(ViewBag.Filter == "Desktop")">Desktop</option>
                    </select>
                    <button id="applyFilter" class="btn btn-secondary btn-sm">Go</button>
                </div>

                <!-- Rows per page -->
                <div class="d-flex align-items-center mb-2">
                    <label class="me-2">Rows per page</label>
                    <select id="rowsPerPage" class="form-select form-select-sm" style="width: 90px;">
                        <option value="10" selected="@(ViewBag.PageSize == 10)">10</option>
                        <option value="25" selected="@(ViewBag.PageSize == 25)">25</option>
                        <option value="50" selected="@(ViewBag.PageSize == 50)">50</option>
                        <option value="100" selected="@(ViewBag.PageSize == 100)">100</option>
                    </select>
                </div>

                <div class="d-flex align-items-center mb-3">
                    <!-- 🔍 Search Box -->
                    <div class="input-group input-group-sm me-3" style="max-width: 250px;">
                        <input type="text" id="tableSearch" class="form-control" placeholder="Search">
                        <button class="btn btn-outline-secondary" id="clearSearch"><i class="fas fa-times"></i></button>
                    </div>

                    <!-- 🔘 Action Buttons -->
                    <div class="btn-group btn-group-sm align-items-center" role="group">
                        <button class="btn btn-info" title="View Table"><i class="fas fa-table"></i></button>
                        <a asp-controller="Assets" asp-action="Create" class="btn btn-primary" title="Add New">
                            <i class="fas fa-plus"></i>
                        </a>
                        <button class="btn btn-danger" title="Delete"><i class="fas fa-trash"></i></button>
                        <button class="btn btn-secondary" title="Refresh"><i class="fas fa-sync"></i></button>
                        <button class="btn btn-success" title="Download"><i class="fas fa-download"></i></button>
                        <button class="btn btn-dark" title="Print"><i class="fas fa-print"></i></button>
                        <button class="btn btn-light border" title="Zoom"><i class="fas fa-search-plus"></i></button>

                        <!-- 📊 Column Toggle Dropdown (merged inside group) -->
                        <div class="dropdown">
                            <button class="btn btn-outline-secondary dropdown-toggle" type="button"
                                    id="toggleColumnsBtn" data-bs-toggle="dropdown" aria-expanded="false"
                                    title="Show/Hide Columns">
                                <i class="fas fa-columns"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end p-2 shadow-sm" aria-labelledby="toggleColumnsBtn" style="min-width: 180px;">
                                <li><label class="dropdown-item"><input type="checkbox" class="form-check-input me-2 column-toggle" data-column="1" checked>Company</label></li>
                                <li><label class="dropdown-item"><input type="checkbox" class="form-check-input me-2 column-toggle" data-column="2" checked>Asset Type</label></li>
                                <li><label class="dropdown-item"><input type="checkbox" class="form-check-input me-2 column-toggle" data-column="3" checked>Department</label></li>
                                <li><label class="dropdown-item"><input type="checkbox" class="form-check-input me-2 column-toggle" data-column="4" checked>UserName</label></li>
                                <li><label class="dropdown-item"><input type="checkbox" class="form-check-input me-2 column-toggle" data-column="5" checked>EmpCode</label></li>
                                <li><label class="dropdown-item"><input type="checkbox" class="form-check-input me-2 column-toggle" data-column="7" checked>AssetLocation</label></li>
                                <li><label class="dropdown-item"><input type="checkbox" class="form-check-input me-2 column-toggle" data-column="8" checked>AssetTag</label></li>
                                <li><label class="dropdown-item"><input type="checkbox" class="form-check-input me-2 column-toggle" data-column="13" checked>Processor</label></li>
                                <li><label class="dropdown-item"><input type="checkbox" class="form-check-input me-2 column-toggle" data-column="14" checked>Ram</label></li>
                                <li><label class="dropdown-item"><input type="checkbox" class="form-check-input me-2 column-toggle" data-column="15" checked>HDD</label></li>
                            </ul>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>



@if (ViewBag.TotalRecords > ViewBag.PageSize)
{
    int totalPages = (int)Math.Ceiling((double)ViewBag.TotalRecords / ViewBag.PageSize);
    int currentPage = ViewBag.CurrentPage;

    <!-- Pagination below the filter/search card -->
    <div class="d-flex justify-content-end pe-5 mt-2">
        <nav>
            <ul class="pagination mb-0">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="/Assets/Index?filter=@ViewBag.Filter&page=@(currentPage - 1)&pageSize=@ViewBag.PageSize">Previous</a>
                </li>

                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" href="/Assets/Index?filter=@ViewBag.Filter&page=@i&pageSize=@ViewBag.PageSize">@i</a>
                    </li>
                }

                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" href="/Assets/Index?filter=@ViewBag.Filter&page=@(currentPage + 1)&pageSize=@ViewBag.PageSize">Next</a>
                </li>
            </ul>
        </nav>
    </div>
}
<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
    // Example event handlers (connect later to your table or grid)
    $('#applyFilter').on('click', function () {
        alert('Filter applied: ' + $('#filterOption').val());
    });

    $('#clearSearch').on('click', function () {
        $('#tableSearch').val('');
        alert('Search cleared');
    });

    $('#tableSearch').on('keyup', function () {
        console.log('Searching for:', $(this).val());
    });

    $('#pageLength').on('change', function () {
        console.log('Rows per page:', $(this).val());
    });

    document.getElementById("applyFilter").addEventListener("click", function () {
        const filter = document.getElementById("filterOption").value;
        const pageSize = document.getElementById("rowsPerPage").value;
        window.location.href = `/Assets/Index?filter=${filter}&page=1&pageSize=${pageSize}`;
    });

    document.getElementById("rowsPerPage").addEventListener("change", function () {
        const filter = document.getElementById("filterOption").value;
        const pageSize = this.value;
        window.location.href = `/Assets/Index?filter=${filter}&page=1&pageSize=${pageSize}`;
    });

     $(document).ready(function () {
        // Toggle column visibility
        $('.column-toggle').on('change', function () {
            var columnIndex = $(this).data('column');
            var isVisible = $(this).is(':checked');
            var table = $('table');

            table.find('tr').each(function () {
                $(this).find('th, td').eq(columnIndex).toggle(isVisible);
            });
        });
    });

   </script>