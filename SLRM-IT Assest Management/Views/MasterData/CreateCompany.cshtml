@model SLRM_IT_Assest_Management.Models.Company

<form id="companyForm" method="post" asp-action="CreateCompany" asp-controller="MasterData">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label asp-for="CompanyName" class="form-label">Company Name *</label>
        <input asp-for="CompanyName" class="form-control" required />
        <span asp-validation-for="CompanyName" class="text-danger"></span>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        <button type="submit" class="btn btn-primary">Save Company</button>
    </div>
</form>
    