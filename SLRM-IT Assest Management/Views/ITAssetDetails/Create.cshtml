@model SLRM_IT_Assest_Management.Models.ITAssetDetail

@{
    ViewData["Title"] = "Create IT Asset";
}

<div class="container mt-4">

    <!-- ✅ HEADER WITH EXCEL IMPORT -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold mb-0">Create New IT Asset</h3>

        <form asp-action="ImportExcel" method="post" enctype="multipart/form-data" class="d-flex gap-2 align-items-end">

            <div>
                <label class="small fw-bold">Asset Type</label>
                <select name="assetType" class="form-select form-select-sm" required>
                    <option value="">Select</option>
                    <option value="Printer">Printer</option>
                    <option value="TV">TV</option>
                    <option value="CCTV">CCTV</option>
                    <option value="Laptop">Laptop</option>
                    <option value="Desktop">Desktop</option>
                </select>
            </div>

            <div>
                <label class="small fw-bold">Upload Excel</label>
                <input type="file" name="excelFile" class="form-control form-control-sm" required />
            </div>

            <button type="submit" class="btn btn-primary btn-sm mt-4">
                <i class="fa fa-upload"></i>
            </button>

            <a asp-action="Index" class="btn btn-secondary btn-sm mt-4">
                <i class="fa fa-arrow-left"></i>
            </a>

        </form>
    </div>

    <!-- ✅ MAIN CARD -->
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body">

            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <!-- Row 1 -->
                <div class="row mb-3">
                    <div class="col-md-3">
                        <label asp-for="SlNo" class="form-label">Sl No</label>
                        <input asp-for="SlNo" class="form-control" />
                    </div>

                    <div class="col-md-3">
                        <label asp-for="UserName" class="form-label">User Name</label>
                        <input asp-for="UserName" class="form-control" />
                    </div>

                    <div class="col-md-3">
                        <label asp-for="Department" class="form-label">Department</label>
                        <input asp-for="Department" class="form-control" />
                    </div>

                    <div class="col-md-3">
                        <label asp-for="Division" class="form-label">Division</label>
                        <input asp-for="Division" class="form-control" />
                    </div>
                </div>

                <!-- Row 2 -->
                <div class="row mb-3">
                    <div class="col-md-4">
                        <label asp-for="AssetLocation" class="form-label">Asset Location</label>
                        <input asp-for="AssetLocation" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="AssetType" class="form-label">Asset Type</label>
                        <input asp-for="AssetType" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Status" class="form-label">Status</label>
                        <input asp-for="Status" class="form-control" />
                    </div>
                </div>

                <!-- Row 3 -->
                <div class="row mb-3">
                    <div class="col-md-4">
                        <label asp-for="Make" class="form-label">Make</label>
                        <input asp-for="Make" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Model" class="form-label">Model</label>
                        <input asp-for="Model" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="SerialNo" class="form-label">Serial No</label>
                        <input asp-for="SerialNo" class="form-control" />
                    </div>
                </div>

                <!-- Row 4 -->
                <div class="row mb-3">
                    <div class="col-md-3">
                        <label asp-for="TelephoneNo" class="form-label">Telephone No</label>
                        <input asp-for="TelephoneNo" class="form-control" />
                    </div>

                    <div class="col-md-3">
                        <label asp-for="ParallelConnection" class="form-label">Parallel Connection</label>
                        <input asp-for="ParallelConnection" class="form-control" />
                    </div>

                    <div class="col-md-3">
                        <label asp-for="ScreenSize" class="form-label">Screen Size</label>
                        <input asp-for="ScreenSize" class="form-control" />
                    </div>

                    <div class="col-md-3">
                        <label asp-for="FrequencyNo" class="form-label">Frequency No</label>
                        <input asp-for="FrequencyNo" class="form-control" />
                    </div>
                </div>

                <!-- Row 5 -->
                <div class="row mb-4">
                    <div class="col-md-6">
                        <label asp-for="LicenseNo" class="form-label">License No</label>
                        <input asp-for="LicenseNo" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Ports" class="form-label">Ports</label>
                        <input asp-for="Ports" class="form-control" />
                    </div>
                </div>

                <!-- ✅ BUTTONS -->
                <div class="d-flex justify-content-end gap-3">
                    <button type="submit" class="btn btn-success px-4">
                        <i class="fas fa-save"></i> Save Asset
                    </button>

                    <a asp-action="Index" class="btn btn-secondary px-4">
                        Cancel
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>

    <style>
        .form-label {
            font-size: 0.9rem;
            margin-bottom: 0.3rem;
        }

        .form-control {
            border-radius: 0.375rem;
            border: 1px solid #ced4da;
            padding: 0.5rem 0.75rem;
            font-size: 0.9rem;
        }

            .form-control:focus {
                border-color: #86b7fe;
                box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
            }

        .card {
            border: none;
            border-radius: 0.5rem;
        }

        .btn-success {
            background-color: #198754;
            border-color: #198754;
        }

            .btn-success:hover {
                background-color: #157347;
                border-color: #146c43;
            }

        .alert-danger {
            border-radius: 0.375rem;
            padding: 0.75rem 1rem;
        }
    </style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}