@model SLRM_IT_Assest_Management.Models.ITAssetDetail

@{
    ViewData["Title"] = "Edit IT Asset";
}

<style>
    .form-label {
        font-size: 0.9rem;
        margin-bottom: 0.3rem;
    }

    .form-control {
        border-radius: 0.375rem;
        border: 1px solid #ced4da;
        padding: 0.5rem 0.75rem;
        font-size: 0.9rem;
    }

        .form-control:focus {
            border-color: #86b7fe;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
        }

    .card {
        border: none;
        border-radius: 0.5rem;
    }

    .btn-success {
        background-color: #198754;
        border-color: #198754;
    }

        .btn-success:hover {
            background-color: #157347;
            border-color: #146c43;
        }

    .alert-danger {
        border-radius: 0.375rem;
        padding: 0.75rem 1rem;
    }
</style>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Edit IT Asset</h2>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left"></i> Back to List
        </a>
    </div>

    <div class="card shadow">
        <div class="card-body">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <input type="hidden" asp-for="ITAssetDetailId" />

                <!-- Row 1: Basic Information -->
                <div class="row mb-3">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label asp-for="SlNo" class="form-label fw-bold">Sl No</label>
                            <input asp-for="SlNo" class="form-control" />
                            <span asp-validation-for="SlNo" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label asp-for="UserName" class="form-label fw-bold">User Name</label>
                            <input asp-for="UserName" class="form-control" />
                            <span asp-validation-for="UserName" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label asp-for="Department" class="form-label fw-bold">Department</label>
                            <input asp-for="Department" class="form-control" />
                            <span asp-validation-for="Department" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label asp-for="Division" class="form-label fw-bold">Division</label>
                            <input asp-for="Division" class="form-control" />
                            <span asp-validation-for="Division" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <!-- Row 2: Asset Details -->
                <div class="row mb-3">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="AssetLocation" class="form-label fw-bold">Asset Location</label>
                            <input asp-for="AssetLocation" class="form-control" />
                            <span asp-validation-for="AssetLocation" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="AssetType" class="form-label fw-bold">Asset Type</label>
                            <input asp-for="AssetType" class="form-control" />
                            <span asp-validation-for="AssetType" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="Status" class="form-label fw-bold">Status</label>
                            <input asp-for="Status" class="form-control" />
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <!-- Row 3: Manufacturer Details -->
                <div class="row mb-3">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="Make" class="form-label fw-bold">Make</label>
                            <input asp-for="Make" class="form-control" />
                            <span asp-validation-for="Make" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="Model" class="form-label fw-bold">Model</label>
                            <input asp-for="Model" class="form-control" />
                            <span asp-validation-for="Model" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="SerialNo" class="form-label fw-bold">Serial No</label>
                            <input asp-for="SerialNo" class="form-control" />
                            <span asp-validation-for="SerialNo" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <!-- Row 4: Contact & Connections -->
                <div class="row mb-3">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label asp-for="TelephoneNo" class="form-label fw-bold">Telephone No</label>
                            <input asp-for="TelephoneNo" class="form-control" />
                            <span asp-validation-for="TelephoneNo" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label asp-for="ParallelConnection" class="form-label fw-bold">Parallel Connection</label>
                            <input asp-for="ParallelConnection" class="form-control" />
                            <span asp-validation-for="ParallelConnection" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label asp-for="ScreenSize" class="form-label fw-bold">Screen Size</label>
                            <input asp-for="ScreenSize" class="form-control" />
                            <span asp-validation-for="ScreenSize" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label asp-for="FrequencyNo" class="form-label fw-bold">Frequency No</label>
                            <input asp-for="FrequencyNo" class="form-control" />
                            <span asp-validation-for="FrequencyNo" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <!-- Row 5: License & Ports -->
                <div class="row mb-4">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="LicenseNo" class="form-label fw-bold">License No</label>
                            <input asp-for="LicenseNo" class="form-control" />
                            <span asp-validation-for="LicenseNo" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="Ports" class="form-label fw-bold">Ports</label>
                            <input asp-for="Ports" class="form-control" />
                            <span asp-validation-for="Ports" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <!-- Submit Button -->
                <div class="form-group text-end">
                    <button type="submit" class="btn btn-success px-4">
                        <i class="fas fa-save"></i> Save Changes
                    </button>
                    <a asp-action="Index" class="btn btn-secondary px-4 ms-2">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}