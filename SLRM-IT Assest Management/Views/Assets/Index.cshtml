@model IEnumerable<SLRM_IT_Assest_Management.Models.Asset>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Assets - SLRM IT-ASSET MANAGEMENT</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding: 20px;
        }

        .page-title {
            font-size: 24px;
            font-weight: 600;
            margin-bottom: 20px;
            color: #2c3e50;
            padding-bottom: 10px;
            border-bottom: 1px solid #dee2e6;
        }

        .action-bar {
            display: flex;
            justify-content: space-between;
            margin-bottom: 20px;
        }

        .table-container {
            margin-top: 20px;
            background: #fff;
            padding: 15px;
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        }

        .table-title {
            font-size: 18px;
            font-weight: 600;
            color: #1f3c88;
        }

        .table-header,
        .table-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .pagination-info {
            font-size: 14px;
            color: #6c757d;
        }

        .action-buttons .btn {
            margin-right: 5px;
        }

        /* === TABLE STYLES === */
        .table {
            table-layout: fixed; /* Prevents shifting widths */
            width: 100%;
            border-collapse: collapse;
            font-size: 14px;
            white-space: normal;
            word-wrap: break-word;
        }

        th, td {
            border: 1px solid #dee2e6;
            vertical-align: middle;
            text-align: center;
            padding: 6px 8px;
        }

        th {
            background-color: #1f3c88;
            color: #fff;
            font-weight: 600;
            font-size: 13px;
            text-transform: uppercase;
        }

            /* === COLUMN WIDTHS === */
            th:nth-child(1), td:nth-child(1) {
                width: 60px;
            }
            /* Sl No */
            th:nth-child(2), td:nth-child(2) {
                width: 140px;
            }
            /* Company */
            th:nth-child(3), td:nth-child(3) {
                width: 120px;
            }
            /* AssetType */
            th:nth-child(4), td:nth-child(4) {
                width: 130px;
            }
            /* Department */
            th:nth-child(5), td:nth-child(5) {
                width: 120px;
            }
            /* UserName */
            th:nth-child(6), td:nth-child(6) {
                width: 100px;
            }
            /* EmpCode */
            th:nth-child(7), td:nth-child(7) {
                width: 120px;
            }
            /* Host Name */
            th:nth-child(8), td:nth-child(8) {
                width: 100px;
            }
            /* Block */
            th:nth-child(9), td:nth-child(9) {
                width: 130px;
            }
            /* AssetLocation */
            th:nth-child(10), td:nth-child(10) {
                width: 130px;
            }
            /* AssetTag */
            th:nth-child(11), td:nth-child(11) {
                width: 120px;
            }
            /* Make */
            th:nth-child(12), td:nth-child(12) {
                width: 120px;
            }
            /* Model */
            th:nth-child(13), td:nth-child(13) {
                width: 120px;
            }
            /* Serial No */
            th:nth-child(14), td:nth-child(14) {
                width: 120px;
            }
            /* Processor */
            th:nth-child(15), td:nth-child(15) {
                width: 80px;
            }
            /* RAM */
            th:nth-child(16), td:nth-child(16) {
                width: 80px;
            }
            /* HDD */
            th:nth-child(17), td:nth-child(17) {
                width: 120px;
            }
            /* Division */
            th:nth-child(18), td:nth-child(18) {
                width: 120px;
            }
            /* Antivirus */
            th:nth-child(19), td:nth-child(19) {
                width: 120px;
            }
            /* Status */
            th:nth-child(20), td:nth-child(20) {
                width: 120px;
            }
            /* OS Version */
            th:nth-child(21), td:nth-child(21) {
                width: 100px;
            }
            /* AutoCAD */
            th:nth-child(22), td:nth-child(22) {
                width: 100px;
            }
            /* Office */
            th:nth-child(23), td:nth-child(23) {
                width: 150px;
            }
            /* Windows Key */
            th:nth-child(24), td:nth-child(24) {
                width: 130px;
            }
            /* IP Address */
            th:nth-child(25), td:nth-child(25) {
                width: 100px;
            }
            /* Nitro */
            th:nth-child(26), td:nth-child(26) {
                width: 100px;
            }
            /* Audit Status */
            th:nth-child(27), td:nth-child(27) {
                width: 130px;
            }
        /* Actions */

        /* === TEXT ALIGNMENT === */
        td:nth-child(1),
        td:nth-child(6),
        td:nth-child(15),
        td:nth-child(16),
        td:nth-child(23),
        td:nth-child(24),
        td:nth-child(27) {
            text-align: center;
        }

        td {
            color: #333;
        }

        /* === RESPONSIVENESS === */
        .table-responsive {
            overflow-x: auto;
        }

        /* === PAGINATION BUTTONS === */
        #pagination button {
            margin: 3px;
            padding: 5px 10px;
            border: none;
            background-color: #e9ecef;
            border-radius: 4px;
            transition: 0.3s;
        }

            #pagination button.active {
                background-color: #007bff;
                color: white;
            }

            #pagination button:hover {
                background-color: #0056b3;
                color: #fff;
            }
    </style>
</head>
<body>
    <div class="container-fluid">
        <h1 class="page-title">SLRM IT-ASSET MANAGEMENT &gt; Assets</h1>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        <!-- Back Button -->
        @{
            await Html.RenderPartialAsync("_BackButton");
        }

        <!-- Filter Toolbar -->
        @await Html.PartialAsync("_FilterToolbar")

        <div class="d-flex justify-content-between align-items-center mb-3">
            <a asp-action="Create" class="btn btn-primary btn-add">
                <i class="fas fa-plus"></i> Add New Asset
            </a>
            <span class="text-muted small">Total: @Model.Count() assets</span>
        </div>
        

        <div class="table-container">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Sl No</th>
                        <th>Company</th>
                        <th>Asset Type</th>
                        <th>Department</th>
                        <th>User Name</th>
                        <th>Emp Code</th>
                        <th>Host Name</th>
                        <th>Block</th>
                        <th>Asset Location</th>
                        <th>Asset Tag</th>
                        <th>Make</th>
                        <th>Model</th>
                        @if (ViewBag.SelectedType == "Desktop")
                        {
                            <th>Monitor Make</th>
                            <th>Monitor Model</th>
                        }
                        <th>Serial No</th>
                        <th>Processor</th>
                        <th>RAM</th>
                        <th>HDD</th>
                        <th>Division</th>
                        <th>Antivirus</th>
                        <th>Status</th>
                        <th>OS Version</th>
                        <th>AutoCAD</th>
                        <th>Office</th>
                        <th>Windows License Key</th>
                        <th>IP Address</th>
                        <th>Nitro</th>
                        <th>Audit Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.SlNo</td>
                            <td>@item.Company?.CompanyName</td>
                            <td>@item.AssetType?.Name</td>
                            <td>@item.Department?.DepartmentName</td>
                            <td>@item.UserName</td>
                            <td>@item.EmpCode</td>
                            <td>@item.HostName</td>
                            <td>@item.Block?.BlockName</td>
                            <td>@item.AssetLocation?.Name</td>
                            <td>@item.AssetTag</td>
                            <td>@item.Make</td>
                            <td>@item.Model</td>
                            @if (ViewBag.SelectedType == "Desktop")
                            {
                                <td>@item.MoniterMake</td>
                                <td>@item.MoniterModel</td>
                            }
                            <td>@(string.IsNullOrEmpty(item.SerialNo) ? "NA" : item.SerialNo)</td>
                            <td>@item.Processor</td>
                            <td>@item.Ram</td>
                            <td>@item.Hdd</td>
                            <td>@item.Division?.DivisionName</td>
                            <td>@item.AntiVirus</td>
                            <td>@item.AssetStatus?.Name</td>
                            <td>@item.OSVersion</td>
                            <td>@item.AutoCad</td>
                            <td>@item.Office</td>
                            <td>@item.WindowLicenseKey</td>
                            <td>@item.IPAddress</td>
                            <td>@item.Nitro</td>
                            <td>@item.AuditStatus</td>
                            <td class="text-center">
                                <div class="action-buttons">
                                    <a asp-action="Edit" asp-route-id="@item.AssetId" class="btn btn-warning btn-sm">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.AssetId" class="btn btn-danger btn-sm">
                                        <i class="fas fa-trash-alt"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
