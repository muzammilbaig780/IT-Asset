@model IEnumerable<SLRM_IT_Assest_Management.Models.Asset>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Assets - SLRM IT-ASSET MANAGEMENT</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        body {
            background-color: #f4f6f9; /* Softer background */
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding: 20px;
        }

        .page-title {
            font-size: 24px;
            font-weight: 600;
            margin-bottom: 20px;
            color: #1f3c88;
            padding-bottom: 10px;
            border-bottom: 2px solid #e3e6ef;
            letter-spacing: 0.5px;
        }

        .action-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            background: #ffffff;
            padding: 10px 15px;
            border-radius: 10px;
            border: 1px solid #e0e4eb;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
        }

        .table-container {
            margin-top: 20px;
            background: #ffffff;
            padding: 15px;
            border-radius: 12px;
            border: 1px solid #e0e4eb;
            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.06);
        }

        .table-title {
            font-size: 18px;
            font-weight: 600;
            color: #1f3c88;
            margin-bottom: 10px;
        }

        .table-header,
        .table-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .pagination-info {
            font-size: 14px;
            color: #6c757d;
        }

        .action-buttons .btn {
            margin-right: 5px;
        }

        /* === TABLE STYLES === */
        .table {
            table-layout: fixed;
            width: 100%;
            border-collapse: collapse;
            font-size: 14px;
            background-color: #fbfcfd;
            white-space: normal;
            word-wrap: break-word;
            border-radius: 8px;
            overflow: hidden;
        }

            .table th,
            .table td {
                border: 0.5px solid #dee2e6 !important;
                padding: 8px;
                text-align: center;
                vertical-align: middle;
                color: #333;
            }

                .table th + th,
                .table td + td {
                    border-left: 0.5px solid #dee2e6 !important;
                }

        th {
            background-color: #2a4d8c;
            color: #ffffff;
            font-weight: 600;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        /* === Alternate Row Color + Hover === */
        .table tr:nth-child(even) td {
            background-color: #f8faff;
        }

        .table tr:hover td {
            background-color: #eaf1fb;
            transition: background 0.3s ease;
        }

        /* === COLUMN WIDTHS === */
        th:nth-child(1), td:nth-child(1) {
            width: 60px;
        }

        th:nth-child(2), td:nth-child(2) {
            width: 140px;
        }

        th:nth-child(3), td:nth-child(3) {
            width: 120px;
        }

        th:nth-child(4), td:nth-child(4) {
            width: 130px;
        }

        th:nth-child(5), td:nth-child(5) {
            width: 120px;
        }

        th:nth-child(6), td:nth-child(6) {
            width: 100px;
        }

        th:nth-child(7), td:nth-child(7) {
            width: 120px;
        }

        th:nth-child(8), td:nth-child(8) {
            width: 100px;
        }

        th:nth-child(9), td:nth-child(9) {
            width: 130px;
        }

        th:nth-child(10), td:nth-child(10) {
            width: 130px;
        }

        th:nth-child(11), td:nth-child(11) {
            width: 120px;
        }

        th:nth-child(12), td:nth-child(12) {
            width: 120px;
        }

        th:nth-child(13), td:nth-child(13) {
            width: 120px;
        }

        th:nth-child(14), td:nth-child(14) {
            width: 120px;
        }

        th:nth-child(15), td:nth-child(15) {
            width: 80px;
        }

        th:nth-child(16), td:nth-child(16) {
            width: 80px;
        }

        th:nth-child(17), td:nth-child(17) {
            width: 120px;
        }

        th:nth-child(18), td:nth-child(18) {
            width: 120px;
        }

        th:nth-child(19), td:nth-child(19) {
            width: 120px;
        }

        th:nth-child(20), td:nth-child(20) {
            width: 120px;
        }

        th:nth-child(21), td:nth-child(21) {
            width: 100px;
        }

        th:nth-child(22), td:nth-child(22) {
            width: 100px;
        }

        th:nth-child(23), td:nth-child(23) {
            width: 150px;
        }

        th:nth-child(24), td:nth-child(24) {
            width: 130px;
        }

        th:nth-child(25), td:nth-child(25) {
            width: 100px;
        }

        th:nth-child(26), td:nth-child(26) {
            width: 100px;
        }

        th:nth-child(27), td:nth-child(27) {
            width: 130px;
        }

        /* === TEXT ALIGNMENT === */
        td:nth-child(1),
        td:nth-child(6),
        td:nth-child(15),
        td:nth-child(16),
        td:nth-child(23),
        td:nth-child(24),
        td:nth-child(27) {
            text-align: center;
        }

        /* === RESPONSIVENESS === */
        .table-responsive {
            overflow-x: auto;
        }

        media (max-width: 992px) {
            th, td

        {
            font-size: 12px;
            padding: 6px;
        }

        }
        

        media (max-width: 768px) {
            .action-bar

        {
            flex-direction: column;
            align-items: flex-start;
            gap: 10px;
        }

        }

        /* === PAGINATION BUTTONS === */
        #pagination button {
            margin: 3px;
            padding: 6px 10px;
            border: none;
            background-color: #e9ecef;
            border-radius: 4px;
            transition: 0.3s;
            cursor: pointer;
        }

            #pagination button.active {
                background-color: #1f3c88;
                color: white;
            }

            #pagination button:hover {
                background-color: #3459b1;
                color: #fff;
            }
    </style>

</head>
<body>
    <div class="container-fluid">
        <h1 class="page-title">SLRM IT-ASSET MANAGEMENT &gt; Assets</h1>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        <!-- Back Button -->
        @{
            await Html.RenderPartialAsync("_BackButton");
        }

        <!-- Filter Toolbar -->
        @await Html.PartialAsync("_FilterToolbar")

        <div class="d-flex justify-content-between align-items-center mb-3">
            <a asp-action="Create" class="btn btn-primary btn-add">
                <i class="fas fa-plus"></i> Add New Asset
            </a>
            <span class="text-muted small">Total: @Model.Count() assets</span>
        </div>
        

        <div class="table-container">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Sl No</th>
                        <th>Company</th>
                        <th>Asset Type</th>
                        <th>Department</th>
                        <th>Emp Code</th>
                        <th>User Name</th>
                        <th>Host Name</th>
                        <th>Block</th>
                        <th>Asset Location</th>
                        <th>Asset Tag</th>
                        <th>Make</th>
                        <th>Model</th>
                        @if (ViewBag.SelectedType == "Desktop")
                        {
                            <th>Monitor Make</th>
                            <th>Monitor Model</th>
                        }
                        <th>Serial No</th>
                        <th>Processor</th>
                        <th>RAM</th>
                        <th>HDD</th>
                        <th>Division</th>
                        <th>Antivirus</th>
                        <th>Status</th>
                        <th>OS Version</th>
                        <th>AutoCAD</th>
                        <th>Office</th>
                        <th>Windows License Key</th>
                        <th>IP Address</th>
                        <th>Nitro</th>
                        <th>Audit Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.SlNo</td>
                            <td>@item.Company?.CompanyName</td>
                            <td>@item.AssetType?.Name</td>
                            <td>@item.Department?.DepartmentName</td>
                            <td>@item.EmpCode</td>
                            <td>@item.UserName</td>
                            <td>@item.HostName</td>
                            <td>@item.Block?.BlockName</td>
                            <td>@item.AssetLocation?.Name</td>
                            <td>@item.AssetTag</td>
                            <td>@item.Make</td>
                            <td>@item.Model</td>
                            @if (ViewBag.SelectedType == "Desktop")
                            {
                                <td>@item.MoniterMake</td>
                                <td>@item.MoniterModel</td>
                            }
                            <td>@(string.IsNullOrEmpty(item.SerialNo) ? "NA" : item.SerialNo)</td>
                            <td>@item.Processor</td>
                            <td>@item.Ram</td>
                            <td>@item.Hdd</td>
                            <td>@item.Division?.DivisionName</td>
                            <td>@item.AntiVirus</td>
                            <td>@item.AssetStatus?.Name</td>
                            <td>@item.OSVersion</td>
                            <td>@item.AutoCad</td>
                            <td>@item.Office</td>
                            <td>@item.WindowLicenseKey</td>
                            <td>@item.IPAddress</td>
                            <td>@item.Nitro</td>
                            <td>@item.AuditStatus</td>
                            <td class="text-center">
                                <div class="action-buttons">
                                    <a asp-action="Edit" asp-route-id="@item.AssetId" class="btn btn-warning btn-sm">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.AssetId" class="btn btn-danger btn-sm">
                                        <i class="fas fa-trash-alt"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
