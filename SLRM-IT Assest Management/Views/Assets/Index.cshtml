@model IEnumerable<SLRM_IT_Assest_Management.Models.Asset>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Assets - SLRM IT-ASSET MANAGEMENT</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        body {
            background-color: #f4f6f9;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding: 20px;
        }

        .page-title {
            font-size: 24px;
            font-weight: 600;
            margin-bottom: 20px;
            color: #1f3c88;
            padding-bottom: 10px;
            border-bottom: 2px solid #e3e6ef;
            letter-spacing: 0.5px;
        }

        .action-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            background: #ffffff;
            padding: 10px 15px;
            border-radius: 10px;
            border: 1px solid #e0e4eb;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
        }

        .table-container {
            overflow-x: auto;
            margin-top: 20px;
            background: #ffffff;
            padding: 15px;
            border-radius: 12px;
            border: 1px solid #e0e4eb;
            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.06);
        }

        .table-title {
            font-size: 18px;
            font-weight: 600;
            color: #1f3c88;
            margin-bottom: 10px;
        }

        .table-responsive {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }

        /* === TABLE STYLES === */
        .table {
            table-layout: auto; /* ✅ Let browser auto-fit columns */
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
            background-color: #fbfcfd;
            border-radius: 8px;
            overflow: hidden;
        }

            .table th,
            .table td {
                border: 0.5px solid #dee2e6 !important;
                padding: 6px 10px; /* ✅ tighter spacing */
                text-align: center;
                vertical-align: middle;
                color: #333;
                white-space: nowrap; /* ✅ prevents wrapping */
            }

        th {
            background-color: #2a4d8c;
            color: #ffffff;
            font-weight: 600;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            position: sticky;
            top: 0; /* ✅ Keep header visible while scrolling */
            z-index: 2;
        }

        /* Alternate Row + Hover */
        .table tr:nth-child(even) td {
            background-color: #f8faff;
        }

        .table tr:hover td {
            background-color: #eaf1fb;
            transition: background 0.3s ease;
        }

        /* Make long text wrap in certain columns */
        td:nth-child(15),
        td:nth-child(16),
        td:nth-child(17) {
            white-space: normal;
            word-wrap: break-word;
        }

        /* Action buttons */
        .action-buttons .btn {
            margin-right: 5px;
        }

        /* Responsive tweaks */
        media (max-width: 992px) {
            th, td

        {
            font-size: 12px;
            padding: 6px;
        }

        }

        media (max-width: 768px) {
            .action-bar

        {
            flex-direction: column;
            align-items: flex-start;
            gap: 10px;
        }

        }

        /* Pagination (if any) */
        #pagination button {
            margin: 3px;
            padding: 6px 10px;
            border: none;
            background-color: #e9ecef;
            border-radius: 4px;
            transition: 0.3s;
            cursor: pointer;
        }

            #pagination button.active {
                background-color: #1f3c88;
                color: white;
            }

            #pagination button:hover {
                background-color: #3459b1;
                color: #fff;
            }
    </style>
</head>

<body>
    <div class="container-fluid">
        <h1 class="page-title">SLRM IT-ASSET MANAGEMENT &gt; Assets</h1>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Back Button -->
        @{
            await Html.RenderPartialAsync("_BackButton");
        }

        <!-- Filter Toolbar -->
        @await Html.PartialAsync("_FilterToolbar")

        <div class="d-flex justify-content-between align-items-center mb-3">
            <a asp-action="Create" class="btn btn-primary btn-add">
                <i class="fas fa-plus"></i> Add New Asset
            </a>
            <span class="text-muted small">Total: @Model.Count() assets</span>
        </div>

        <div class="table-container">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Sl No</th>
                            <th>Company</th>
                            <th>Asset Type</th>
                            <th>Department</th>
                            <th>Emp Code</th>
                            <th>User Name</th>
                            <th>Host Name</th>
                            <th>Block</th>
                            <th>Asset Location</th>
                            <th>Asset Tag</th>
                            <th>Make</th>
                            <th>Model</th>
                            @if (ViewBag.SelectedType == "Desktop")
                            {
                                <th>Monitor Make</th>
                                <th>Monitor Model</th>
                            }
                            <th>Serial No</th>
                            <th>Processor</th>
                            <th>RAM</th>
                            <th>HDD</th>
                            <th>Division</th>
                            <th>Antivirus</th>
                            <th>Status</th>
                            <th>OS Version</th>
                            <th>AutoCAD</th>
                            <th>Office</th>
                            <th>Windows License Key</th>
                            <th>IP Address</th>
                            <th>Nitro</th>
                            <th>Audit Status</th>
                            <th>GRN Number</th>
                            <th>GRN Date</th>
                            <th>Invoice Date</th>
                            <th>Warranty</th>
                            <th>ExpiryDate</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.SlNo</td>
                                <td>@item.Company?.CompanyName</td>
                                <td>@item.AssetType?.Name</td>
                                <td>@item.Department?.DepartmentName</td>
                                <td>@item.EmpCode</td>
                                <td>@item.UserName</td>
                                <td>@item.HostName</td>
                                <td>@item.Block?.BlockName</td>
                                <td>@item.AssetLocation?.Name</td>
                                <td>@item.AssetTag</td>
                                <td>@item.Make</td>
                                <td>@item.Model</td>
                                @if (ViewBag.SelectedType == "Desktop")
                                {
                                    <td>@item.MoniterMake</td>
                                    <td>@item.MoniterModel</td>
                                }
                                <td>@(string.IsNullOrEmpty(item.SerialNo) ? "NA" : item.SerialNo)</td>
                                <td>@item.Processor</td>
                                <td>@item.Ram</td>
                                <td>@item.Hdd</td>
                                <td>@item.Division?.DivisionName</td>
                                <td>@item.AntiVirus</td>
                                <td>@item.AssetStatus?.Name</td>
                                <td>@item.OSVersion</td>
                                <td>@item.AutoCad</td>
                                <td>@item.Office</td>
                                <td>@item.WindowLicenseKey</td>
                                <td>@item.IPAddress</td>
                                <td>@item.Nitro</td>
                                <td>@item.AuditStatus</td>
                                <td>@(string.IsNullOrEmpty(item.GRNNumber) ? "NA" : item.GRNNumber)</td>
                                <td>@(item.GRNDate.HasValue? item.GRNDate.Value.ToString("dd/MM/yyyy") : "NA")</td>
                                <td>@(item.InvoiceDate.HasValue? item.InvoiceDate.Value.ToString("dd/MM/yyyy") : "NA")</td>
                                <td>@(item.Warranty.HasValue ? $"{item.Warranty} Months" : "NA")</td>
<td>
    @if (item.ExpiryDate.HasValue)
    {
        var daysLeft = (item.ExpiryDate.Value.ToDateTime(TimeOnly.MinValue) - DateTime.Today).Days;
        string status;
        string color;

        if (daysLeft <= 0)
        {
            status = "❌ Expired";
            color = "text-danger";
        }
        else if (daysLeft <= 30)
        {
            status = "⚠️ Expiring Soon";
            color = "text-warning";
        }
        else
        {
            status = "✅ Active";
            color = "text-success";
        }

        <span>@item.ExpiryDate.Value.ToString("dd/MM/yyyy")</span><br />
        <small class="@color fw-semibold">@status</small><br />
        <small>(@daysLeft days left)</small>
    }
    else
    {
        <span>NA</span>
    }
</td>


                                <td class="text-center">
                                    <div class="action-buttons">
                                        <a asp-action="Edit" asp-route-id="@item.AssetId" class="btn btn-warning btn-sm">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.AssetId" class="btn btn-danger btn-sm">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
