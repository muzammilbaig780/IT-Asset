@model IEnumerable<SLRM_IT_Assest_Management.Models.AssetTransferLog>
@{
    var asset = ViewBag.Asset as SLRM_IT_Assest_Management.Models.Asset;
}

<!DOCTYPE html>
<html>
<head>
    <title>Asset Lifecycle</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        .timeline {
            position: relative;
            padding-left: 40px;
        }

            .timeline::before {
                content: '';
                position: absolute;
                left: 18px;
                top: 0;
                bottom: 0;
                width: 3px;
                background: #0d6efd;
            }

        .timeline-item {
            position: relative;
            margin-bottom: 30px;
        }

            .timeline-item::before {
                content: '';
                position: absolute;
                left: -31px;
                top: 5px;
                width: 16px;
                height: 16px;
                border-radius: 50%;
                background: #0d6efd;
            }

        .timeline-card {
            background: #fff;
            border-radius: 8px;
            padding: 15px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }
    </style>
</head>

<body class="bg-light">

    <div class="container mt-4">

        <!-- ✅ Asset Info Card -->
        <div class="card shadow mb-4">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">
                    <i class="fas fa-box me-2"></i>
                    Asset Lifecycle – @asset?.AssetTag
                </h5>
            </div>

            <div class="card-body row">
@*                 <div class="col-md-4"><b>Asset Name:</b> @asset?.AssetName</div>
 *@                <div class="col-md-4"><b>Asset Type:</b> @asset?.AssetType?.Name</div>
                <div class="col-md-4"><b>Current User:</b> @asset?.UserName</div>

                <div class="col-md-4 mt-2"><b>Department:</b> @asset?.Department?.DepartmentName</div>
                <div class="col-md-4 mt-2"><b>Status:</b> @asset?.AssetStatus?.Name</div>
@*                 <div class="col-md-4 mt-2"><b>Created Date:</b> @asset?.CreatedDate?.ToString("dd-MM-yyyy")</div>
 *@            </div>
        </div>

        <!-- ✅ Lifecycle Timeline -->
        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">
                    <i class="fas fa-route me-2"></i>Transfer Lifecycle
                </h5>
            </div>

            <div class="card-body">

                @if (!Model.Any())
                {
                    <div class="alert alert-info text-center">
                        No lifecycle history found.
                    </div>
                }
                else
                {
                    <div class="timeline">

                        @foreach (var item in Model)
                        {
                            <div class="timeline-item">
                                <div class="timeline-card">

                                    <div class="d-flex justify-content-between">
                                        <h6 class="text-primary mb-1">
                                            <i class="fas fa-calendar-alt"></i>
                                            @item.TransferDate.ToString("dd MMM yyyy HH:mm")
                                        </h6>
                                        <span class="badge bg-info">@item.TransferredBy</span>
                                    </div>

                                    <hr class="my-2" />

                                    <p class="mb-1">
                                        <b>From:</b>
                                        @item.FromUserName (@item.FromEmpCode) -
                                        @item.FromDepartment?.DepartmentName
                                    </p>

                                    <p class="mb-1">
                                        <b>To:</b>
                                        @item.ToUserName (@item.ToEmpCode) -
                                        @item.ToDepartment?.DepartmentName
                                    </p>

                                    <p class="mb-1">
                                        <b>Reason:</b> @item.TransferReason
                                    </p>

                                    <p class="mb-0">
                                        <b>Remarks:</b> @item.Remarks
                                    </p>

                                </div>
                            </div>
                        }

                    </div>
                }

                <div class="text-end mt-3">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i>Back
                    </a>
                </div>

            </div>
        </div>

    </div>

</body>
</html>
