@model IEnumerable<SLRM_IT_Assest_Management.Models.AssetTransferLog>

@{
    var asset = ViewBag.Asset as SLRM_IT_Assest_Management.Models.Asset;
    string error = ViewBag.Error as string;
}

<!DOCTYPE html>
<html>
<head>
    <title>Asset Lifecycle</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        .timeline {
            position: relative;
            padding-left: 40px;
        }

            .timeline::before {
                content: '';
                position: absolute;
                left: 18px;
                top: 0;
                bottom: 0;
                width: 3px;
                background: #0d6efd;
            }

        .timeline-item {
            position: relative;
            margin-bottom: 30px;
        }

            .timeline-item::before {
                content: '';
                position: absolute;
                left: -31px;
                top: 5px;
                width: 16px;
                height: 16px;
                border-radius: 50%;
                background: #0d6efd;
            }

        .timeline-card {
            background: #fff;
            border-radius: 8px;
            padding: 15px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }
    </style>
</head>

<body class="bg-light">

    <div class="container mt-4">

        <!-- 🔍 AssetTag Search -->
        <div class="card shadow mb-3">
            <div class="card-body">
                <form method="get" asp-action="TransferHistory" class="row g-2">
                    <div class="col-md-4">
                        <input type="text"
                               name="assetTag"
                               value="@Context.Request.Query["assetTag"]"
                               class="form-control"
                               placeholder="Enter Asset Tag" />
                    </div>

                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="fas fa-search"></i> Search
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- ❌ Error -->
        @if (!string.IsNullOrEmpty(error))
        {
            <div class="alert alert-danger text-center">@error</div>
        }

        <!-- ✅ Asset Info -->
        @if (asset != null)
        {
            <div class="card shadow mb-4">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-box me-2"></i>
                        Asset Lifecycle – @asset.AssetTag
                    </h5>
                </div>

                <div class="card-body row">
                    <div class="col-md-4"><b>Asset Type:</b> @asset.AssetType?.Name</div>
                    <div class="col-md-4"><b>Current User:</b> @asset.UserName</div>
                    <div class="col-md-4"><b>Status:</b> @asset.AssetStatus?.Name</div>
                    <div class="col-md-4 mt-2"><b>Department:</b> @asset.Department?.DepartmentName</div>
                </div>
            </div>
        }

        <!-- 🔁 Transfer Lifecycle -->
        @if (Model.Any())
        {
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-route me-2"></i> Transfer Lifecycle
                    </h5>
                </div>

                <div class="card-body">
                    <div class="timeline">
                        @foreach (var item in Model)
                        {
                            <div class="timeline-item">
                                <div class="row">

                                    <div class="col-md-6">
                                        <div class="border rounded p-3 bg-light">

                                            <h6 class="text-danger">
                                                <i class="fas fa-arrow-circle-left"></i> From
                                            </h6>

                                            <p><b>User:</b> @(item.FromUserName ?? "NA")</p>

                                            <p><b>Emp Code:</b> @(item.FromEmpCode ?? "NA")</p>

                                            <p>
                                                <b>Department:</b>
                                                @(item.FromDepartment?.DepartmentName ?? "NA")
                                            </p>

                                            <p>
                                                <b>Location:</b>
                                                @(item.FromLocation?.Name ?? "NA")
                                            </p>

                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="border rounded p-3 bg-light">

                                            <h6 class="text-success">
                                                <i class="fas fa-arrow-circle-right"></i> To
                                            </h6>

                                            <p><b>User:</b> @(item.ToUserName ?? "NA")</p>

                                            <p><b>Emp Code:</b> @(item.ToEmpCode ?? "NA")</p>

                                            <p>
                                                <b>Department:</b>
                                                @(item.ToDepartment?.DepartmentName ?? "NA")
                                            </p>

                                            <p>
                                                <b>Location:</b>
                                                @(item.ToLocation?.Name ?? "NA")
                                            </p>

                                        </div>
                                    </div>

                                </div>

                                <hr />

                                <div class="row mt-2">

                                    <div class="col-md-4">
                                        <b>Transferred By:</b>
                                        @item.TransferredBy
                                    </div>

                                    <div class="col-md-4">
                                        <b>Reason:</b>
                                        @(item.TransferReason ?? "NA")
                                    </div>

                                    <div class="col-md-4">
                                        <b>Remarks:</b>
                                        @(item.Remarks ?? "NA")
                                    </div>

                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
        else if (asset != null)
        {
            <div class="alert alert-info text-center">
                No transfer history found for this asset.
            </div>
        }

    </div>

</body>
</html>
