@{
    ViewData["Title"] = "Dashboard - IT Asset Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .logo-img {
        height: 36px;
        width: auto;
    }

    /* Dashboard Cards */
    .dashboard-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .stat-card {
        background: var(--bg-white);
        border-radius: var(--radius-lg);
        padding: 1.5rem;
        box-shadow: var(--shadow-sm);
        transition: all 0.3s ease;
        border: 1px solid var(--border);
        position: relative;
        overflow: hidden;
    }

        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: var-shadow-xl;
            border-color: var(--accent);
        }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, var(--accent), var(--accent-light));
            opacity: 0;
            transition: opacity 0.3s;
        }

        .stat-card:hover::before {
            opacity: 1;
        }

    .stat-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 1rem;
    }

    .stat-title {
        font-size: 0.9rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--text-muted);
    }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: var(--radius-md);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: white;
    }

        .stat-icon.assets {
            background: linear-gradient(135deg, #3b82f6, #2563eb);
        }

        .stat-icon.licenses {
            background: linear-gradient(135deg, #10b981, #059669);
        }

        .stat-icon.accessories {
            background: linear-gradient(135deg, #f59e0b, #d97706);
        }

        .stat-icon.consumables {
            background: linear-gradient(135deg, #ef4444, #dc2626);
        }

        .stat-icon.printers {
            background: linear-gradient(135deg, #6366f1, #4f46e5);
        }

        .stat-icon.components {
            background: linear-gradient(135deg, #8b5cf6, #7c3aed);
        }

    .stat-value {
        font-size: 2rem;
        font-weight: 700;
        color: var(--text);
        line-height: 1.2;
        margin-bottom: 0.25rem;
    }

    .stat-label {
        font-size: 0.9rem;
        color: var(--text-muted);
        margin-bottom: 1rem;
    }

    .mini-table {
        background: var(--bg-light);
        border-radius: var(--radius-md);
        overflow: hidden;
        margin-top: 1rem;
        border: 1px solid var(--border);
    }

        .mini-table table {
            width: 100%;
            border-collapse: collapse;
        }

        .mini-table th {
            background: rgba(0, 0, 0, 0.02);
            font-size: 0.8rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--text-muted);
            padding: 0.6rem 1rem;
            text-align: left;
            border-bottom: 1px solid var(--border);
        }

        .mini-table td {
            padding: 0.5rem 1rem;
            font-size: 0.9rem;
            border-bottom: 1px solid var(--border);
        }

        .mini-table tr:last-child td {
            border-bottom: none;
        }

        .mini-table td:last-child {
            font-weight: 600;
            color: var(--accent);
        }

    /* Charts Section */
    .charts-section {
        display: grid;
        grid-template-columns: 1fr 1.5fr;
        gap: 1.5rem;
        margin-top: 2rem;
    }

    .chart-card {
        background: var(--bg-white);
        border-radius: var(--radius-lg);
        padding: 1.5rem;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--border);
    }

    .chart-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .chart-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--text);
        margin: 0;
    }

    .chart-actions {
        display: flex;
        gap: 0.5rem;
    }

    .chart-action-btn {
        padding: 0.4rem 1rem;
        font-size: 0.85rem;
        border-radius: 40px;
        border: 1px solid var(--border);
        background: var(--bg-white);
        color: var(--text);
        cursor: pointer;
        transition: all 0.2s;
        font-weight: 500;
    }

        .chart-action-btn:hover {
            background: var(--bg-light);
            border-color: var(--accent);
            color: var(--accent);
        }

        .chart-action-btn.active {
            background: var(--accent);
            border-color: var(--accent);
            color: white;
        }

    .chart-container {
        position: relative;
        height: 300px;
        width: 100%;
    }

    /* Activity Section (if needed) */
    .activity-section {
        margin-top: 2rem;
        background: var(--bg-white);
        border-radius: var(--radius-lg);
        padding: 1.5rem;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--border);
    }

    .activity-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .activity-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--text);
    }

    .view-all-link {
        color: var(--accent);
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

        .view-all-link:hover {
            text-decoration: underline;
        }

    /* Responsive */
    @@media (max-width: 1024px) {
        .charts-section {
            grid-template-columns: 1fr;
        }
    }

    /* Responsive dashboard cards */
    .dashboard-cards {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 12px;
        margin-bottom: 24px;
    }

    @@media (max-width: 1200px) {
        .dashboard-cards

    {
        grid-template-columns: repeat(3, 1fr);
    }

    }

    @@media (max-width: 768px) {
        .dashboard-cards

    {
        grid-template-columns: repeat(2, 1fr);
    }

    }

    @@media (max-width: 480px) {
        .dashboard-cards

    {
        grid-template-columns: 1fr;
    }


        .logo-wrapper {
            display: flex;
            align-items: center;
        }
    
</style>

