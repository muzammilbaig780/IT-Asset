<div class="content" style="width: 100%; padding: 20px;">
    <div class="header">
        <h2>Dashboard</h2>
       @*  <div class="user-info">
            <img src="https://ui-avatars.com/api/?name=Basavangj&background=3498db&color=fff" alt="User">
            <div>
                <div style="font-weight: 500;">Basavangj</div>
                <div style="font-size: 12px; color: var(--text-light);">Admin</div>
            </div>
        </div> *@
    </div>

    <!-- Dashboard Cards -->
    <div class="dashboard-cards">
        <a asp-controller="Assets" asp-action="Index" style="text-decoration: none; color: inherit;">
            <div class="card">
                <div class="card-header">
                    <div class="card-title">Assets</div>
                    <div class="card-icon assets">
                        <i class="fas fa-server"></i>
                    </div>
                </div>
                <div class="card-value">@Model.AssetCount</div>
                <div class="card-text">Total IT Assets</div>

                <!-- 👇 Added grid for Laptops & Desktops -->
                <div class="table-responsive mt-3">
                    <table class="table table-sm table-bordered text-center mb-0" style="font-size: 13px;">
                        <thead class="table-light">
                            <tr>
                                <th>Device</th>
                                <th>Count</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Laptops</td>
                                <td>@Model.LaptopCount</td>
                            </tr>
                            <tr>
                                <td>Desktops</td>
                                <td>@Model.DesktopCount</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </a>

        <a asp-controller="Licenses" asp-action="Index" style="text-decoration: none; color: inherit;">
            <div class="card">
                <div class="card-header">
                    <div class="card-title">Licenses</div>
                    <div class="card-icon licenses">
                        <i class="fas fa-certificate"></i>
                    </div>
                </div>
                <div class="card-value">@Model.LicenseCount</div>
                <div class="card-text">Total IT Licenses</div>

                <!-- 👇 Dummy grid to match Asset card height -->
                <div class="table-responsive mt-3">
                    <table class="table table-sm table-bordered text-center mb-0" style="font-size: 13px; visibility: hidden;">
                        <thead class="table-light">
                            <tr>
                                <th>Placeholder</th>
                                <th>Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td>-</td><td>-</td></tr>
                            <tr><td>-</td><td>-</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </a>


        <div class="card">
            <div class="card-header">
                <div class="card-title">Accessories</div>
                <div class="card-icon accessories">
                    <i class="fas fa-keyboard"></i>
                </div>
            </div>
            <div class="card-value"></div>
            <div class="card-text">Peripheral Devices</div>
        </div>

        <div class="card">
            <div class="card-header">
                <div class="card-title">Consumables</div>
                <div class="card-icon consumables">
                    <i class="fas fa-tint"></i>
                </div>
            </div>
            <div class="card-value"></div>
            <div class="card-text">Items in Stock</div>
        </div>

        <div class="card">
            <div class="card-header">
                <div class="card-title">Components</div>
                <div class="card-icon components">
                    <i class="fas fa-microchip"></i>
                </div>
            </div>
            <div class="card-value"></div>
            <div class="card-text">Items in Stock</div>
        </div>
    </div>

    <!-- Buttons + Chart Layout -->
    <div style="display: flex; gap: 40px; flex-wrap: wrap; margin-top: 20px; align-items: flex-start;">

        <!-- Pie Chart (Asset Status) -->
        <div style="flex: 1 1 400px; max-width: 400px;">
            <div style="display: flex; justify-content: center; gap: 10px; margin-bottom: 10px;">
                <button id="btnLaptop" class="btn btn-primary btn-sm">Laptop</button>
                <button id="btnDesktop" class="btn btn-secondary btn-sm">Desktop</button>
            </div>
            <h4 style="text-align: center;">Assets</h4>
            <canvas id="assetPieChart" width="400" height="300"></canvas>
        </div>

        <!-- Bar Chart (Deployment Status) -->
        <div style="flex: 1 1 600px; max-width: 600px;">
            <h4 style="text-align: center;">Deployment Status</h4>
            <canvas id="deploymentBarChart" width="600" height="352"></canvas>
        </div>
    </div>


    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0"></script>
    <script>
                       document.addEventListener("DOMContentLoaded", function () {

            // ✅ Injected counts from your ViewModel
            var laptopData = {
                active: @Model.LaptopActive,
                notActive: @Model.LaptopNotActive,
                scrap: @Model.LaptopScrap,
                na: @Model.LaptopNA
            };

            var desktopData = {
                active: @Model.DesktopActive,
                notActive: @Model.DesktopNotActive,
                scrap: @Model.DesktopScrap,
                na: @Model.DesktopNA
            };

            let pieChart;

            // ✅ Function to render pie chart
            function loadPieChart(data) {
                const ctx = document.getElementById('assetPieChart').getContext('2d');
                if (pieChart) pieChart.destroy();

                const labels = ['Active', 'Not Active', 'Scrap', 'NA'];
                const values = [data.active, data.notActive, data.scrap, data.na];
                const total = values.reduce((a, b) => a + b, 0);

                pieChart = new Chart(ctx, {
                    type: 'pie',
                    data: {
                        labels: labels,
                        datasets: [{
                            data: values,
                            backgroundColor: ['#28a745', '#dc3545', '#6c757d', '#007bff']
                        }]
                    },
                    options: {
                        plugins: {
                            legend: {
                                position: 'bottom'
                            },
                            tooltip: {
                                callbacks: {
                                    label: function (tooltipItem) {
                                        const dataset = tooltipItem.chart.data.datasets[tooltipItem.datasetIndex];
                                        const total = dataset.data.reduce((a, b) => a + b, 0);
                                        const value = dataset.data[tooltipItem.dataIndex];
                                        const percent = ((value / total) * 100).toFixed(1);
                                        return `${tooltipItem.label}: ${value} (${percent}%)`;
                                    }
                                }
                            },
                            datalabels: {
                                color: '#fff',
                                font: {
                                    weight: 'bold',
                                    size: 13
                                },
                                formatter: function (value, context) {
                                    const label = context.chart.data.labels[context.dataIndex];
                                    if (value > 0) {
                                        return `${label}\n${value}`; // show both text + count
                                    }
                                    return '';
                                }
                            }
                        }
                    },
                    plugins: [ChartDataLabels]
                });
            }

            // ✅ Default: Laptop chart on load
            loadPieChart(laptopData);

            // ✅ Toggle Buttons
            document.getElementById("btnLaptop").addEventListener("click", function () {
                this.classList.add('btn-primary');
                this.classList.remove('btn-secondary');
                document.getElementById("btnDesktop").classList.remove('btn-primary');
                document.getElementById("btnDesktop").classList.add('btn-secondary');
                loadPieChart(laptopData);
            });

            document.getElementById("btnDesktop").addEventListener("click", function () {
                this.classList.add('btn-primary');
                this.classList.remove('btn-secondary');
                document.getElementById("btnLaptop").classList.remove('btn-primary');
                document.getElementById("btnLaptop").classList.add('btn-secondary');
                loadPieChart(desktopData);
            });

        });
               // Bar Chart
        const ctxBar = document.getElementById('deploymentBarChart').getContext('2d');
        const deploymentBarChart = new Chart(ctxBar, {
            type: 'bar',
            data: {
                labels: [ 'Active', 'Not Active', 'Scrap' , 'NA'],
                datasets: [{
                    data: [@Model.ActiveCount, @Model.NotActiveCount, @Model.ScrapCount,@Model.NACount],
                    backgroundColor: [ '#3498db', '#e74c3c', '#95a5a6','#24aaff'],
                    barPercentage: 0.5 // Add this line to reduce bar width
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: {
                    y: {
                        beginAtZero: true,
                        stepSize: 1
                    }
                }
            }
        });
    </script>

