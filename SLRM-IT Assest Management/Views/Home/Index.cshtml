<div class="content" style="width: 100%; padding: 20px;">
    <div class="header">
        <h2>Dashboard</h2>
       @*  <div class="user-info">
            <img src="https://ui-avatars.com/api/?name=Basavangj&background=3498db&color=fff" alt="User">
            <div>
                <div style="font-weight: 500;">Basavangj</div>
                <div style="font-size: 12px; color: var(--text-light);">Admin</div>
            </div>
        </div> *@
    </div>

    <!-- Dashboard Cards -->
    <!-- Dashboard Cards -->
    <div class="dashboard-cards">
        <a asp-controller="Assets" asp-action="Index" style="text-decoration: none; color: inherit;">
            <div class="card">
                <div class="card-header">
                    <div class="card-title">Assets</div>
                    <div class="card-icon assets">
                        <i class="fas fa-server"></i>
                    </div>
                </div>
                <div class="card-value">@Model.AssetCount</div>
                <div class="card-text">Total IT Assets</div>
            </div>
        </a>

        <a asp-controller="Licenses" asp-action="Index" style="text-decoration: none; color: inherit;">
            <div class="card">
                <div class="card-header">
                    <div class="card-title">Licenses</div>
                    <div class="card-icon licenses">
                        <i class="fas fa-certificate"></i>
                    </div>
                </div>
                <div class="card-value">@Model.LicenseCount</div>
                <div class="card-text">Total IT Licenses</div>
            </div>
        </a>



        <div class="card">
            <div class="card-header">
                <div class="card-title">Accessories</div>
                <div class="card-icon accessories">
                    <i class="fas fa-keyboard"></i>
                </div>
            </div>
            <div class="card-value"></div>
            <div class="card-text">Peripheral Devices</div>
        </div>

        <div class="card">
            <div class="card-header">
                <div class="card-title">Consumables</div>
                <div class="card-icon consumables">
                    <i class="fas fa-tint"></i>
                </div>
            </div>
            <div class="card-value"></div>
            <div class="card-text">Items in Stock</div>
        </div>

        <div class="card">
            <div class="card-header">
                <div class="card-title">Components</div>
                <div class="card-icon components">
                    <i class="fas fa-microchip"></i>
                </div>
            </div>
            <div class="card-value"></div>
            <div class="card-text">Items in Stock</div>
        </div>
    </div>

    <!-- Compact Charts -->
    <div style="display: flex; gap: 30px; flex-wrap: wrap; margin-top: 20px;">
        <div style="flex: 1 1 500px; max-width: 400px;">
            <h4 style="text-align: center;">Assets vs Licenses</h4>
            <canvas id="assetPieChart" width="500" height="300"></canvas>
        </div>

        <div style="flex: 1 1 500px; max-width: 700px;">
            <h4 style="text-align: center;">Deployment Status</h4>
            <canvas id="deploymentBarChart" width="500" height="300"></canvas>
        </div>
    </div>

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Pie Chart
        const ctxPie = document.getElementById('assetPieChart').getContext('2d');
        const assetPieChart = new Chart(ctxPie, {
            type: 'pie',
            data: {
                labels: ['Assets', 'Licenses'],
                datasets: [{
                    data: [@Model.AssetCount, @Model.LicenseCount],
                    backgroundColor: ['#3498db', '#e67e22']
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { position: 'bottom', labels: { boxWidth: 15, padding: 10 } } }
            }
        });

        // Bar Chart
        const ctxBar = document.getElementById('deploymentBarChart').getContext('2d');
        const deploymentBarChart = new Chart(ctxBar, {
            type: 'bar',
            data: {
                labels: ['Ready', 'Active', 'Not Active'],
                datasets: [{
                    data: [@Model.ReadyToDeployCount, @Model.ActiveCount, @Model.NotActiveCount],
                    backgroundColor: ['#2ecc71', '#3498db', '#e74c3c']
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, stepSize: 1 } }
            }
        });
    </script>



        <div class="card">
            <div class="card-header">
                <div class="card-title">Accessories</div>
                <div class="card-icon accessories">
                    <i class="fas fa-keyboard"></i>
                </div>
            </div>
            <div class="card-value"></div>
            <div class="card-text">Peripheral Devices</div>
        </div>

        <div class="card">
            <div class="card-header">
                <div class="card-title">Consumables</div>
                <div class="card-icon consumables">
                    <i class="fas fa-tint"></i>
                </div>
            </div>
            <div class="card-value"></div>
            <div class="card-text">Items in Stock</div>
        </div>

        <div class="card">
            <div class="card-header">
                <div class="card-title">Components</div>
                <div class="card-icon components">
                    <i class="fas fa-microchip"></i>
                </div>
            </div>
            <div class="card-value"></div>
            <div class="card-text">Items in Stock</div>
        </div>
    </div>

  
    <!-- Status Section -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px;">
        <div class="card">
            <div class="card-header">
                <div class="card-title">Deployment Status</div>
            </div>
            <div style="display: flex; align-items: center; margin-bottom: 15px;">
                <div style="width: 50px; height: 50px; background: var(--success); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-right: 15px;">
                    <i class="fas fa-check" style="color: white; font-size: 20px;"></i>
                </div>
                <div>
                    <div style="font-size: 24px; font-weight: 600;">90</div>
                    <div style="color: var(--text-light);">Ready to Deploy</div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <div class="card-title">Asset Status</div>
            </div>
            <div style="display: flex; align-items: center; margin-bottom: 15px;">
                <div style="width: 50px; height: 50px; background: var(--accent); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-right: 15px;">
                    <i class="fas fa-play" style="color: white; font-size: 20px;"></i>
                </div>
                <div>
                    <div style="font-size: 24px; font-weight: 600;">8</div>
                    <div style="color: var(--text-light);">ACTIVE</div>
                </div>
            </div>
            <div style="display: flex; align-items: center;">
                <div style="width: 50px; height: 50px; background: var(--danger); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-right: 15px;">
                    <i class="fas fa-stop" style="color: white; font-size: 20px;"></i>
                </div>
                <div>
                    <div style="font-size: 24px; font-weight: 600;">1</div>
                    <div style="color: var(--text-light);">NOT ACTIVE</div>
                </div>
            </div>
        </div>
    </div>
