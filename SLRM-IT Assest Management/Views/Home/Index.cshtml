            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Asset</th>
                            <th>Action</th>
                            <th>User</th>
                            <th>Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Dell XPS 15</td>
                            <td>Checked Out</td>
                            <td>John Smith</td>
                            <td>2 hours ago</td>
                            <td><span class="badge bg-success">Active</span></td>
                        </tr>
                        <tr>
                            <td>HP LaserJet Pro</td>
                            <td>Maintenance</td>
                            <td>Tech Support</td>
                            <td>5 hours ago</td>
                            <td><span class="badge bg-warning text-dark">Pending</span></td>
                        </tr>
                        <tr>
                            <td>Lenovo ThinkPad</td>
                            <td>Returned</td>
                            <td>Sarah Johnson</td>
                            <td>1 day ago</td>
                            <td><span class="badge bg-info">Completed</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Chart.js Scripts -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Asset data from server
        var laptopData = {
            working: @Model.LaptopWorking,
            underRepair: @Model.LaptopUnderRepair,
            scrap: @Model.LaptopScrap,
            missing: @Model.LaptopMissing
        };

        var desktopData = {
            working: @Model.DesktopWorking,
            underRepair: @Model.DesktopUnderRepair,
            scrap: @Model.DesktopScrap,
            missing: @Model.DesktopMissing
        };

        let pieChart, barChart;

        // Common chart options
        Chart.defaults.font.family = "'Inter', sans-serif";
        Chart.defaults.font.size = 12;

        // Load Pie Chart
        function loadPieChart(data) {
            const ctx = document.getElementById('assetPieChart').getContext('2d');
            if (pieChart) pieChart.destroy();

            pieChart = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['Working', 'Under Repair', 'Scrap', 'Missing'],
                    datasets: [{
                        data: [data.working, data.underRepair, data.scrap, data.missing],
                        backgroundColor: [
                            '#10b981',  // Working - Green
                            '#f59e0b',  // Under Repair - Orange
                            '#ef4444',  // Scrap - Red
                            '#94a3b8'   // Missing - Gray
                        ],
                        borderWidth: 0,
                        borderRadius: 8,
                        spacing: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '70%',
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                usePointStyle: true,
                                pointStyle: 'circle',
                                padding: 20,
                                font: { size: 12 }
                            }
                        },
                        tooltip: {
                            backgroundColor: 'rgba(0,0,0,0.8)',
                            padding: 12,
                            titleFont: { size: 13, weight: '600' },
                            bodyFont: { size: 12 }
                        }
                    }
                }
            });
        }

        // Load Bar Chart
        function loadBarChart(data) {
            const ctx = document.getElementById('deploymentBarChart').getContext('2d');
            if (barChart) barChart.destroy();

            barChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: ['Working', 'Under Repair', 'Scrap', 'Missing'],
                    datasets: [{
                        label: 'Number of Assets',
                        data: [data.working, data.underRepair, data.scrap, data.missing],
                        backgroundColor: [
                            '#10b981',
                            '#f59e0b',
                            '#ef4444',
                            '#94a3b8'
                        ],
                        borderRadius: 8,
                        barPercentage: 0.6,
                        categoryPercentage: 0.8
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: 'rgba(0,0,0,0.8)',
                            padding: 12
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            max: 400,
                            grid: {
                                color: 'rgba(0,0,0,0.05)',
                                drawBorder: false
                            },
                            ticks: {
                                stepSize: 50,
                                font: { size: 11 }
                            }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { font: { size: 11 } }
                        }
                    }
                }
            });
        }

        // Load initial data (Laptop)
        loadPieChart(laptopData);
        loadBarChart(laptopData);

        // Button click handlers
        document.getElementById("btnLaptop").addEventListener("click", function () {
            loadPieChart(laptopData);
            loadBarChart(laptopData);

            this.classList.add("active");
            document.getElementById("btnDesktop").classList.remove("active");
        });

        document.getElementById("btnDesktop").addEventListener("click", function () {
            loadPieChart(desktopData);
            loadBarChart(desktopData);

            this.classList.add("active");
            document.getElementById("btnLaptop").classList.remove("active");
        });
    });
</script>