@model IEnumerable<SLRM_IT_Assest_Management.Models.ITAssetDetail>

@{
    ViewData["Title"] = "IT Asset Details";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold text-primary">
            <i class="fas fa-desktop me-2"></i>IT Asset Details
        </h4>

        <a asp-action="Create" class="btn btn-success">
            <i class="fas fa-plus me-1"></i> Add IT Detail
        </a>
    </div>

    <div class="card shadow">
        <div class="card-body table-responsive">

            <table class="table table-bordered table-striped table-hover align-middle">
                <thead class="table-dark text-center">
                    <tr>
                        <th>S.NO</th>
                        <th>Department</th>
                        <th>User Name</th>
                        <th>Division</th>
                        <th>Asset Location</th>
                        <th>Type</th>
                        <th>Make</th>
                        <th>Model</th>
                        <th>Serial No</th>
                        <th>Status</th>
                        <th>Telephone No</th>
                        <th>Parallel Connection</th>
                        <th>Screen Size</th>
                        <th>Frequency No</th>
                        <th>License No</th>
                        <th>Ports</th>
                        <th style="width:140px;">Action</th>
                    </tr>
                </thead>

                <tbody>
                    @{
                        int i = 1;
                    }

                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center">@i</td>
                            <td>@item.Asset?.Department?.DepartmentName</td>
                            <td>@item.Asset?.UserName</td>
                            <td>@item.Asset?.Division?.DivisionName</td>
                            <td>@item.Asset?.AssetLocation?.Name</td>
                            <td>@item.Asset?.AssetType?.Name</td>
                            <td>@item.Asset?.Make</td>
                            <td>@item.Asset?.Model</td>
                            <td>@item.Asset?.SerialNo</td>
                            <td>@item.Asset?.AssetStatus?.Name</td>

                            <td>@item.TelephoneNo</td>
                            <td>@item.ParallelConnection</td>
                            <td>@item.ScreenSize</td>
                            <td>@item.FrequencyNo</td>
                            <td>@item.LicenseNo</td>
                            <td>@item.Ports</td>

                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@item.ITAssetDetailId"
                                   class="btn btn-sm btn-warning me-1">
                                    <i class="fas fa-edit"></i>
                                </a>

                                <a asp-action="Delete" asp-route-id="@item.ITAssetDetailId"
                                   class="btn btn-sm btn-danger">
                                    <i class="fas fa-trash-alt"></i>
                                </a>
                            </td>
                        </tr>
                        i++;
                    }
                </tbody>
            </table>

            @if (!Model.Any())
            {
                <div class="alert alert-info text-center mt-3">
                    No IT Asset Details found.
                </div>
            }

        </div>
    </div>
</div>
