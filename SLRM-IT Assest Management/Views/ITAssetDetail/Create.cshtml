@model SLRM_IT_Assest_Management.Models.ITAssetDetail

@{
    ViewData["Title"] = "Create IT Asset Detail";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-success text-white">Add IT Asset Detail</div>
        <div class="card-body">

            <form asp-action="Create" method="post">

                <div class="mb-3">
                    <label asp-for="AssetId" class="form-label"></label>
                    <select asp-for="AssetId" asp-items="ViewBag.AssetId" class="form-control">
                        <option value="">-- Select Asset --</option>
                    </select>
                    <span asp-validation-for="AssetId" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="TelephoneNo"></label>
                        <input asp-for="TelephoneNo" class="form-control" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="ParallelConnection"></label>
                        <input asp-for="ParallelConnection" class="form-control" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="ScreenSize"></label>
                        <input asp-for="ScreenSize" class="form-control" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="FrequencyNo"></label>
                        <input asp-for="FrequencyNo" class="form-control" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="LicenseNo"></label>
                        <input asp-for="LicenseNo" class="form-control" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="Ports"></label>
                        <input asp-for="Ports" class="form-control" />
                    </div>
                </div>

                <div class="text-end">
                    <button type="submit" class="btn btn-success">Save</button>
                    <a asp-action="Index" asp-controller="Assets" class="btn btn-secondary">Back</a>
                </div>

            </form>
        </div>
    </div>
</div>
