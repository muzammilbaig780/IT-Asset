@model SLRM_IT_Assest_Management.Models.ITAssetDetail

<div class="container mt-4">
    <div class="card shadow border-danger">
        <div class="card-header bg-danger text-white">Delete IT Asset Detail</div>
        <div class="card-body">

            <dl class="row">
                <dt class="col-sm-3">Asset</dt>
                <dd class="col-sm-9">@Model.Asset?.AssetTag</dd>

                <dt class="col-sm-3">Telephone No</dt>
                <dd class="col-sm-9">@Model.TelephoneNo</dd>

                <dt class="col-sm-3">Screen Size</dt>
                <dd class="col-sm-9">@Model.ScreenSize</dd>

                <dt class="col-sm-3">License No</dt>
                <dd class="col-sm-9">@Model.LicenseNo</dd>
            </dl>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="ITAssetDetailId" />

                <div class="text-end">
                    <button type="submit" class="btn btn-danger">Delete</button>
                    <a asp-action="Index" asp-controller="Assets" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
