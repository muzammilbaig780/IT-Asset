@model SLRM_IT_Assest_Management.Models.StockInventory

@{
    ViewData["Title"] = "Edit Stock Inventory";
}

<div class="container mt-4">

    <div class="card shadow border-0">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">
                <i class="fas fa-edit me-2"></i>Edit Stock Inventory
            </h4>
        </div>

        <div class="card-body">

            <form asp-action="Edit">

                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <input type="hidden" asp-for="StoreInventoryId" />

                <div class="row">

                    <!-- Category -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Category" class="form-label fw-semibold"></label>
                        <select asp-for="Category" class="form-select">
                            <option value="">-- Select Category --</option>
                            <option>Computer Systems</option>
                            <option>Computer Components</option>
                            <option>Peripherals</option>
                            <option>Printing Supplies</option>
                            <option>Networking</option>
                            <option>Communication</option>
                            <option>Power Devices</option>
                            <option>Storage Devices</option>
                            <option>Security Devices</option>
                            <option>Accessories</option>
                        </select>
                        <span asp-validation-for="Category" class="text-danger"></span>
                    </div>



                    <!-- GRN Number -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="GRNNumber" class="form-label fw-semibold"></label>
                        <input asp-for="GRNNumber" class="form-control" />
                        <span asp-validation-for="GRNNumber" class="text-danger"></span>
                    </div>

                    <!-- Requesition No -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="RequesitionNo" class="form-label fw-semibold"></label>
                        <input asp-for="RequesitionNo" class="form-control" />
                        <span asp-validation-for="RequesitionNo" class="text-danger"></span>
                    </div>

                    <!-- Received Qty -->
                    <div class="col-md-4 mb-3">
                        <label asp-for="ReceivedQty" class="form-label fw-semibold"></label>
                        <input asp-for="ReceivedQty" class="form-control" />
                        <span asp-validation-for="ReceivedQty" class="text-danger"></span>
                    </div>

                    <!-- Available Qty -->
                    <div class="col-md-4 mb-3">
                        <label asp-for="AvailableQty" class="form-label fw-semibold"></label>
                        <input asp-for="AvailableQty" class="form-control" />
                        <span asp-validation-for="AvailableQty" class="text-danger"></span>
                    </div>

                    <!-- Issued Qty -->
                    @* <div class="col-md-4 mb-3">
                        <label asp-for="IssuedQty" class="form-label fw-semibold"></label>
                        <input asp-for="IssuedQty" class="form-control" readonly />
                        <span asp-validation-for="IssuedQty" class="text-danger"></span>
                    </div> *@

                    <!-- Store Location -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="StoreLocation" class="form-label fw-semibold"></label>
                        <select asp-for="StoreLocation" class="form-select">
                            <option value="">-- Select Store Location --</option>
                            <option>MIS-IT Dept</option>
                            <option>MIS-IT Service Room</option>
                            <option>Over Head Tank</option>
                        </select>
                        <span asp-validation-for="StoreLocation" class="text-danger"></span>
                    </div>

                    <!-- Received By -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="ReceivedBy" class="form-label fw-semibold"></label>
                        <input asp-for="ReceivedBy" class="form-control" />
                        <span asp-validation-for="ReceivedBy" class="text-danger"></span>
                    </div>

                    <!-- Remarks -->
                    <div class="col-md-12 mb-3">
                        <label asp-for="Remarks" class="form-label fw-semibold"></label>
                        <textarea asp-for="Remarks" rows="3" class="form-control"></textarea>
                        <span asp-validation-for="Remarks" class="text-danger"></span>
                    </div>

                    <!-- Created Date -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="CreatedDate" class="form-label fw-semibold"></label>
                        <input asp-for="CreatedDate" class="form-control" readonly />
                    </div>

                    <!-- Created By -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="CreatedBy" class="form-label fw-semibold"></label>
                        <input asp-for="CreatedBy" class="form-control" readonly />
                    </div>

                </div>

                <hr />

                <div class="d-flex justify-content-between">

                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Back
                    </a>

                    <button type="submit" class="btn btn-success px-4">
                        <i class="fas fa-save"></i> Update Stock
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}