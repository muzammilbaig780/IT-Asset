            <td>
                @Html.DisplayFor(model => item.IssuedQty)
            </td>
            <td>
                @Html.DisplayFor(model => item.StoreLocation)
            </td>
            <td>
                @Html.DisplayFor(model => item.ReceivedBy)
            </td>
            <td>
                @Html.DisplayFor(model => item.Remarks)
            </td>
            <td>
                @Html.DisplayFor(model => item.CreatedDate)
            </td>
            <td>
                @Html.DisplayFor(model => item.CreatedBy)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.StoreInventoryId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.StoreInventoryId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.StoreInventoryId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
