@model IEnumerable<SLRM_IT_Assest_Management.Models.StockInventory>

@{
    ViewData["Title"] = "Stock Inventory";

    int sl = 1;

    var totalItems = Model.Count();
    var totalReceived = Model.Sum(x => x.ReceivedQty);
    var totalAvailable = Model.Sum(x => x.AvailableQty);
    //var totalIssued = Model.Sum(x => x.IssuedQty);
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

<style>

    body {
        background: #f4f6f9;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .page-title {
        font-size: 30px;
        font-weight: 700;
        color: #1f2937;
        letter-spacing: .5px;
    }

    /*==============================
       Dashboard Cards
    ===============================*/

    .dashboard-card {
        border: none;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 8px 20px rgba(0,0,0,.10);
        transition: all .35s ease;
        cursor: pointer;
        color: #fff;
        min-height: 150px;
    }

        .dashboard-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 18px 35px rgba(0,0,0,.18);
        }

    .card-body-dashboard {
        padding: 22px;
    }

    .card-title {
        font-size: 15px;
        opacity: .95;
        font-weight: 500;
    }

    .card-value {
        font-size: 34px;
        font-weight: 700;
        margin: 8px 0;
    }

    .card-subtitle {
        font-size: 13px;
        opacity: .9;
    }

    .icon-circle {
        width: 65px;
        height: 65px;
        border-radius: 50%;
        background: rgba(255,255,255,.18);
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .icon-circle i {
            font-size: 30px;
            color: #fff;
        }

    /*==============================
        Card Colors
    ===============================*/

    .blue-gradient {
        background: linear-gradient(135deg,#2563eb,#1d4ed8);
    }

    .green-gradient {
        background: linear-gradient(135deg,#10b981,#059669);
    }

    .cyan-gradient {
        background: linear-gradient(135deg,#06b6d4,#0891b2);
    }

    .orange-gradient {
        background: linear-gradient(135deg,#f59e0b,#ea580c);
    }

    .red-gradient {
        background: linear-gradient(135deg,#ef4444,#b91c1c);
    }
    /* =======================
           Table Card
        ==========================*/

    .table-card {
        border: none;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 8px 20px rgba(0,0,0,.08);
        background: #fff;
    }

        .table-card .card-header {
            background: #fff;
            border-bottom: 1px solid #ececec;
            padding: 18px 22px;
        }

    .table-responsive {
        border-radius: 0 0 18px 18px;
    }

    /* =======================
           Table
        ==========================*/

    .table {
        margin-bottom: 0;
    }

        .table thead {
            background: linear-gradient(90deg,#2563eb,#1d4ed8);
            color: #fff;
        }

            .table thead th {
                white-space: nowrap;
                vertical-align: middle;
                border: none;
                padding: 14px;
                font-weight: 600;
                font-size: 14px;
            }

        .table tbody td {
            vertical-align: middle;
            padding: 14px;
            border-color: #edf1f7;
            font-size: 14px;
        }

        .table tbody tr {
            transition: .25s;
        }

            .table tbody tr:hover {
                background: #f1f7ff;
            }

    /* =======================
           Search Box
        ==========================*/

    .search-box {
        width: 320px;
        border-radius: 30px;
        border: 1px solid #d8dee9;
        padding-left: 20px;
        height: 45px;
        box-shadow: none;
    }

        .search-box:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 .15rem rgba(37,99,235,.2);
        }

    /* =======================
           Stock Status
        ==========================*/

    .stock-high {
        background: #22c55e;
        color: #fff;
    }

    .stock-low {
        background: #facc15;
        color: #000;
    }

    .stock-zero {
        background: #ef4444;
        color: #fff;
    }

    /* =======================
           Badge
        ==========================*/

    .badge {
        padding: 8px 14px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    /* =======================
           Action Buttons
        ==========================*/

    .action-btn {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        margin-right: 5px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: .25s;
    }

        .action-btn:hover {
            transform: scale(1.08);
        }

    /* =======================
           Buttons
        ==========================*/

    .btn {
        border-radius: 10px;
        font-weight: 500;
    }

    /* =======================
           Responsive
        ==========================*/

    @@media (max-width:768px) {

        .search-box {
            width: 100%;
            margin-bottom: 10px;
        }

        .page-title {
            font-size: 24px;
        }

        .card-summary .card-body {
            min-height: 120px;
        }
    }

</style>


<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <div class="page-title">
                Stock Inventory
            </div>

            <small class="text-muted">
                Manage all inventory items
            </small>

        </div>

        <div class="d-flex gap-2">

            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i>
                Add New Item
            </a>

            <a href="javascript:history.back();" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i>
                Back
            </a>

        </div>

    </div>


    <div class="row g-4 mb-4">

        <!-- Total Items -->
        <div class="col-lg col-md-6">
            <div class="dashboard-card blue-gradient">
                <div class="card-body-dashboard">

                    <div class="d-flex justify-content-between">

                        <div>
                            <div class="card-title">Total Items</div>
                            <div class="card-value">@ViewBag.TotalItems</div>
                            <div class="card-subtitle">Inventory Items</div>
                        </div>

                        <div class="icon-circle">
                            <i class="bi bi-box-seam"></i>
                        </div>

                    </div>

                </div>
            </div>
        </div>

        <!-- Received -->
        <div class="col-lg col-md-6">
            <div class="dashboard-card green-gradient">
                <div class="card-body-dashboard">

                    <div class="d-flex justify-content-between">

                        <div>
                            <div class="card-title">Received Qty</div>
                            <div class="card-value">@ViewBag.TotalReceived</div>
                            <div class="card-subtitle">Total Received</div>
                        </div>

                        <div class="icon-circle">
                            <i class="bi bi-download"></i>
                        </div>

                    </div>

                </div>
            </div>
        </div>

        <!-- Available -->
        <div class="col-lg col-md-6">
            <div class="dashboard-card cyan-gradient">
                <div class="card-body-dashboard">

                    <div class="d-flex justify-content-between">

                        <div>
                            <div class="card-title">Available Qty</div>
                            <div class="card-value">@ViewBag.TotalAvailable</div>
                            <div class="card-subtitle">Current Stock</div>
                        </div>

                        <div class="icon-circle">
                            <i class="bi bi-check2-circle"></i>
                        </div>

                    </div>

                </div>
            </div>
        </div>

        <!-- Issued -->
        <div class="col-lg col-md-6">
            <div class="dashboard-card orange-gradient">
                <div class="card-body-dashboard">

                    <div class="d-flex justify-content-between">

                        <div>
                            <div class="card-title">Issued Qty</div>
                            <div class="card-value">@ViewBag.TotalIssued</div>
                            <div class="card-subtitle">Total Issued</div>
                        </div>

                        <div class="icon-circle">
                            <i class="bi bi-box-arrow-right"></i>
                        </div>

                    </div>

                </div>
            </div>
        </div>

        <!-- Alert -->
        <div class="col-lg col-md-6">

            <a href="javascript:void(0);" id="btnAlertCard" style="text-decoration:none">

                <div class="dashboard-card red-gradient">

                    <div class="card-body-dashboard">

                        <div class="d-flex justify-content-between">

                            <div>

                                <div class="card-title">
                                    Alerts (>15 Days)
                                </div>

                                <div class="card-value">
                                    @ViewBag.AlertCount
                                </div>

                                <div class="card-subtitle">
                                    Click to View Details →
                                </div>

                            </div>

                            <div class="icon-circle">

                                <i class="bi bi-bell-fill"></i>

                            </div>

                        </div>

                    </div>

                </div>

            </a>

        </div>



        <!-- Add Modal Here -->
        <div class="modal fade" id="alertModal">

            <div class="modal-dialog modal-xl">

                <div class="modal-content">

                    <div class="modal-header bg-danger text-white">

                        <h5 class="modal-title">
                            <i class="bi bi-bell-fill"></i>
                            Alert Items
                        </h5>

                        <button class="btn-close btn-close-white"
                                data-bs-dismiss="modal"></button>

                    </div>

                    <div class="modal-body" id="alertBody">
                    </div>

                </div>

            </div>

        </div>

    </div>




    <div class="card table-card">

        <div class="card-header bg-white">

            <div class="d-flex justify-content-between">

                <input type="text"
                       id="searchInput"
                       class="form-control search-box"
                       placeholder="Search Item Name..." />

                <span class="text-muted mt-2">

                    Total Records :
                    <strong>@totalItems</strong>

                </span>

            </div>

        </div>

        

        <div class="table-responsive">

            <table class="table table-bordered table-hover mb-0" id="stockTable">

                <thead>

                    <tr>

                        <th>Sl</th>

                        <th>Item Name</th>

                        <th>Item Code</th>

                        <th>Category</th>

                        <th>Grn Number</th>

                        <th>Requesition No</th>

                        <th>Received</th>

                        <th>Available</th>                        

                        <th>Status</th>

                        <th>Location</th>

                        <th>Received By</th>

                        <th>Action</th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model.Any())
                    {

                        @foreach (var item in Model)
                        {

                            <tr>

                                <td>@sl</td>

                                <td>@item.ItemNameMaster?.ItemName</td>

                                <td>@item.ItemCodeMaster?.ItemCode</td>

                                <td>@item.Category</td>

                                <td>@item.GRNNumber</td>

                                <td>@item.RequesitionNo</td>

                                <td>
                                    <span class="badge bg-success">
                                        @item.ReceivedQty
                                    </span>
                                </td>

                                <td>
                                    <span class="badge bg-primary">
                                        @item.AvailableQty
                                    </span>
                                </td>

                                <td>

                                    @if (item.AvailableQty == 0)
                                    {
                                        <span class="badge stock-zero">
                                            Out of Stock
                                        </span>
                                    }
                                    else if (item.AvailableQty < 10)
                                    {
                                        <span class="badge stock-low">
                                            Low Stock
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge stock-high">
                                            In Stock
                                        </span>
                                    }

                                </td>

                                <td>@item.StoreLocation</td>

                                <td>@item.ReceivedBy</td>

                                <td>

                                    <a asp-action="Edit"
                                       asp-route-storeinventoryid="@item.StoreInventoryId"
                                       class="btn btn-warning btn-sm action-btn">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>

                                    <a asp-action="Details"
                                       asp-route-storeinventoryid="@item.StoreInventoryId"
                                       class="btn btn-info btn-sm text-white action-btn">
                                        <i class="bi bi-eye"></i>
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-storeinventoryid="@item.StoreInventoryId"
                                       class="btn btn-danger btn-sm">
                                        <i class="bi bi-trash"></i>
                                    </a>

                                </td>

                            </tr>

                            sl++;

                            sl++;

                        }

                    }
                    else
                    {

                        <tr>

                            <td colspan="12" class="text-center p-5">

                                <img src="https://cdn-icons-png.flaticon.com/512/4076/4076549.png"
                                     width="100" />

                                <br /><br />

                                <h5>No Inventory Found</h5>

                                <p class="text-muted">

                                    Click <b>Add New Item</b> to create inventory.

                                </p>

                            </td>

                        </tr>

                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        document.getElementById("searchInput").addEventListener("keyup", function () {

            var value = this.value.toLowerCase();

            var rows = document.querySelectorAll("#stockTable tbody tr");

            rows.forEach(function (row) {

                row.style.display =
                    row.innerText.toLowerCase().indexOf(value) > -1
                        ? ""
                        : "none";

            });

        });

    </script>


    <script>
        // Your search script

        document.getElementById("searchInput").addEventListener("keyup", function () {

            var value = this.value.toLowerCase();

            var rows = document.querySelectorAll("#stockTable tbody tr");

            rows.forEach(function (row) {

                row.style.display =
                    row.innerText.toLowerCase().indexOf(value) > -1
                        ? ""
                        : "none";

            });

        });

        // Popup script

        document.getElementById("btnAlertCard").addEventListener("click", function () {

            fetch('/StockInventories/GetAlertItems')
                .then(response => response.text())
                .then(html => {

                    document.getElementById("alertBody").innerHTML = html;

                    var modal = new bootstrap.Modal(document.getElementById("alertModal"));
                    modal.show();

                });

        });

    </script>

}