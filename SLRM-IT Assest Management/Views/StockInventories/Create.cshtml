@model SLRM_IT_Assest_Management.Models.StockInventory

@{
    ViewData["Title"] = "Add Stock Inventory";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

<style>

    body {
        background: #f4f6f9;
    }

    .page-header {
        background: #fff;
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 20px;
        box-shadow: 0 3px 10px rgba(0,0,0,.08);
    }

    .form-card {
        background: #fff;
        border-radius: 10px;
        padding: 30px;
        box-shadow: 0 3px 10px rgba(0,0,0,.08);
    }

    .form-label {
        font-weight: 600;
        color: #495057;
    }

    .form-control {
        border-radius: 8px;
    }

    .btn-save {
        background: #0d6efd;
        color: white;
        padding: 10px 30px;
        border-radius: 8px;
    }

        .btn-save:hover {
            background: #0b5ed7;
            color: white;
        }

    .btn-back {
        padding: 10px 30px;
        border-radius: 8px;
    }

    .section-title {
        color: #0d6efd;
        font-weight: 600;
        margin-bottom: 20px;
    }

</style>

<div class="container-fluid">

    <div class="page-header d-flex justify-content-between align-items-center">

        <div>
            <h3 class="mb-1">
                <i class="bi bi-box-seam"></i>
                Add Stock Inventory
            </h3>
            <small class="text-muted">
                Enter new stock item details
            </small>
        </div>

        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left-circle"></i>
            Back to List
        </a>

    </div>

    <div class="form-card">

        <form asp-action="Create">

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <h5 class="section-title">
                Inventory Information
            </h5>

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Item Name</label>

                    <select asp-for="ItemNameMasterId"
                            id="ItemNameMasterId"
                            class="form-select"
                            asp-items="@(new SelectList(ViewBag.ItemNameMasters, "ItemNameMasterId", "ItemName"))">

                        <option value="">-- Select Item Name --</option>

                    </select>

                    <span asp-validation-for="ItemNameMasterId" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Item Code</label>

                    <select asp-for="ItemCodeMasterId"
                            id="ItemCodeMasterId"
                            class="form-select">

                        <option value="">-- Select Item Code --</option>

                    </select>

                    <span asp-validation-for="ItemCodeMasterId" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Category" class="form-label"></label>
                    <select asp-for="Category" class="form-select">
                        <option value="">-- Select Category --</option>
                        <option value="Computer Systems">Computer Systems</option>
                        <option value="Computer Components">Computer Components</option>
                        <option value="Peripherals">Peripherals</option>
                        <option value="Printing Supplies">Printing Supplies</option>
                        <option value="Networking">Networking</option>
                        <option value="Communication">Communication</option>
                        <option value="Power Devices">Power Devices</option>
                        <option value="Storage Devices">Storage Devices</option>
                        <option value="Security Devices">Security Devices</option>
                        <option value="Accessories">Accessories</option>
                    </select>
                    <span asp-validation-for="Category" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="GRNNumber" class="form-label">GRN Number</label>
                    <input asp-for="GRNNumber" class="form-control" placeholder="GRN Number" />
                    <span asp-validation-for="GRNNumber" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="RequesitionNo" class="form-label">Requesition No</label>
                    <input asp-for="RequesitionNo" class="form-control" placeholder="Requesition No" />
                    <span asp-validation-for="RequesitionNo" class="text-danger"></span>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="ReceivedQty" class="form-label">Received Qty</label>
                    <input asp-for="ReceivedQty" class="form-control" />
                    <span asp-validation-for="ReceivedQty" class="text-danger"></span>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="AvailableQty" class="form-label">Available Qty</label>
                    <input asp-for="AvailableQty" class="form-control" />
                    <span asp-validation-for="AvailableQty" class="text-danger"></span>
                </div>

              

                <div class="col-md-6 mb-3">
                    <label asp-for="StoreLocation" class="form-label">Store Location</label>
                    <select asp-for="StoreLocation" class="form-select">
                        <option value="">-- Select Store Location --</option>
                        <option value="MIS-IT Dept">MIS-IT Dept</option>
                        <option value="MIS-IT Service Room">MIS-IT Service Room</option>
                        <option value="Over Head Tank">Over Head Tank</option>
                    </select>
                    <span asp-validation-for="StoreLocation" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="ReceivedBy" class="form-label"></label>
                    <input asp-for="ReceivedBy" class="form-control" placeholder="Received By" />
                    <span asp-validation-for="ReceivedBy" class="text-danger"></span>
                </div>


                <div class="col-md-6 mb-3">
                    <label asp-for="CreatedDate" class="form-label"></label>
                    <input asp-for="CreatedDate" type="datetime-local" class="form-control" />
                    <span asp-validation-for="CreatedDate" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="CreatedBy" class="form-label"></label>
                    <input asp-for="CreatedBy" class="form-control" placeholder="Created By" />
                    <span asp-validation-for="CreatedBy" class="text-danger"></span>
                </div>


                <div class="col-md-12 mb-3">
                    <label asp-for="Remarks" class="form-label"></label>
                    <textarea asp-for="Remarks" class="form-control" rows="3" placeholder="Remarks"></textarea>
                    <span asp-validation-for="Remarks" class="text-danger"></span>
                </div>
            </div>

            <hr />

            <div class="text-end">

                <a asp-action="Index" class="btn btn-outline-secondary btn-back">
                    <i class="bi bi-arrow-left"></i>
                    Cancel
                </a>

                <button type="submit" class="btn btn-save">
                    <i class="bi bi-check-circle"></i>
                    Save Inventory
                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

