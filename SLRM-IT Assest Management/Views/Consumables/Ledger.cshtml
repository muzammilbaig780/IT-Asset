@model IEnumerable<SLRM_IT_Assest_Management.Models.ConsumableTransaction>

@{
    ViewData["Title"] = "Consumable Ledger";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="container-fluid py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="h3 mb-1 fw-bold text-dark">@ViewData["Title"]</h2>
            <p class="text-muted mb-0">Assign consumable stock to assets with reference tracking</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i>Back to Inventory
        </a>
    </div>

    <!-- CARD HEADER -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <div>
                <h4 class="fw-bold mb-0">
                    <i class="fas fa-clipboard-list me-2"></i>Consumable Transaction Ledger
                </h4>
                @if (ViewBag.ConsumableName != null)
                {
                    <small class="opacity-75">
                        <i class="fas fa-tag me-1"></i> <strong>@ViewBag.ConsumableName</strong>
                    </small>
                }
            </div>
            <span class="badge bg-light text-dark fs-6">
                @Model.Count() Transactions
            </span>
        </div>

        <!-- CARD BODY -->
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                    <h5 class="text-muted mb-1">No Transactions Found</h5>
                    <p class="text-muted mb-0">No transaction records available for this consumable.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover table-striped align-middle mb-0">
                        <thead class="table-dark sticky-top">
                            <tr>
                                <th>#</th>
                                <th>Date & Time</th>
                                <th>Type</th>
                                <th class="text-end">Quantity</th>
                                <th>Asset</th>
                                <th>Reference</th>
                                <th>Performed By</th>
                                <th>Remarks</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int index = 1;
                            }
                            @foreach (var tx in Model)
                            {
                                var typeClass = tx.TransactionType switch
                                {
                                    ConsumableTransactionType.Issue => "bg-danger",
                                    ConsumableTransactionType.StockIn => "bg-success",
                                    ConsumableTransactionType.Return => "bg-warning",
                                    _ => "bg-secondary"
                                };
                                <tr>
                                    <td class="fw-semibold text-primary">@index</td>
                                    <td>
                                        <div>@tx.TransactionDate.ToString("dd-MMM-yyyy")</div>
                                        <small class="text-muted">@tx.TransactionDate.ToString("HH:mm")</small>
                                    </td>
                                    <td>
                                        <span class="badge @typeClass text-white">
                                            @tx.TransactionType
                                        </span>
                                    </td>
                                    <td class="fw-bold text-end">@tx.Quantity</td>
                                    <td>
                                        @if (tx.Asset != null)
                                        {
                                            <span class="badge bg-info text-dark px-2 py-1">@tx.Asset.AssetTag</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td class="font-monospace">@(!string.IsNullOrEmpty(tx.ReferenceNo) ? tx.ReferenceNo : "-")</td>
                                    <td>@tx.PerformedBy</td>
                                    <td class="text-truncate" style="max-width: 200px;" title="@tx.Remarks">
                                        @(!string.IsNullOrEmpty(tx.Remarks) ? tx.Remarks : "-")
                                    </td>
                                </tr>
                                index++;
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- CARD FOOTER -->
        @if (Model.Any())
        {
            <div class="card-footer bg-light d-flex justify-content-between">
                <small class="text-muted">
                    <i class="fas fa-info-circle me-1"></i>
                    Total Transactions: <strong>@Model.Count()</strong>
                </small>
                <small class="text-muted">
                    Generated on @DateTime.Now.ToString("dd-MMM-yyyy HH:mm")
                </small>
            </div>
        }
    </div>
</div>

<style>
    .table-dark th {
        background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);
        color: #fff;
        font-weight: 600;
        letter-spacing: 0.5px;
    }

    .table-hover tbody tr:hover {
        background-color: rgba(0, 123, 255, 0.1);
        transform: scale(1.01);
        transition: all 0.2s ease;
    }

    .text-truncate {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .badge {
        font-size: 0.85rem;
        padding: 0.35em 0.65em;
    }
</style>
