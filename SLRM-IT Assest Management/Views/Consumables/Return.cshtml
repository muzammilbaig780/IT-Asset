@{
    ViewData["Title"] = "Return Consumable";
}

<div class="container-fluid py-4">
    <!-- PAGE HEADER -->
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
        <div>
            <h2 class="h3 mb-1 fw-bold text-dark">@ViewData["Title"]</h2>
            <p class="text-muted mb-0">Return unused consumables to inventory stock</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i>Back to Inventory
        </a>
    </div>

    <!-- SUCCESS / ERROR MESSAGES -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible border-0 shadow-sm fade show mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="fas fa-check-circle text-success me-3 fs-5"></i>
                <div>@TempData["SuccessMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible border-0 shadow-sm fade show mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="fas fa-exclamation-triangle text-danger me-3 fs-5"></i>
                <div>@TempData["ErrorMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- MAIN FORM CARD -->
    <div class="card shadow-lg border-0">
        <div class="card-header bg-success text-white py-4">
            <h5 class="card-title mb-0 fw-semibold">
                <i class="fas fa-undo me-2"></i>Return to Stock
            </h5>
        </div>
        <div class="card-body p-4 p-md-5">
            <form asp-action="Return" method="post" class="needs-validation" novalidate>
                <input type="hidden" name="consumableId" value="@ViewBag.ConsumableId" />

                <div class="row g-4">
                    <!-- CONSUMABLE DISPLAY -->
                    <div class="col-12">
                        <label class="form-label fw-semibold text-dark mb-2">
                            Consumable Item <span class="text-success fw-bold fs-5">✓ Selected</span>
                        </label>
                        <div class="input-group">
                            <input type="text" class="form-control form-control-lg bg-light border-success"
                                   value="@ViewBag.ConsumableName" readonly />
                            <span class="input-group-text bg-success text-white">
                                <i class="fas fa-check-circle"></i>
                            </span>
                        </div>
                        <div class="form-text">Currently selected consumable item</div>
                    </div>

                    <!-- QUANTITY WITH MAX DISPLAY -->
                    <div class="col-lg-6">
                        <label for="quantity" class="form-label fw-semibold text-dark mb-2">
                            Return Quantity <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="fas fa-warehouse text-muted"></i>
                            </span>
                            <input id="quantity" name="quantity" type="number"
                                   min="0.01" max="@ViewBag.MaxQuantity" step="0.01"
                                   class="form-control form-control-lg"
                                   placeholder="0.00" required />
                            <span class="input-group-text">
                                Max: @ViewBag.MaxQuantity.ToString("N2")
                            </span>
                        </div>
                        <div class="form-text text-warning">
                            Maximum available for return: <strong>@ViewBag.MaxQuantity.ToString("N2") units</strong>
                        </div>
                        <div class="invalid-feedback">
                            Quantity must be between 0.01 and @ViewBag.MaxQuantity.ToString("N2").
                        </div>
                    </div>

                    <!-- REFERENCE NUMBER -->
                    <div class="col-lg-6">
                        <label for="referenceNo" class="form-label fw-semibold text-dark mb-2">
                            Reference Number <span class="text-danger">*</span>
                        </label>
                        <input id="referenceNo" name="referenceNo" type="text"
                               class="form-control form-control-lg"
                               placeholder="Return ticket / GRN / reference" required />
                        <div class="form-text">Return authorization number or service ticket ID</div>
                        <div class="invalid-feedback">
                            Reference number is required.
                        </div>
                    </div>

                    <!-- REMARKS -->
                    <div class="col-12">
                        <label for="remarks" class="form-label fw-semibold text-dark mb-2">
                            Remarks (Optional)
                        </label>
                        <textarea id="remarks" name="remarks" rows="3"
                                  class="form-control form-control-lg"
                                  placeholder="Reason for return, condition notes, etc..."></textarea>
                        <div class="form-text">Provide additional details about this return (optional)</div>
                    </div>
                </div>

                <!-- ACTION BUTTONS -->
                <div class="d-flex flex-wrap gap-3 justify-content-end mt-5 pt-4 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-4">
                        <i class="fas fa-times me-2"></i>Cancel
                    </a>
                    <button type="submit" class="btn btn-success btn-lg px-5">
                        <i class="fas fa-undo me-2"></i>Return to Stock
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Professional form validation with max quantity check
        (function () {
            'use strict';
            const form = document.querySelector('.needs-validation');
            const quantityInput = document.getElementById('quantity');
            const maxQuantity = @ViewBag.MaxQuantity;

            // Form submission validation
            form.addEventListener('submit', function (event) {
                if (!form.checkValidity()) {
                    event.preventDefault();
                    event.stopPropagation();
                }
                form.classList.add('was-validated');
            }, false);

            // Real-time quantity validation
            if (quantityInput) {
                quantityInput.addEventListener('input', function() {
                    const value = parseFloat(this.value);

                    if (value > maxQuantity) {
                        this.setCustomValidity(`Quantity cannot exceed ${maxQuantity.toFixed(2)}`);
                        this.classList.add('is-invalid');
                    } else if (value <= 0) {
                        this.setCustomValidity('Quantity must be greater than 0');
                        this.classList.add('is-invalid');
                    } else {
                        this.setCustomValidity('');
                        this.classList.remove('is-invalid');
                    }
                });
            }

            // Clear validation on focus
            document.querySelectorAll('input, textarea').forEach(input => {
                input.addEventListener('focus', function() {
                    this.classList.remove('is-invalid');
                });
            });
        })();
    </script>
}
