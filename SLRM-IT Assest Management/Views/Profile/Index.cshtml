@model SLRM_IT_Assest_Management.Models.UserProfile

@{
    ViewData["Title"] = "Profile";
}

<!-- Page Header -->
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-lg rounded-3 border-0">
                <!-- Profile Header -->
                <div class="card-header text-center bg-primary text-white rounded-top">
                    <h3>@Model.FullName's Profile</h3>
                    <p class="mb-0">Welcome to your personalized dashboard</p>
                </div>

                <!-- Profile Details -->
                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <!-- Profile Picture (Dynamic or Placeholder) -->
                        <img src="@(!string.IsNullOrEmpty(Model.ProfilePicturePath) ? Url.Content(Model.ProfilePicturePath) : "https://via.placeholder.com/150")"
                             alt="Profile Picture" class="rounded-circle border border-4 border-white" width="150" height="150">
                    </div>

                    <div class="row">
                        <!-- Full Name Section -->
                        <div class="col-12 mb-3">
                            <h5 class="fw-bold">Full Name:</h5>
                            <p class="fs-5 text-muted">@Model.FullName</p>
                        </div>

                        <!-- Email Section -->
                        <div class="col-12 mb-3">
                            <h5 class="fw-bold">Email:</h5>
                            <p class="fs-5 text-muted">@Model.Email</p>
                        </div>

                        <!-- Role Section -->
                        <div class="col-12 mb-3">
                            <h5 class="fw-bold">Role:</h5>
                            <p class="fs-5 text-muted">@Model.Role</p>
                        </div>

                        <!-- Department Section (Optional) -->
                        <div class="col-12 mb-3">
                            <h5 class="fw-bold">Department:</h5>
                            <p class="fs-5 text-muted">@Model.Department?.DepartmentName ?? "No Department Assigned"</p>
                        </div>

                        <!-- Account Created Date (Optional) -->
                        @* If you have a CreatedDate property in UserProfile, uncomment the block below *@
                        @* <div class="col-12 mb-3">
                            <h5 class="fw-bold">Account Created:</h5>
                            <p class="fs-5 text-muted">@Model.CreatedDate.ToString("MMMM dd, yyyy")</p>
                        </div> *@

                        <!-- Buttons Section -->
                        <div class="col-12 text-center">
                            <!-- Edit Profile Button -->
                            <a href="@Url.Action("Edit", "Profile", new { id = Model.Id })" class="btn btn-warning w-100 mb-2">Edit Profile</a>

                            <!-- Change Password Button -->
                            <a href="@Url.Action("ChangePassword", "Account")" class="btn btn-secondary w-100">Change Password</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Optional: Add some custom CSS below -->
<style>
    .card-header {
        background-color: #0069d9;
        color: white;
        padding: 1.5rem;
    }

    .card-body {
        background-color: #f9f9f9;
        border-radius: 0 0 1.25rem 1.25rem;
    }

    .card {
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }

    .btn-warning {
        background-color: #f39c12;
        border: none;
    }

    .btn-secondary {
        background-color: #6c757d;
        border: none;
    }

    .btn:hover {
        opacity: 0.9;
    }

    .rounded-circle {
        border-radius: 50%;
    }

    .border-4 {
        border-width: 4px;
    }
</style>
