@model SLRM_IT_Assest_Management.Models.Cctv
@{
    ViewData["Title"] = "Delete CCTV";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - SLRM IT-ASSET MANAGEMENT</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body {
            background-color: #f4f6f9;
            padding: 20px;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .page-title {
            font-size: 24px;
            font-weight: 600;
            margin-bottom: 20px;
            color: #1f3c88;
            padding-bottom: 10px;
            border-bottom: 2px solid #e3e6ef;
        }

        .delete-card {
            border-left: 5px solid #dc3545;
            box-shadow: 0 4px 12px rgba(220, 53, 69, 0.15);
        }

        .status-badge {
            font-size: 0.85em;
            padding: 0.5em 0.75em;
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Page Header -->
        <h1 class="page-title">
            SLRM IT-ASSET MANAGEMENT &gt; CCTV &gt; Delete
        </h1>

        <!-- Back Button -->
        <div class="mb-4">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-arrow-left me-1"></i>Back to CCTV List
            </a>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-10 col-xl-8">
                <!-- Delete Confirmation Card -->
                <div class="card delete-card shadow-lg border-0 mb-4">
                    <div class="card-header bg-danger text-white py-4">
                        <div class="d-flex align-items-center">
                            <div class="me-3">
                                <i class="fas fa-exclamation-triangle fa-2x"></i>
                            </div>
                            <div>
                                <h3 class="card-title mb-1 fw-bold">Confirm Delete</h3>
                                <p class="mb-0 opacity-90">This action cannot be undone!</p>
                            </div>
                        </div>
                    </div>

                    <div class="card-body p-4 p-md-5">
                        <!-- Warning Alert -->
                        <div class="alert alert-warning border-0 shadow-sm mb-4">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-exclamation-triangle fa-lg text-warning me-3 flex-shrink-0"></i>
                                <div>
                                    <h5 class="alert-heading mb-1">⚠️ Permanent Deletion Warning</h5>
                                    <p class="mb-0">This CCTV asset and all associated data will be permanently removed from the database.</p>
                                </div>
                            </div>
                        </div>

                        <!-- CCTV Details -->
                        <div class="row g-4">
                            <div class="col-md-6">
                                <h6 class="text-danger fw-bold mb-2">
                                    <i class="fas fa-tag me-2"></i>IT Asset Tag
                                </h6>
                                <div class="bg-light p-3 rounded border">
                                    <strong class="text-primary fs-5">@Model.ITAssetTag</strong>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <h6 class="text-danger fw-bold mb-2">
                                    <i class="fas fa-hdd me-2"></i>Device Type
                                </h6>
                                <div class="bg-light p-3 rounded border">
                                    <span class="badge bg-info fs-6 px-3 py-2">@Model.DeviceType</span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <h6 class="text-danger fw-bold mb-2">
                                    <i class="fas fa-camera me-2"></i>Model
                                </h6>
                                <div class="bg-light p-3 rounded border">@Model.Model</div>
                            </div>
                            <div class="col-md-6">
                                <h6 class="text-danger fw-bold mb-2">
                                    <i class="fas fa-barcode me-2"></i>Serial Number
                                </h6>
                                <div class="bg-light p-3 rounded border">
                                    <code>@(string.IsNullOrEmpty(Model.CameraSerialNumber) ? "NA" : Model.CameraSerialNumber)</code>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <h6 class="text-danger fw-bold mb-2">
                                    <i class="fas fa-building me-2"></i>Location
                                </h6>
                                <div class="bg-light p-3 rounded border">
                                    <i class="fas fa-map-marker-alt me-2 text-success"></i>
                                    @Model.AssetLocation?.Name
                                </div>
                            </div>
                            <div class="col-md-6">
                                <h6 class="text-danger fw-bold mb-2">
                                    <i class="fas fa-users me-2"></i>Department
                                </h6>
                                <div class="bg-light p-3 rounded border">
                                    @Model.Department?.DepartmentName
                                </div>
                            </div>

                            <div class="col-md-6">
                                <h6 class="text-danger fw-bold mb-2">
                                    <i class="fas fa-hdd me-2"></i>Storage
                                </h6>
                                <div class="bg-light p-3 rounded border">
                                    <span>@Model.HardDiskCapacity</span>
                                    @if (Model.NumberOfHardDisks.HasValue)
                                    {
                                        <span class="badge bg-secondary ms-2">x@Model.NumberOfHardDisks</span>
                                    }
                                </div>
                            </div>
                            <div class="col-md-6">
                                <h6 class="text-danger fw-bold mb-2">
                                    <i class="fas fa-server me-2"></i>Status
                                </h6>
                                <div class="bg-light p-3 rounded border">
                                    @{
                                        var statusLower = Model.Status?.ToLowerInvariant() ?? "";
                                        var statusClass = statusLower == "active" ? "bg-success text-white" :
                                        statusLower == "scrapped" ? "bg-warning text-dark" : "bg-danger text-white";
                                    }
                                    <span class="badge @statusClass status-badge fs-6 px-3 py-2">@Model.Status</span>
                                </div>
                            </div>

                            <div class="col-12">
                                <h6 class="text-danger fw-bold mb-2">
                                    <i class="fas fa-sticky-note me-2"></i>Remarks
                                </h6>
                                @if (!string.IsNullOrEmpty(Model.Remark))
                                {
                                    <div class="bg-light p-3 rounded border">
                                        @Model.Remark
                                    </div>
                                }
                                else
                                {
                                    <div class="bg-light p-3 rounded border text-muted">
                                        <em>No remarks</em>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="card-footer bg-gradient-danger text-white p-4 border-0">
                        <div class="d-flex justify-content-end gap-3 flex-wrap">
                            <a asp-action="Index" class="btn btn-outline-light btn-lg px-4">
                                <i class="fas fa-times me-2"></i>Cancel
                            </a>
                            <!-- ✅ CORRECT: asp-action="Delete" (matches ActionName="Delete") -->
                            <form asp-action="Delete" asp-route-id="@Model.CctvId" method="post" style="display: inline;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger">
                                    <i class="fas fa-trash me-2"></i>Yes, Delete
                                </button>
                            </form>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script>
        // Enhanced confirmation dialog
        document.querySelector('form[onsubmit]').addEventListener('submit', function(e) {
            e.preventDefault();

            Swal.fire({
                title: 'Are you absolutely sure?',
                html: `
                    <div class="text-danger">
                        <i class="fas fa-exclamation-triangle fa-2x mb-3 d-block"></i>
                        <strong>This CCTV asset will be <u>permanently deleted</u>!</strong><br><br>
                        <strong>IT Asset Tag: <span class="badge bg-light text-dark">${document.querySelector('.text-primary').textContent}</span></strong>
                    </div>
                `,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: '<i class="fas fa-trash me-1"></i>Yes, delete it!',
                cancelButtonText: '<i class="fas fa-times me-1"></i>Cancel',
                buttonsStyling: false,
                customClass: {
                    confirmButton: 'btn btn-danger px-4',
                    cancelButton: 'btn btn-secondary px-4'
                },
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    this.submit();
                }
            });
        });

        // Auto-hide success messages (if any)
        $('.alert').fadeTo(8000, 500).slideUp(500, function() {
            $(this).alert('close');
        });
    </script>
</body>
</html>
