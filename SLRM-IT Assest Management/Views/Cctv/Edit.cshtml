@model SLRM_IT_Assest_Management.Models.Cctv
@{
    ViewData["Title"] = "Edit CCTV";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - SLRM IT-ASSET MANAGEMENT</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body {
            background-color: #f4f6f9;
            padding: 20px;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .page-title {
            font-size: 24px;
            font-weight: 600;
            margin-bottom: 20px;
            color: #1f3c88;
            padding-bottom: 10px;
            border-bottom: 2px solid #e3e6ef;
        }

        .edit-card {
            border-left: 5px solid #ffc107;
            box-shadow: 0 4px 12px rgba(255, 193, 7, 0.15);
        }

        .form-changed {
            background-color: #fff3cd !important;
            border-color: #ffeaa7 !important;
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Page Header -->
        <h1 class="page-title">
            SLRM IT-ASSET MANAGEMENT &gt; CCTV &gt; Edit
        </h1>

        <!-- Back Button -->
        <div class="mb-4">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-arrow-left me-1"></i>Back to CCTV List
            </a>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-10 col-xl-8">
                <!-- Edit Form Card -->
                <div class="card edit-card shadow-lg border-0">
                    <div class="card-header bg-warning text-dark py-4">
                        <div class="d-flex align-items-center">
                            <div class="me-3">
                                <i class="fas fa-edit fa-2x"></i>
                            </div>
                            <div>
                                <h3 class="card-title mb-1 fw-bold">
                                    Edit CCTV Asset - <span class="badge bg-primary">@Model.ITAssetTag</span>
                                </h3>
                                <p class="mb-0 opacity-90">Update CCTV asset information</p>
                            </div>
                        </div>
                    </div>

                    <div class="card-body p-4 p-md-5">
                        <!-- Validation Errors -->
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger mb-4">
                                <i class="fas fa-exclamation-triangle me-2"></i>
                                Please correct the following errors:
                                <ul class="mb-0 mt-2">
                                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                    {
                                        <li>@error.ErrorMessage</li>
                                    }
                                </ul>
                            </div>
                        }

                        <!-- Edit Form -->
                        <form asp-action="Edit" method="post" novalidate>
                            <input type="hidden" asp-for="CctvId" />

                            @Html.AntiForgeryToken()

                            <div class="row g-3">
                                <!-- IT Asset Tag (Read-only) -->
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold text-dark">IT Asset Tag</label>
                                    <input asp-for="ITAssetTag" class="form-control form-control-lg" readonly
                                           style="background-color: #f8f9fa; border-color: #dee2e6;" />
                                </div>

                                <!-- Device Type -->
                                <div class="col-md-6">
                                    <label asp-for="DeviceType" class="form-label fw-semibold text-dark">Device Type</label>
                                    <select asp-for="DeviceType" class="form-select form-select-lg">
                                        <option value="">Select Device Type</option>
                                        <option value="DVR">DVR</option>
                                        <option value="NVR">NVR</option>
                                        <option value="IP Camera">IP Camera</option>
                                        <option value="PTZ Camera">PTZ Camera</option>
                                        <option value="Dome Camera">Dome Camera</option>
                                        <option value="Bullet Camera">Bullet Camera</option>
                                    </select>
                                    <span asp-validation-for="DeviceType" class="text-danger small"></span>
                                </div>

                                <!-- Model & Serial Number -->
                                <div class="col-md-6">
                                    <label asp-for="Model" class="form-label fw-semibold text-dark">Model</label>
                                    <input asp-for="Model" class="form-control" placeholder="Enter model name" />
                                    <span asp-validation-for="Model" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="CameraSerialNumber" class="form-label fw-semibold text-dark">Camera Serial No</label>
                                    <input asp-for="CameraSerialNumber" class="form-control" />
                                    <span asp-validation-for="CameraSerialNumber" class="text-danger small"></span>
                                </div>

                                <!-- Storage Details -->
                                <div class="col-md-6">
                                    <label asp-for="HardDiskCapacity" class="form-label fw-semibold text-dark">Hard Disk Capacity</label>
                                    <input asp-for="HardDiskCapacity" class="form-control" placeholder="2TB, 4TB, etc." />
                                    <span asp-validation-for="HardDiskCapacity" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="NumberOfHardDisks" class="form-label fw-semibold text-dark">No. of HDD</label>
                                    <input asp-for="NumberOfHardDisks" type="number" min="0" max="8" class="form-control" />
                                    <span asp-validation-for="NumberOfHardDisks" class="text-danger small"></span>
                                </div>

                                <!-- Channel & Location -->
                                <div class="col-md-6">
                                    <label asp-for="Channel" class="form-label fw-semibold text-dark">Channel</label>
                                    <input asp-for="Channel" class="form-control" placeholder="4/8/16/32" />
                                    <span asp-validation-for="Channel" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    @{
                                        var locations = ViewData["AssetLocations"] as List<SLRM_IT_Assest_Management.Models.AssetLocation>;
                                    }
                                    <label asp-for="AssetLocationId" class="form-label fw-semibold text-dark">Location <span class="text-danger">*</span></label>
                                    <select asp-for="AssetLocationId" class="form-select" required>
                                        <option value="">Select Location</option>
                                        @if (locations != null)
                                        {
                                            @foreach (var loc in locations)
                                            {
                                                <option value="@loc.AssetLocationId" selected="@(loc.AssetLocationId == Model.AssetLocationId)">@loc.Name</option>
                                            }
                                        }
                                    </select>
                                </div>

                                <!-- Department & Status -->
                                <div class="col-md-6">
                                    @{
                                        var departments = ViewData["Departments"] as List<SLRM_IT_Assest_Management.Models.Department>;
                                    }
                                    <label asp-for="DepartmentId" class="form-label fw-semibold text-dark">Department <span class="text-danger">*</span></label>
                                    <select asp-for="DepartmentId" class="form-select" required>
                                        <option value="">Select Department</option>
                                        @if (departments != null)
                                        {
                                            @foreach (var dept in departments)
                                            {
                                                <option value="@dept.DepartmentId" selected="@(dept.DepartmentId == Model.DepartmentId)">@dept.DepartmentName</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Status" class="form-label fw-semibold text-dark">Status</label>
                                    <select asp-for="Status" class="form-select">
                                        <option value="Active">Active</option>
                                        <option value="Inactive">Inactive</option>
                                        <option value="Under Maintenance">Under Maintenance</option>
                                        <option value="Scrapped">Scrapped</option>
                                    </select>
                                </div>

                                <!-- Dates -->
                                <div class="col-md-6">
                                    <label asp-for="HandoverDate" class="form-label fw-semibold text-dark">Handover Date</label>
                                    <input asp-for="HandoverDate" type="date" class="form-control" />
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="InvoiceDate" class="form-label fw-semibold text-dark">Invoice Date</label>
                                    <input asp-for="InvoiceDate" type="date" class="form-control" />
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="GRNDate" class="form-label fw-semibold text-dark">GRN Date</label>
                                    <input asp-for="GRNDate" type="date" class="form-control" />
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="GRNNumber" class="form-label fw-semibold text-dark">GRN Number</label>
                                    <input asp-for="GRNNumber" class="form-control" />
                                </div>

                                <!-- Warranty & End Date -->
                                <div class="col-md-6">
                                    <label asp-for="Warranty" class="form-label fw-semibold text-dark">Warranty</label>
                                    <input asp-for="Warranty" class="form-control" placeholder="36 Months" />
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="EndDate" class="form-label fw-semibold text-dark">End Date (Warranty)</label>
                                    <input asp-for="EndDate" type="date" class="form-control" />
                                </div>

                                <!-- Scrap Date & Remarks -->
                                <div class="col-12">
                                    <label asp-for="ScrapDate" class="form-label fw-semibold text-dark">Scrap Date</label>
                                    <input asp-for="ScrapDate" type="date" class="form-control" />
                                </div>
                                <div class="col-12">
                                    <label asp-for="Remark" class="form-label fw-semibold text-dark">Remarks</label>
                                    <textarea asp-for="Remark" class="form-control" rows="4" placeholder="Additional notes about this CCTV asset..."></textarea>
                                    <span asp-validation-for="Remark" class="text-danger small"></span>
                                </div>
                            </div>
                        </form>
                    </div>

                    <!-- Action Buttons -->
                    <div class="card-footer bg-light border-top p-4">
                        <div class="d-flex justify-content-end gap-3 flex-wrap">
                            <a asp-action="Index" class="btn btn-secondary btn-lg px-4">
                                <i class="fas fa-times me-2"></i>Cancel
                            </a>
                            <a asp-action="Delete" asp-route-id="@Model.CctvId" class="btn btn-outline-danger btn-lg px-4">
                                <i class="fas fa-trash-alt me-2"></i>Delete
                            </a>
                            <button type="submit" form="editForm" class="btn btn-warning btn-lg px-4 fw-bold">
                                <i class="fas fa-save me-2"></i>Update CCTV
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script>
        // Give form an ID for the submit button
        document.querySelector('form').id = 'editForm';

        // Auto-calculate warranty end date
        $('input[name="HandoverDate"], input[name="Warranty"]').on('change blur', function() {
            var handoverDate = new Date($('input[name="HandoverDate"]').val());
            var warrantyText = $('input[name="Warranty"]').val();
            if (handoverDate && warrantyText && !handoverDate.toISOString().split('T')[0] === $('input[name="EndDate"]').val()) {
                var months = parseInt(warrantyText.match(/\d+/)?.[0]) || 36;
                handoverDate.setMonth(handoverDate.getMonth() + months);
                $('input[name="EndDate"]').val(handoverDate.toISOString().split('T')[0]);
                $('input[name="EndDate"]').addClass('form-changed');
            }
        });

        // Visual feedback for changed fields
        $('input, select, textarea').on('change input', function() {
            $(this).toggleClass('form-changed', $(this).val() !== $(this).prop('defaultValue'));
        });

        // Form submission confirmation
        $('#editForm').on('submit', function(e) {
            if (!confirm('Save changes to this CCTV asset?')) {
                e.preventDefault();
                return false;
            }
        });

        // Set focus to first field
        $('input:not([readonly]):first').focus();
    </script>
</body>
</html>
