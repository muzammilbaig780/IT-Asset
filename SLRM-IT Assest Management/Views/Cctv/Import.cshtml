@model dynamic
@{
    ViewData["Title"] = "Import CCTV";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - SLRM IT-ASSET MANAGEMENT</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body {
            background-color: #f4f6f9;
            padding: 20px;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .page-title {
            font-size: 24px;
            font-weight: 600;
            margin-bottom: 20px;
            color: #1f3c88;
            padding-bottom: 10px;
            border-bottom: 2px solid #e3e6ef;
        }

        .import-card {
            border-left: 5px solid #28a745;
            box-shadow: 0 4px 12px rgba(40, 167, 69, 0.15);
        }

        .dropzone {
            border: 2px dashed #28a745;
            transition: all 0.3s ease;
            cursor: pointer;
        }

            .dropzone:hover, .dropzone.dragover {
                border-color: #20c997;
                background-color: #f8fff9;
                transform: scale(1.02);
            }

        .excel-template {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Page Header -->
        <h1 class="page-title">
            SLRM IT-ASSET MANAGEMENT &gt; CCTV &gt; Import
        </h1>

        <!-- Back Button -->
        <div class="mb-4">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-arrow-left me-1"></i>Back to CCTV List
            </a>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-10 col-xl-8">
                <!-- Main Import Card -->
                <div class="card import-card shadow-lg border-0 mb-4">
                    <div class="card-header bg-success text-white py-4 excel-template">
                        <div class="d-flex align-items-center">
                            <div class="me-3">
                                <i class="fas fa-file-excel fa-2x"></i>
                            </div>
                            <div>
                                <h3 class="card-title mb-1 fw-bold">Bulk Import CCTV Assets</h3>
                                <p class="mb-0 opacity-90 fs-6">Upload Excel file to import multiple CCTV assets at once</p>
                            </div>
                        </div>
                    </div>

                    <div class="card-body p-5">
                        <!-- File Upload Form -->
                        <form asp-action="Import" method="post" enctype="multipart/form-data" id="importForm">
                            <div class="mb-5">
                                <label class="form-label fw-bold fs-5 mb-4 d-block text-dark">
                                    <i class="fas fa-cloud-upload-alt me-2 text-success"></i>Upload Excel File
                                </label>

                                <!-- Drag & Drop Zone -->
                                <div class="dropzone text-center p-5 rounded-3 mb-4 position-relative"
                                     id="dropZone">
                                    <input type="file" name="file" accept=".xlsx,.xls" class="d-none" id="fileInput" required />
                                    <i class="fas fa-file-excel fa-4x text-success mb-4 d-block"></i>
                                    <h4 class="mb-2">Drop Excel file here or click to browse</h4>
                                    <p class="text-muted mb-4">
                                        Supports .xlsx and .xls files • Maximum 10MB • Up to 1000 records
                                    </p>
                                    <button type="button" class="btn btn-success btn-lg px-4" id="browseBtn">
                                        <i class="fas fa-folder-open me-2"></i>Browse Files
                                    </button>
                                    <div class="file-preview mt-3 p-3 bg-light rounded border d-none" id="filePreview">
                                        <i class="fas fa-file-excel text-success me-2"></i>
                                        <strong id="fileName"></strong>
                                        <span class="badge bg-success ms-2" id="fileSize"></span>
                                        <button type="button" class="btn btn-sm btn-outline-danger float-end" id="removeFile">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    </div>
                                </div>

                                <!-- Import Options -->
                                <div class="row mb-4">
                                    <div class="col-md-8">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="overwriteExisting" name="overwriteExisting" value="true">
                                            <label class="form-check-label fw-semibold fs-6" for="overwriteExisting">
                                                <i class="fas fa-exclamation-triangle text-warning me-2"></i>
                                                <strong>Replace all existing CCTV data</strong>
                                            </label>
                                            <div class="form-text">
                                                ⚠️ This will delete all current CCTV records and replace with new data
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Status Messages -->
                                @if (TempData["SuccessMessage"] != null)
                                {
                                    <div class="alert alert-success alert-dismissible fade show border-0" role="alert">
                                        <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                    </div>
                                }

                                @if (TempData["ErrorMessage"] != null)
                                {
                                    <div class="alert alert-danger alert-dismissible fade show border-0" role="alert">
                                        <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                    </div>
                                }
                            </div>

                            <!-- Action Buttons -->
                            <div class="d-flex justify-content-end gap-3 pt-3 border-top">
                                <a asp-action="Index" class="btn btn-secondary btn-lg px-5">
                                    <i class="fas fa-times me-2"></i>Cancel
                                </a>
                                <button type="submit" class="btn btn-success btn-lg px-5" id="importBtn" disabled>
                                    <i class="fas fa-upload me-2 spinner-border spinner-border-sm d-none" role="status"></i>
                                    <span class="import-text">Import CCTV Assets</span>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Excel Template & Instructions -->
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-light border-bottom">
                        <h5 class="card-title mb-0 fw-bold">
                            <i class="fas fa-file-excel me-2 text-success"></i>Excel Template & Instructions
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-4">
                            <div class="col-md-6">
                                <h6 class="fw-bold mb-3">
                                    <i class="fas fa-download me-2 text-primary"></i>Required Columns (Row 1)
                                </h6>
                                <div class="table-responsive">
                                    <table class="table table-sm table-bordered">
                                        <thead class="table-success">
                                            <tr>
                                                <th>Column A</th>
                                                <th>Column B</th>
                                                <th>Column C</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td><strong>ITAssetTag</strong></td>
                                                <td><strong>DeviceType</strong></td>
                                                <td><strong>Model</strong></td>
                                            </tr>
                                            <tr>
                                                <td>Column D</td>
                                                <td>CameraSerialNumber</td>
                                                <td>HardDiskCapacity</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <h6 class="fw-bold mb-3">
                                    <i class="fas fa-info-circle me-2 text-info"></i>Date Formats
                                </h6>
                                <ul class="list-group list-group-flush">
                                    <li class="list-group-item bg-transparent border-0 px-0">
                                        ✅ DD/MM/YYYY (01/01/2026)
                                    </li>
                                    <li class="list-group-item bg-transparent border-0 px-0">
                                        ✅ MM/DD/YYYY (01/01/2026)
                                    </li>
                                    <li class="list-group-item bg-transparent border-0 px-0 text-warning">
                                        ⚠️ ISO (2026-01-01)
                                    </li>
                                </ul>
                            </div>
                        </div>

                        <hr class="my-4">

                        <div class="text-center pt-3">
                            <a href="#" class="btn btn-outline-success btn-lg px-4">
                                <i class="fas fa-download me-2"></i>Download Sample Template.xlsx
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script>
        $(document).ready(function() {
            const dropZone = $('#dropZone');
            const fileInput = $('#fileInput');
            const browseBtn = $('#browseBtn');
            const filePreview = $('#filePreview');
            const fileName = $('#fileName');
            const fileSize = $('#fileSize');
            const removeFile = $('#removeFile');
            const importBtn = $('#importBtn');
            const importText = $('.import-text');
            const spinner = $('.spinner-border');

            // File input trigger
            browseBtn.click(function() {
                fileInput.click();
            });

            // Drag & drop events
            dropZone.on('dragover dragenter', function(e) {
                e.preventDefault();
                e.stopPropagation();
                $(this).addClass('dragover');
            });

            dropZone.on('dragleave dragend drop', function(e) {
                e.preventDefault();
                e.stopPropagation();
                $(this).removeClass('dragover');
            });

            dropZone.on('drop', function(e) {
                const files = e.originalEvent.dataTransfer.files;
                if (files.length > 0) {
                    fileInput[0].files = files;
                    handleFileSelect(files[0]);
                }
            });

            // File selection
            fileInput.on('change', function(e) {
                if (e.target.files.length > 0) {
                    handleFileSelect(e.target.files[0]);
                }
            });

            function handleFileSelect(file) {
                // Validate file type
                if (!file.name.match(/\.(xlsx|xls)$/i)) {
                    alert('Please select a valid Excel file (.xlsx or .xls)');
                    return;
                }

                // Validate file size (10MB)
                if (file.size > 10 * 1024 * 1024) {
                    alert('File size must be less than 10MB');
                    return;
                }

                // Show preview
                fileName.text(file.name);
                fileSize.text(formatFileSize(file.size));
                filePreview.removeClass('d-none');
                importBtn.prop('disabled', false);
            }

            function formatFileSize(bytes) {
                if (bytes === 0) return '0 Bytes';
                const k = 1024;
                const sizes = ['Bytes', 'KB', 'MB', 'GB'];
                const i = Math.floor(Math.log(bytes) / Math.log(k));
                return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
            }

            // Remove file
            removeFile.click(function() {
                fileInput.val('');
                filePreview.addClass('d-none');
                importBtn.prop('disabled', true);
            });

            // Form submission
            $('#importForm').on('submit', function(e) {
                if (!fileInput[0].files.length) {
                    e.preventDefault();
                    alert('Please select an Excel file first!');
                    return false;
                }

                // Show loading state
                importBtn.prop('disabled', true);
                spinner.removeClass('d-none');
                importText.text('Importing... Please wait');
            });
        });
    </script>
</body>
</html>
