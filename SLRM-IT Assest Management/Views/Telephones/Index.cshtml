@model IEnumerable<SLRM_IT_Assest_Management.Models.Telephone>

@{
    ViewData["Title"] = "Telephones";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Telephones - SLRM IT-ASSET MANAGEMENT</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        body {
            background-color: #f4f6f9;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding: 20px;
        }

        .page-title {
            font-size: 24px;
            font-weight: 600;
            margin-bottom: 20px;
            color: #1f3c88;
            padding-bottom: 10px;
            border-bottom: 2px solid #e3e6ef;
        }

        .table-container {
            margin-top: 20px;
            background: #ffffff;
            padding: 15px;
            border-radius: 12px;
            border: 1px solid #e0e4eb;
            box-shadow: 0 3px 10px rgba(0,0,0,0.06);
        }

        .table {
            font-size: 13px;
            background-color: #fbfcfd;
        }

            .table th, .table td {
                border: 0.5px solid #dee2e6 !important;
                padding: 8px 12px;
                text-align: center;
                vertical-align: middle;
                white-space: nowrap;
            }

        th {
            background-color: #2a4d8c;
            color: #fff;
            text-transform: uppercase;
            font-size: 15px;
            position: sticky;
            top: 0;
        }

        .table tr:nth-child(even) td {
            background-color: #f8faff;
        }

        .table tr:hover td {
            background-color: #eaf1fb;
        }

        .action-buttons .btn {
            margin-right: 5px;
        }
    </style>
</head>

<body>

    <div class="container-fluid">

        <!-- PAGE TITLE -->
        <h1 class="page-title">
            SLRM IT-ASSET MANAGEMENT &gt; Telephones
        </h1>

        <!-- BACK BUTTON -->
        @{
            await Html.RenderPartialAsync("_BackButton");
        }

        <!-- ADD BUTTON -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus"></i> Add New Telephone
            </a>

            <span class="text-muted small">
                Total: @Model.Count() records
            </span>
        </div>

        <!-- TABLE -->
        <div class="table-container">
            <div class="table-responsive">

                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th class="filter-header">
                                User Name
                                <i class="fas fa-filter filter-icon"></i>
                            </th>
                            <th class="filter-header">
                                Telephone No
                                <i class="fas fa-filter filter-icon"></i>
                            </th>
                            <th class="filter-header">
                                Connection
                                <i class="fas fa-filter filter-icon"></i>
                            </th>
                            <th class="filter-header">
                                Department
                                <i class="fas fa-filter filter-icon"></i>
                            </th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.UserName</td>
                                <td>@item.TelephoneNo</td>
                                <td>
                                    @if (item.Department != null)
                                    {
                                        @item.Department.DepartmentName
                                    }
                                    else
                                    {
                                        <span class="text-warning">No Department</span>
                                    }
                                </td>
                                <td>@item.Connection</td>

                                <td class="action-buttons">
                                    <a asp-action="Edit"
                                       asp-route-id="@item.TelephoneId"
                                       class="btn btn-warning btn-sm">
                                        <i class="fas fa-edit"></i> Edit
                                    </a>

                                    <a asp-action="Details"
                                       asp-route-id="@item.TelephoneId"
                                       class="btn btn-info btn-sm text-white">
                                        <i class="fas fa-eye"></i> Details
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.TelephoneId"
                                       class="btn btn-danger btn-sm">
                                        <i class="fas fa-trash-alt"></i> Delete
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>

            </div>
        </div>

    </div>

</body>
</html>